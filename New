// werden oft ohne "https://" kopiert.
const istLink = (s) => /^\S+\.\S{2,}/.test(String(s == null ? "" : s).trim());
function normalizeUrl(s) {
  const t = String(s == null ? "" : s).trim();
  if (!t) return "";
  return /^https?:\/\//i.test(t) ? t : `https://${t.replace(/^\/+/, "")}`;
}

// Alter in Jahren seit der Erstzulassung. Fehlt der Monat, wird Jahresmitte
// angenommen — genauer als Januar und im Schnitt richtig.
function alterJahre(v) {
  if (!v.year) return null;
  const d = parseISO(`${v.year}-${(v.month || "06")}-15`);
  if (!d || isNaN(d.getTime())) return null;
  const jahre = (Date.now() - d.getTime()) / (365.25 * TAG_MS);
  return jahre >= 0 ? jahre : null;
}

/* --- Erwarteter Preis aus Kilometerstand und Alter ---
   Kleinste Quadrate mit zwei Einflussgrößen:
       preis ≈ b0 + b1·km + b2·alter
   Über die zentrierten Größen wird daraus ein 2x2-Gleichungssystem. */
function regression(punkte) {
  const n = punkte.length;
  const mx1 = mittel(punkte.map((p) => p.km));
  const mx2 = mittel(punkte.map((p) => p.alter));
  const my = mittel(punkte.map((p) => p.preis));
  let S11 = 0, S22 = 0, S12 = 0, S1y = 0, S2y = 0;
  punkte.forEach((p) => {
    const a = p.km - mx1, b = p.alter - mx2, y = p.preis - my;
    S11 += a * a; S22 += b * b; S12 += a * b; S1y += a * y; S2y += b * y;
  });
  const det = S11 * S22 - S12 * S12;
  let b1, b2;
  if (Math.abs(det) < 1e-6) {
    // Kilometer und Alter laufen gleich — dann nur über die Kilometer rechnen.
    b1 = S11 ? S1y / S11 : 0;
    b2 = 0;
  } else {
    b1 = (S22 * S1y - S12 * S2y) / det;
    b2 = (S11 * S2y - S12 * S1y) / det;
  }
  const b0 = my - b1 * mx1 - b2 * mx2;
  const erwartet = (km, alter) => b0 + b1 * km + b2 * alter;
  let ssRes = 0, ssTot = 0;
  punkte.forEach((p) => {
    ssRes += (p.preis - erwartet(p.km, p.alter)) ** 2;
    ssTot += (p.preis - my) ** 2;
  });
  // Wie stark laufen Kilometer und Alter miteinander? Bei alten Autos mit
  // vielen Kilometern ist das fast immer so — dann lässt sich der Preis nicht
  // sauber auf die beiden Größen aufteilen, und die Einzelwerte täuschen.
  const kopplung = S11 && S22 ? Math.abs(S12 / Math.sqrt(S11 * S22)) : 0;
  return { b0, b1, b2, erwartet, mx2, kopplung, r2: ssTot ? 1 - ssRes / ssTot : 0, n };
}

