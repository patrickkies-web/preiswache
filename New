/* --- Zeigen und Treffen in den Schaubildern ---------------------------
   Recharts sucht beim Überfahren die Zeile heraus, die waagerecht am
   nächsten liegt — aber nur, wenn alle Reihen aus DERSELBEN, nach der
   x-Achse sortierten Liste kommen. Gibt man einer Kurve eigene Daten mit,
   zeigt die Karte danach dauerhaft dasselbe Fahrzeug oder gar keins.
   Deshalb: eine Liste je Schaubild — und hier wird aus der getroffenen
   Zeile das nächstgelegene Fahrzeug bestimmt. So ist überall etwas zu
   sehen, auch zwischen zwei Punkten. */










/* --------------------------- Schaubilder ----------------------------- *
   Gezeichnet wird in eigenem SVG, nicht mit einer Diagramm-Bibliothek.
   Zwei Gründe: für ein Punktfeld mit zwei Achsen braucht es keine halbe
   Megabyte Fremdcode, und das Zeigen und Klicken verhält sich genau so,
   wie es soll — der nächstgelegene Punkt wird hier selbst gesucht, mit der
   Maus wie mit dem Finger. Genau daran ist die Bibliothek vorher immer
   wieder gescheitert.
 * -------------------------------------------------------------------- */

/* Farbe der Absorption: von kalt (nichts geht) über Bernstein nach grün
   (alles weg). Bewusst dieselbe Sprache wie überall sonst in der App. */
function absorptionsFarbe(anteil) {
  const a = Math.max(0, Math.min(1, anteil || 0));
  const stopps = [
    [0.00, [34, 40, 50]],
    [0.35, [120, 90, 30]],
    [0.65, [222, 160, 30]],
    [1.00, [53, 196, 107]],
  ];
  let u = stopps[0], o = stopps[stopps.length - 1];
  for (let i = 0; i < stopps.length - 1; i++) {
    if (a >= stopps[i][0] && a <= stopps[i + 1][0]) { u = stopps[i]; o = stopps[i + 1]; break; }
  }
  const t = o[0] === u[0] ? 0 : (a - u[0]) / (o[0] - u[0]);
  const c = [0, 1, 2].map((i) => Math.round(u[1][i] + (o[1][i] - u[1][i]) * t));
  return `rgb(${c[0]}, ${c[1]}, ${c[2]})`;
}

// Runde Achsenschritte: 1, 2, 2,5 oder 5 mal einer Zehnerpotenz.
function achsenSchritte(min, max, anzahl = 5, ganz = false) {
  const spanne = (max - min) || 1;
  const roh = spanne / anzahl;
  const groesse = Math.pow(10, Math.floor(Math.log10(roh)));
  let schritt = [1, 2, 2.5, 5, 10].map((f) => f * groesse).find((x) => x >= roh) || groesse * 10;
  /* Zählbare Einheiten — Tage — dürfen nicht in Bruchteilen beschriftet
     werden. Bei einer Spanne von einem Tag käme sonst der Schritt 0,2
     heraus und die Achse trüge dreimal "0 T" und dreimal "1 T". */
  if (ganz) schritt = Math.max(1, Math.ceil(schritt));
  const werte = [];
  for (let w = Math.ceil(min / schritt) * schritt; w <= max + schritt * 1e-6; w += schritt) {
    werte.push(Math.round(w * 1e6) / 1e6);
  }
  return werte;
}

// Breite des Behälters mitlesen, damit die Beschriftung nicht verzerrt.
function useBreite(ref) {
  const [breite, setBreite] = useState(0);
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    const messen = () => setBreite(el.clientWidth);
    messen();
    if (typeof ResizeObserver === "undefined") {
      window.addEventListener("resize", messen);
      return () => window.removeEventListener("resize", messen);
    }
    const beobachter = new ResizeObserver(messen);
    beobachter.observe(el);
    return () => beobachter.disconnect();
  }, [ref]);
  return breite;
}

/* Punktfeld mit zwei Achsen.
   punkte: [{ id, x, y, farbe, offen, daten }]
   Beim Zeigen wird der nächstgelegene Punkt gesucht — nicht der genau
   getroffene. Deshalb erscheint überall etwas, und der Klick öffnet immer
   das, was die Karte gerade zeigt. */
function Punktfeld({ punkte, hoehe = 330, yFormat, xFormat, xTitel, yTitel,
  linien = [], band = null, kurve = null, guertel = null, marken = [],
  karte, aufKlick, leer }) {
  const S = styles;
  const huelle = useRef(null);
  const breite = useBreite(huelle);
  const [aktiv, setAktiv] = useState(null);
  /* Mit der Maus zeigt der Zeiger schon, bevor geklickt wird — ein Klick
     kann also sofort öffnen. Mit dem Finger gibt es kein Zeigen: der erste
     Tipper würde gleichzeitig zeigen und öffnen, und man bekäme die Karte
     nie zu sehen. Deshalb zeigt der erste Tipper, der zweite öffnet. */
  const vorherAktiv = useRef(null);
  const letzteBeruehrung = useRef(0);

  const rand = { links: 64, rechts: 16, oben: 14, unten: xTitel ? 40 : 26 };
  const B = Math.max(240, breite);
  const zeichenB = Math.max(60, B - rand.links - rand.rechts);
  const zeichenH = Math.max(60, hoehe - rand.oben - rand.unten);

  const xs = punkte.map((p) => p.x);
  const ys = punkte.map((p) => p.y);
  const werteY = [...ys, ...linien.map((l) => l.y), ...(band ? [band.von, band.bis] : []),
    ...(kurve || []).map((p) => p.y), ...(guertel ? guertel.oben.concat(guertel.unten).map((p) => p.y) : []),
    ...marken.map((m) => m.y)];
  let yMin = Math.min(...werteY), yMax = Math.max(...werteY);
  const luft = (yMax - yMin) * 0.08 || Math.max(1, yMax * 0.05);
  yMin -= luft; yMax += luft;
  let xMin = Math.min(...xs), xMax = Math.max(...xs);
  if (xMin === xMax) { xMin -= 1; xMax += 1; }
  const xLuft = (xMax - xMin) * 0.04;
  xMin -= xLuft; xMax += xLuft;

  const px = (x) => rand.links + ((x - xMin) / (xMax - xMin)) * zeichenB;
  const py = (y) => rand.oben + zeichenH - ((y - yMin) / (yMax - yMin)) * zeichenH;

  const gelegt = punkte.map((p) => ({ ...p, cx: px(p.x), cy: py(p.y) }));

  // Nächstgelegener Punkt zur Zeigerstelle. Waagerecht zählt doppelt, damit
  // bei mehreren Punkten übereinander die Höhe entscheidet.
  const naechster = (mx, my) => {
    let treffer = null, nah = Infinity;
    gelegt.forEach((p) => {
      const d = ((p.cx - mx) * 2) ** 2 + (p.cy - my) ** 2;
      if (d < nah) { nah = d; treffer = p; }
    });
    return treffer;
  };
  const ausEreignis = (e) => {
    const kasten = e.currentTarget.getBoundingClientRect();
    const punkt = e.touches?.[0] || e.changedTouches?.[0] || e;
    return naechster(punkt.clientX - kasten.left, punkt.clientY - kasten.top);
  };

  if (!punkte.length) return <div style={S.leerFeld}>{leer || "Keine Daten."}</div>;

  const yTicks = achsenSchritte(yMin, yMax, 5);
  const xTicks = xFormat ? achsenSchritte(xMin, xMax, B > 560 ? 6 : 4) : [];

  // Karte am Rand umklappen, damit sie nicht aus dem Bild läuft.
  const kartenSeite = aktiv && aktiv.cx > B * 0.55 ? "rechts" : "links";

  return (
    <div ref={huelle} style={{ ...S.feldHuelle, height: hoehe }}>
      {breite > 0 && (
        <svg className="pw-feld" width={B} height={hoehe} style={{ display: "block", touchAction: "pan-y" }}
          onMouseMove={(e) => setAktiv(ausEreignis(e))}
          onMouseLeave={() => setAktiv(null)}
          onTouchStart={(e) => {
            vorherAktiv.current = aktiv ? aktiv.id : null;
            letzteBeruehrung.current = Date.now();
            setAktiv(ausEreignis(e));
          }}
          onTouchMove={(e) => { letzteBeruehrung.current = Date.now(); setAktiv(ausEreignis(e)); }}
          onClick={(e) => {
            const p = ausEreignis(e);
            if (!p || !aufKlick) return;
            const ausBeruehrung = Date.now() - letzteBeruehrung.current < 800;
            if (ausBeruehrung && vorherAktiv.current !== p.id) return;   // erst zeigen
            aufKlick(p);
          }}>

          {/* Gitter und senkrechte Achse */}
          {yTicks.map((w) => (
            <g key={w}>
              <line x1={rand.links} x2={rand.links + zeichenB} y1={py(w)} y2={py(w)}
                stroke={T.line} strokeDasharray="2 4" />
              <text x={rand.links - 8} y={py(w) + 3.5} textAnchor="end"
                fontSize="10.5" fill={T.muted} fontFamily="ui-monospace, Menlo, monospace">
                {yFormat ? yFormat(w) : w}
              </text>
            </g>
          ))}
          {xTicks.map((w) => (
            <text key={w} x={px(w)} y={hoehe - rand.unten + 14} textAnchor="middle"
              fontSize="10.5" fill={T.muted} fontFamily="ui-monospace, Menlo, monospace">
              {xFormat(w)}
            </text>
          ))}

          {/* Streuband und waagerechte Bezugslinien */}
          {band && (
            <rect x={rand.links} width={zeichenB} y={py(band.bis)} height={Math.max(1, py(band.von) - py(band.bis))}
              fill={band.farbe || T.accent} fillOpacity={0.08} />
          )}
          {linien.map((l, i) => (
            <g key={i}>
              <line x1={rand.links} x2={rand.links + zeichenB} y1={py(l.y)} y2={py(l.y)}
                stroke={l.farbe || T.muted} strokeDasharray="5 4" strokeWidth={1.5} />
              {l.label && (
                <text x={rand.links + 6} y={py(l.y) - 5} fontSize="10" fill={l.farbe || T.muted}>{l.label}</text>
              )}
            </g>
          ))}

          {/* Der Gürtel um die Kurve: hin über die obere Kante, zurück über
              die untere. Dahinter die Kurve selbst — beides gehört unter die
              Punkte, sonst verdeckt es sie. */}
          {guertel && guertel.oben.length > 1 && (
            <path fill={T.accent} fillOpacity={0.12}
              d={guertel.oben.map((p, i) => `${i ? "L" : "M"}${px(p.x).toFixed(1)},${py(p.y).toFixed(1)}`).join("")
                + [...guertel.unten].reverse().map((p) => `L${px(p.x).toFixed(1)},${py(p.y).toFixed(1)}`).join("") + "Z"} />
          )}
          {kurve && kurve.length > 1 && (
            <path fill="none" stroke={T.accent} strokeWidth={2.2} strokeLinecap="round"
              d={kurve.map((p, i) => `${i ? "L" : "M"}${px(p.x).toFixed(1)},${py(p.y).toFixed(1)}`).join("")} />
          )}

          {/* Zeigerlinie */}
          {aktiv && (
            <line x1={aktiv.cx} x2={aktiv.cx} y1={rand.oben} y2={rand.oben + zeichenH}
              stroke={T.line} strokeWidth={1.5} />
          )}

          {/* Punkte */}
          {gelegt.map((p) => (
            <circle key={p.id} cx={p.cx} cy={p.cy} r={aktiv && aktiv.id === p.id ? 7.5 : 5}
              fill={p.offen ? T.bg : p.farbe} stroke={p.farbe}
              strokeWidth={p.offen ? 2 : 0} fillOpacity={p.offen ? 1 : 0.9} />
          ))}

          {/* Die Stützpunkte, aus denen die Formel gerechnet wurde: als
              Raute, damit man sie nie mit einem Fahrzeug verwechselt. */}
          {marken.map((m, i) => (
            <g key={i}>
              <path d={`M${px(m.x)},${py(m.y) - 8}L${px(m.x) + 8},${py(m.y)}L${px(m.x)},${py(m.y) + 8}L${px(m.x) - 8},${py(m.y)}Z`}
                fill={T.bg} stroke={m.farbe || T.accent} strokeWidth={2.2} />
              {m.label && (
                <text x={px(m.x)} y={py(m.y) - 13} textAnchor="middle" fontSize="10" fontWeight="700"
                  fill={m.farbe || T.accent}>{m.label}</text>
              )}
            </g>
          ))}

          {/* Achsenbeschriftung */}
          {xTitel && (
            <text x={rand.links + zeichenB / 2} y={hoehe - 6} textAnchor="middle"
              fontSize="10" fill={T.muted}>{xTitel}</text>
          )}
          {yTitel && (
            <text x={12} y={rand.oben + zeichenH / 2} fontSize="10" fill={T.muted}
              transform={`rotate(-90 12 ${rand.oben + zeichenH / 2})`} textAnchor="middle">{yTitel}</text>
          )}
        </svg>
      )}
      {aktiv && karte && (
        <div className="pw-punktkarte" style={{
          ...S.feldKarte,
          top: Math.min(hoehe - 60, Math.max(4, aktiv.cy - 20)),
          ...(kartenSeite === "rechts" ? { right: B - aktiv.cx + 14 } : { left: aktiv.cx + 14 }),
        }}>
          {karte(aktiv.daten)}
        </div>
      )}
    </div>
  );
}

/* Linienfeld: je Beobachtung eine Treppe.
   Ein Preis gilt, bis der Verkäufer ihn ändert — deshalb Treppe und nicht
   Gerade. Beim Zeigen wird die Linie gesucht, die an dieser Stelle am
   nächsten liegt: erst der Wert jeder Linie an dieser Stelle, dann die mit
   dem kleinsten senkrechten Abstand. Bei einem Feld voller Linien ist das
   die einzige Art, eine einzelne davon zu greifen. */
function Linienfeld({ reihen, hoehe = 360, yFormat, xFormat, xTitel, yTitel,
  linien = [], band = null, karte, aufKlick, leer }) {
  const S = styles;
  const huelle = useRef(null);
  const breite = useBreite(huelle);
  const [aktiv, setAktiv] = useState(null);
  const [stelle, setStelle] = useState(null);
  const vorherAktiv = useRef(null);
  const letzteBeruehrung = useRef(0);

  const rand = { links: 64, rechts: 16, oben: 14, unten: xTitel ? 40 : 26 };
  const B = Math.max(240, breite);
  const zeichenB = Math.max(60, B - rand.links - rand.rechts);
  const zeichenH = Math.max(60, hoehe - rand.oben - rand.unten);

  if (!reihen.length) return <div style={S.leerFeld}>{leer || "Keine Daten."}</div>;

  const alleY = reihen.flatMap((r) => r.punkte.map((p) => p.y))
    .concat(linien.map((l) => l.y))
    .concat(band ? [band.von, band.bis] : []);
  let yMin = Math.min(...alleY), yMax = Math.max(...alleY);
  const luft = (yMax - yMin) * 0.08 || Math.max(1, Math.abs(yMax) * 0.05);
  yMin -= luft; yMax += luft;
  const xMax = Math.max(1, ...reihen.map((r) => r.ende));

  const px = (x) => rand.links + (x / xMax) * zeichenB;
  const py = (y) => rand.oben + zeichenH - ((y - yMin) / (yMax - yMin)) * zeichenH;

  const pfad = (punkte) => punkte.map((p, i) => `${i ? "L" : "M"}${px(p.x).toFixed(1)},${py(p.y).toFixed(1)}`).join("");
  /* Ab einer Stelle weiterzeichnen, ohne Lücke: die Treppe wird an dieser
     Stelle abgeschnitten und bekommt dort ihren gerade geltenden Wert als
     Anfangspunkt. Bloßes Wegfiltern hinterließe ein Loch bis zum nächsten
     Knick. */
  const ab = (punkte, stelle) => {
    if (stelle <= 0) return punkte;
    let wert = punkte[0].y;
    for (const p of punkte) { if (p.x <= stelle) wert = p.y; else break; }
    return [{ x: stelle, y: wert }, ...punkte.filter((p) => p.x > stelle)];
  };
  // Wert einer Treppe an einer Stelle. Außerhalb ihrer Laufzeit: nichts.
  const wertBei = (r, x) => {
    if (x < 0 || x > r.ende) return null;
    let letzter = null;
    for (const p of r.punkte) { if (p.x <= x) letzter = p; else break; }
    return letzter ? letzter.y : null;
  };

  const naechste = (mx, my) => {
    const x = ((mx - rand.links) / zeichenB) * xMax;
    let treffer = null, nah = Infinity;
    reihen.forEach((r) => {
      const y = wertBei(r, x);
      if (y == null) return;
      const d = Math.abs(py(y) - my);
      if (d < nah) { nah = d; treffer = r; }
    });
    return { reihe: treffer, x: Math.max(0, Math.min(xMax, x)) };
  };
  const ausEreignis = (e) => {
    const kasten = e.currentTarget.getBoundingClientRect();
    const punkt = e.touches?.[0] || e.changedTouches?.[0] || e;
    return naechste(punkt.clientX - kasten.left, punkt.clientY - kasten.top);
  };
  const setzen = (o) => { setAktiv(o.reihe); setStelle(o.x); };

  const yTicks = achsenSchritte(yMin, yMax, 5);
  const xTicks = achsenSchritte(0, xMax, B > 560 ? 7 : 4, true);   // Tage sind ganz
  const aktivWert = aktiv && stelle != null ? wertBei(aktiv, stelle) : null;
  const kartenSeite = stelle != null && px(stelle) > B * 0.55 ? "rechts" : "links";

  return (
    <div ref={huelle} style={{ ...S.feldHuelle, height: hoehe }}>
      {breite > 0 && (
        <svg className="pw-feld" width={B} height={hoehe} style={{ display: "block", touchAction: "pan-y" }}
          onMouseMove={(e) => setzen(ausEreignis(e))}
          onMouseLeave={() => { setAktiv(null); setStelle(null); }}
          onTouchStart={(e) => {
            vorherAktiv.current = aktiv ? aktiv.id : null;
            letzteBeruehrung.current = Date.now();
            setzen(ausEreignis(e));
          }}
          onTouchMove={(e) => { letzteBeruehrung.current = Date.now(); setzen(ausEreignis(e)); }}
          onClick={(e) => {
            const o = ausEreignis(e);
            if (!o.reihe || !aufKlick) return;
            if (Date.now() - letzteBeruehrung.current < 800 && vorherAktiv.current !== o.reihe.id) return;
            aufKlick(o.reihe);
          }}>

          {yTicks.map((w) => (
            <g key={w}>
              <line x1={rand.links} x2={rand.links + zeichenB} y1={py(w)} y2={py(w)}
                stroke={T.line} strokeDasharray="2 4" />
              <text x={rand.links - 8} y={py(w) + 3.5} textAnchor="end" fontSize="10.5" fill={T.muted}
                fontFamily="ui-monospace, Menlo, monospace">{yFormat ? yFormat(w) : w}</text>
            </g>
          ))}
          {xTicks.map((w) => (
            <text key={w} x={px(w)} y={hoehe - rand.unten + 14} textAnchor="middle" fontSize="10.5"
              fill={T.muted} fontFamily="ui-monospace, Menlo, monospace">{xFormat ? xFormat(w) : w}</text>
          ))}
          {/* Die Zone, in der die Inserate verschwinden — dorthin laufen die
              Linien, bevor die Spur abbricht. */}
          {band && (
            <g>
              <rect x={rand.links} width={zeichenB} y={py(band.bis)}
                height={Math.max(2, py(band.von) - py(band.bis))}
                fill={band.farbe || T.good} fillOpacity={0.13} />
              <line x1={rand.links} x2={rand.links + zeichenB} y1={py(band.bis)} y2={py(band.bis)}
                stroke={band.farbe || T.good} strokeWidth={1} opacity={0.45} />
              <line x1={rand.links} x2={rand.links + zeichenB} y1={py(band.von)} y2={py(band.von)}
                stroke={band.farbe || T.good} strokeWidth={1} opacity={0.45} />
              {/* Auf schmalen Feldern läuft die Beschriftung durch die Linien;
                  dort erklärt die Legende den Streifen. */}
              {band.label && B > 520 && (
                <text x={rand.links + zeichenB - 6} y={py(band.bis) - 5} textAnchor="end"
                  fontSize="10" fill={band.farbe || T.good}>{band.label}</text>
              )}
            </g>
          )}
          {linien.map((l, i) => (
            <g key={i}>
              <line x1={rand.links} x2={rand.links + zeichenB} y1={py(l.y)} y2={py(l.y)}
                stroke={l.farbe || T.muted} strokeDasharray="5 4" strokeWidth={1.5} />
              {l.label && <text x={rand.links + 6} y={py(l.y) - 5} fontSize="10" fill={l.farbe || T.muted}>{l.label}</text>}
            </g>
          ))}

          {stelle != null && (
            <line x1={px(stelle)} x2={px(stelle)} y1={rand.oben} y2={rand.oben + zeichenH}
              stroke={T.line} strokeWidth={1.5} />
          )}

          {/* Erst alle blassen Linien, dann die gegriffene obendrauf */}
          {reihen.map((r) => {
            const dran = aktiv && aktiv.id === r.id;
            return (
              <g key={r.id} opacity={aktiv ? (dran ? 1 : 0.22) : 0.8}>
                {/* Der Teil vor der ersten eigenen Beobachtung ist geraten:
                    der erste bekannte Preis, rückwärts fortgeschrieben. */}
                {r.blindBis > 0 && (
                  <path d={pfad([{ x: 0, y: r.punkte[0].y }, { x: r.blindBis, y: r.punkte[0].y }])}
                    fill="none" stroke={r.farbe} strokeWidth={dran ? 2.5 : 1.5}
                    strokeDasharray="3 3" opacity={0.7} />
                )}
                <path d={pfad(ab(r.punkte, r.blindBis))} fill="none"
                  stroke={r.farbe} strokeWidth={dran ? 2.8 : 1.5} strokeLinejoin="round" />
                {r.knicke.map((k, i) => (
                  <circle key={i} cx={px(k.x)} cy={py(k.y)} r={dran ? 4 : 2.6} fill={r.farbe} />
                ))}
                {/* Das Ende einer Linie ist die wichtigste Stelle im Bild.
                    Verschwunden = Treffer: voller Punkt mit Ring darum.
                    Läuft noch  = offenes Ende: kleiner hohler Kreis. */}
                {r.offline ? (
                  <g>
                    <circle cx={px(r.ende)} cy={py(r.punkte[r.punkte.length - 1].y)} r={dran ? 9 : 7}
                      fill="none" stroke={r.farbe} strokeWidth={1.2} opacity={0.55} />
                    <circle cx={px(r.ende)} cy={py(r.punkte[r.punkte.length - 1].y)} r={dran ? 5 : 3.8}
                      fill={r.farbe} />
                  </g>
                ) : (
                  <circle cx={px(r.ende)} cy={py(r.punkte[r.punkte.length - 1].y)} r={dran ? 4.5 : 3.2}
                    fill={T.bg} stroke={r.farbe} strokeWidth={1.6} />
                )}
              </g>
            );
          })}

          {aktivWert != null && (
            <circle cx={px(stelle)} cy={py(aktivWert)} r={4} fill={T.text} />
          )}

          {xTitel && <text x={rand.links + zeichenB / 2} y={hoehe - 6} textAnchor="middle" fontSize="10" fill={T.muted}>{xTitel}</text>}
          {yTitel && (
            <text x={12} y={rand.oben + zeichenH / 2} fontSize="10" fill={T.muted}
              transform={`rotate(-90 12 ${rand.oben + zeichenH / 2})`} textAnchor="middle">{yTitel}</text>
          )}
        </svg>
      )}
      {aktiv && karte && (
        <div className="pw-punktkarte" style={{
          ...S.feldKarte,
          top: Math.min(hoehe - 70, Math.max(4, (aktivWert != null ? py(aktivWert) : hoehe / 2) - 24)),
          ...(kartenSeite === "rechts" ? { right: B - px(stelle) + 14 } : { left: px(stelle) + 14 }),
        }}>
          {karte(aktiv, Math.round(stelle))}
        </div>
      )}
    </div>
  );
}

// Die Karte am Preisverlauf: was diese Linie an dieser Stelle zeigt.
function Verlaufskarte({ r, tag, einheit }) {
  const S = styles;
  const zeige = (p) => (einheit === "prozent"
    ? `${Math.round((p / r.startPreis) * 1000) / 10} %`.replace(".", ",")
    : fmtEUR(p));
  return (
    <div style={S.punktKarte}>
      <div style={{ ...S.punktKopf, color: r.farbe }}>
        Tag {tag} · {r.offline ? `${r.stand} nach ${laufzeitDativ(r.ende)}` : `läuft seit ${laufzeitDativ(r.ende)}`}
      </div>
      <div style={S.punktTitel}>{r.title}</div>
      {r.marke && <div style={S.punktMarke}>{r.marke}</div>}
      <div style={S.punktPreis}>{fmtEUR(r.startPreis)} <span style={S.punktStart}>zum Start</span></div>
      {r.senkungen.length === 0 ? (
        <div style={S.punktFussnote}>Noch keine Senkung beobachtet.</div>
      ) : (
        <div style={S.punktListe}>
          {r.senkungen.slice(0, 5).map((x, i) => (
            <div key={i} style={S.punktZeile}>
              <span style={S.punktLabel}>Tag {x.tag}</span>
              <span style={{ ...S.punktWert, color: T.good }}>
                {zeige(x.nach)} · −{fmtEUR(Math.abs(x.delta))}
              </span>
            </div>
          ))}
          {r.senkungen.length > 5 && <div style={S.punktFussnote}>… und {r.senkungen.length - 5} weitere</div>}
        </div>
      )}
      {r.gesamtPct < 0 && (
        <div style={{ ...S.punktJetzt, color: T.good }}>
          zusammen −{Math.abs(r.gesamtPct).toFixed(1).replace(".", ",")} % auf {fmtEUR(r.letzterPreis)}
        </div>
      )}
      {r.blindBis > 0 && (
        <div style={S.punktFussnote}>Die ersten {laufzeitText(r.blindBis)} sind fortgeschrieben, nicht beobachtet.</div>
      )}
      {r.url && <div style={S.punktFussnote}>Klicken öffnet das Inserat ↗</div>}
    </div>
  );
}

// Die Karte, die beim Zeigen auf einen Punkt der Übersicht erscheint.
/* Die Karte am Kilometerfeld: was dieses Fahrzeug kostet, was die Formel
   an seiner Stelle sagt, und wie weit es davon abweicht. */
function Kilometerkarte({ a }) {
  const S = styles;
  const guenstig = a.delta <= 0;
  return (
    <div style={S.punktKarte}>
      <div style={{ ...S.punktKopf, color: a.offline ? T.muted : T.accent }}>
        {fmtNum(a.km)} km{a.offline ? ` · ${a.stand}` : ""}
      </div>
      <div style={S.punktTitel}>{a.titel}</div>
      {a.marke && <div style={S.punktMarke}>{a.marke}</div>}
      <div style={S.punktPreis}>{fmtEUR(a.preis)}</div>
      <div style={{ ...S.punktJetzt, color: guenstig ? T.good : T.bad }}>
        {guenstig ? "−" : "+"}{fmtEUR(Math.abs(Math.round(a.delta)))} zur Linie
        {" "}({guenstig ? "−" : "+"}{Math.abs((a.delta / a.soll) * 100).toFixed(1).replace(".", ",")} %)
      </div>
      <div style={S.punktListe}>
        <div style={S.punktZeile}>
          <span style={S.punktLabel}>Formel sagt</span>
          <span style={S.punktWert}>{fmtEUR(Math.round(a.soll))}</span>
        </div>
        {a.ez && (
          <div style={S.punktZeile}>
            <span style={S.punktLabel}>Erstzulassung</span>
            <span style={S.punktWert}>{a.ez}</span>
          </div>
        )}
      </div>
      <div style={S.punktFussnote}>
        {guenstig ? "günstig für seine Kilometer" : "teuer für seine Kilometer"} — wenn sonst vergleichbar
      </div>
    </div>
  );
}

function Uebersichtskarte({ p }) {
  const S = styles;
  const gefallen = p.jetzt != null && p.jetzt !== p.preis;
  const zeilen = [
    p.km != null ? ["Kilometer", `${fmtNum(p.km)} km`] : null,
    p.ez ? ["Erstzulassung", p.ez] : null,
    p.linie ? ["Linie", p.linie] : null,
    p.fotos ? ["Exterieur", p.fotos] : null,
    p.ort ? ["Ort", p.ort] : null,
    p.firstSeen ? ["gefunden am", fmtDate(p.firstSeen)] : null,
  ].filter(Boolean);
  return (
    <div style={S.punktKarte}>
      <div style={{ ...S.punktKopf, color: p.offline ? T.muted : T.accent }}>
        {p.offline ? `${p.stand} · stand ${laufzeitDativ(p.tage)}` : `läuft seit ${laufzeitDativ(p.tage)}`}
      </div>
      <div style={S.punktTitel}>{p.title}</div>
      {p.marke && <div style={S.punktMarke}>{p.marke}</div>}
      <div style={S.punktPreis}>{fmtEUR(p.preis)}</div>
      {gefallen && (
        <div style={{ ...S.punktJetzt, color: p.jetzt < p.preis ? T.good : T.bad }}>
          heute {fmtEUR(p.jetzt)} · {p.jetzt < p.preis ? "−" : "+"}{fmtEUR(Math.abs(p.jetzt - p.preis))}
          {p.aenderungen > 1 ? ` in ${p.aenderungen} Schritten` : ""}
        </div>
      )}
      <div style={S.punktListe}>
        {zeilen.map(([k, w]) => (
          <div key={k} style={S.punktZeile}>
            <span style={S.punktLabel}>{k}</span><span style={S.punktWert}>{w}</span>
          </div>
        ))}
      </div>
      {p.guete === "legacy" && (
        <div style={S.punktFussnote}>Nachträglich aufgenommen — das Inserat lief schon.</div>
      )}
      {p.url && <div style={S.punktFussnote}>Klicken öffnet das Inserat ↗</div>}
    </div>
  );
}

function Zahlenfeld({ label, wert, zusatz, accent }) {
  const S = styles;
  return (
    <div style={S.zahlenfeld}>
      <div style={S.zahlenLabel}>{label}</div>
      <div style={{ ...S.zahlenWert, color: accent ? T.accent : T.text }}>{wert}</div>
      {zusatz && <div style={S.zahlenZusatz}>{zusatz}</div>}
    </div>
  );
}

function Stat({ label, value, accent }) {
  return (<div style={styles.stat}><div style={{ ...styles.statValue, color: accent || styles.statValue.color }}>{value}</div><div style={styles.statLabel}>{label}</div></div>);
}

