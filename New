const SERVER_URL = "/api/garage";
const KEY_STORE = "preiswache:key";

// Der Schlüssel liegt auf dem Gerät, nicht im ausgelieferten Programm —
// die Seite ist öffentlich, ein eingebauter Schlüssel wäre keiner.
const readKey = () => { try { return localStorage.getItem(KEY_STORE) || ""; } catch (_) { return ""; } };
const writeKey = (k) => { try { k ? localStorage.setItem(KEY_STORE, k) : localStorage.removeItem(KEY_STORE); } catch (_) {} };

function localRead() {
  try {
    const roh = localStorage.getItem(STORE_KEY);
    return roh ? JSON.parse(roh) : null;
  } catch (_) { return null; }
}
function localWrite(vehicles) {
  try { localStorage.setItem(STORE_KEY, JSON.stringify({ vehicles })); return true; }
  catch (e) { console.error("Lokal speichern fehlgeschlagen", e); return false; }
}

async function serverRead(key) {
  const r = await fetch(SERVER_URL, { headers: { authorization: `Bearer ${key}` }, cache: "no-store" });
  const daten = await r.json().catch(() => ({}));
  if (!r.ok) throw Object.assign(new Error(daten.error || `Server antwortete mit ${r.status}`), { status: r.status });
  return daten;
}
async function serverWrite(key, vehicles, base) {
  const r = await fetch(SERVER_URL, {
    method: "PUT",
    headers: { authorization: `Bearer ${key}`, "content-type": "application/json" },
    body: JSON.stringify({ vehicles, base }),
  });
  const daten = await r.json().catch(() => ({}));
  if (!r.ok) throw Object.assign(new Error(daten.error || `Server antwortete mit ${r.status}`), { status: r.status, daten });
  return daten;
}

// Gespeicherte Einträge auf das heutige Vokabular heben, egal woher sie stammen.
function migrate(vehicles) {
  Object.values(vehicles || {}).forEach((v) => {
    // Früher stand hier "Unbekannt", wenn das Inserat nichts dazu sagte.
    // Genau das heißt heute "Unfallfrei" beziehungsweise "Keine".
    v.accidentStatus = normalizeStatus(v.accidentStatus, ACCIDENT_OPTS, "Unfallfrei");
    v.currentIssueStatus = normalizeStatus(v.currentIssueStatus, ISSUE_OPTS, "Keine");
    v.previousDamageStatus = normalizeStatus(v.previousDamageStatus, PREV_OPTS);
    v.repairScope = normalizeStatus(v.repairScope, SCOPE_OPTS);
    v.category = normalizeChoice(v.category, "category", CATEGORY_OPTS);
    v.fuel = normalizeChoice(v.fuel, "fuel", FUEL_OPTS);
    v.gearbox = normalizeChoice(v.gearbox, "gearbox", GEARBOX_OPTS);
    v.drivetrain = normalizeChoice(v.drivetrain, "drivetrain", DRIVE_OPTS);
    v.sellerType = normalizeChoice(v.sellerType, "sellerType", SELLER_OPTS);
    v.condition = normalizeChoice(v.condition, "condition", CONDITION_OPTS);
    v.color = normalizeChoice(v.color, "color", COLOR_OPTS);
    v.month = normalizeMonth(v.month);
    v.photoDamage = normalizeChoice(v.photoDamage, "photoDamage", PHOTO_DAMAGE_OPTS);
    v.listingPrep = normalizeChoice(v.listingPrep, "listingPrep", LISTING_PREP_OPTS);
    v.showcase = normalizeChoice(v.showcase, "showcase", SHOWCASE_OPTS) || "Normal";
    v.listingStatus = normalizeChoice(v.listingStatus, "listingStatus", STATUS_OPTS) || "Aktiv";
    v.listedSince = v.listedSince || v.priceHistory?.[0]?.date || "";
  });
  return vehicles || {};
}

