  // Orderbuch: aufgeklappte Preisstufe und der Preis im Rechner
  const [buchStufe, setBuchStufe] = useState(null);
  const [buchPreis, setBuchPreis] = useState("");
  // Absorptionskarte: Zielzeit und aufgeklappte Preisstufe
