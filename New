// und aktuellen Mängeln ist das nicht "Unbekannt", sondern die Aussage
// "es gibt keine Hinweise darauf" — auch für alte Einträge, in denen noch
// "Unbekannt" steht.
function normalizeStatus(value, options, standard = "Unbekannt") {
  const raw = String(value == null ? "" : value).trim();
  if (!raw) return standard;
  const key = raw.toLowerCase();
  const treffer = options.find((o) => o.toLowerCase() === key);
  if (treffer) return treffer;
  const syn = STATUS_SYNONYME[key];
  if (syn && options.includes(syn)) return syn;
  const teil = options.find((o) => o !== "Unbekannt" && key.includes(o.toLowerCase()));
  if (teil) return teil;
  return standard;
}

