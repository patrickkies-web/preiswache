// Gedächtnisstütze, bevor man die Fotos beurteilt.
function fotoHinweise(v) {
  const texte = [
    ["Aktuelle Mängel", v.damageCurrent],
    ["Frühere Schäden", v.damagePrevious],
    ["Bereits repariert", v.damageRepaired],
  ].filter(([, t]) => String(t || "").trim());
  const notiz = String(v.note || "").trim();
  if (notiz && SICHTBAR_RE.test(notiz)) texte.push(["Notiz der KI", notiz]);

  const flaggen = [];
  if (v.accidentStatus === "Unfallwagen") flaggen.push("als Unfallwagen eingetragen");
  if (v.currentIssueStatus === "Vorhanden") flaggen.push("aktuelle Mängel vermerkt");
  if (v.previousDamageStatus === "Vorhanden") flaggen.push("frühere Schäden vermerkt");
  if (v.repairScope && !["Keine", "Unbekannt"].includes(v.repairScope)) {
    flaggen.push(`Reparaturbedarf ${v.repairScope.toLowerCase()}`);
  }
  return { texte, flaggen, hat: texte.length > 0 || flaggen.length > 0 };
}

