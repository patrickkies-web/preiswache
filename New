// Leer bleibt leer: ein erfundener Wert wäre schlimmer als eine Lücke.
function normalizeChoice(value, feld, options) {
  const raw = String(value == null ? "" : value).trim();
  if (!raw) return "";
  const key = raw.toLowerCase();
  const treffer = options.find((o) => o.toLowerCase() === key);
  if (treffer) return treffer;
  const syn = CHOICE_SYNONYME[feld] || {};
  const stichwort = Object.keys(syn).sort((a, b) => b.length - a.length).find((s) => key.includes(s));
  if (stichwort) return syn[stichwort];
  const teil = options.find((o) => key.includes(o.toLowerCase()));
  return teil || "";
}

// "3" -> "03", "März" -> "03"; alles andere fällt weg.
const MONATE = ["januar", "februar", "märz", "april", "mai", "juni",
  "juli", "august", "september", "oktober", "november", "dezember"];
function normalizeMonth(value) {
  const raw = String(value == null ? "" : value).trim();
  if (!raw) return "";
  const zahl = raw.match(/^(\d{1,2})/);
  if (zahl) { const n = parseInt(zahl[1], 10); return n >= 1 && n <= 12 ? String(n).padStart(2, "0") : ""; }
  const i = MONATE.findIndex((m) => raw.toLowerCase().startsWith(m.slice(0, 3)));
  return i >= 0 ? String(i + 1).padStart(2, "0") : "";
}

/* --- Links -----------------------------------------------------------
   Was im Feld "url" ankommt, ist selten eine nackte Adresse. Sprachmodelle
   verpacken Links gern als Markdown — [Inserat](https://…) —, setzen sie in
   spitze Klammern, hängen einen Punkt an oder schreiben einen ganzen Satz
   drumherum. Ungeprüft übernommen ergibt das eine Adresse, die nirgendwo
   hinführt. Deshalb wird die Adresse herausgeschnitten, bevor irgendetwas
   damit passiert. */
const LINK_MUSTER = /(?:https?:\/\/)?(?:[\w-]+\.)+[a-z]{2,}(?::\d+)?(?:\/[^\s<>"'`]*)?/i;
function linkAusText(s) {
  let t = String(s == null ? "" : s).trim();
  if (!t) return "";
  // [Text](Adresse) → Adresse. Das Ziel steht in der runden Klammer.
  const markdown = t.match(/\]\(\s*([^\s)]+)\s*\)/);
  if (markdown) t = markdown[1];
  const treffer = t.match(LINK_MUSTER);
  if (!treffer) return "";
  // Satzzeichen am Ende gehören zum Satz, nicht zur Adresse.
  return treffer[0].replace(/[.,;:!?)\]}>»"']+$/, "");
}
// Steckt in dem, was du eingetippt oder die KI geschrieben hat, überhaupt
// eine Adresse? Erst danach ist der Link eine Pflichtangabe erfüllt.
const istLink = (s) => !!linkAusText(s);
// Adressen aus einem Fließtext klauben. Hier wird streng gesucht — ohne
// "https://" oder "www." wäre jedes "details.html" ein Treffer.
function linksImText(s) {
  const roh = String(s == null ? "" : s).match(/(?:https?:\/\/|www\.)[^\s<>"'`,;]+/gi) || [];
  return [...new Set(roh.map(normalizeUrl).filter(Boolean))];
}
// Ohne "https://" deutet der Browser den Link als Pfad auf dieser Seite.
function normalizeUrl(s) {
  const t = linkAusText(s);
  if (!t) return "";
  return /^https?:\/\//i.test(t) ? t : `https://${t.replace(/^\/+/, "")}`;
}


