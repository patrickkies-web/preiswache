      const vehicles = data.vehicles || {};
      // Früher gespeicherte Begriffe auf das heutige Vokabular heben,
      // sonst wären sie über die Filter nicht mehr erreichbar.
      Object.values(vehicles).forEach((v) => {
        v.accidentStatus = normalizeStatus(v.accidentStatus, ACCIDENT_OPTS);
        v.currentIssueStatus = normalizeStatus(v.currentIssueStatus, ISSUE_OPTS);
        v.previousDamageStatus = normalizeStatus(v.previousDamageStatus, PREV_OPTS);
        v.repairScope = normalizeStatus(v.repairScope, SCOPE_OPTS);
        v.category = normalizeChoice(v.category, "category", CATEGORY_OPTS);
        v.fuel = normalizeChoice(v.fuel, "fuel", FUEL_OPTS);
        v.gearbox = normalizeChoice(v.gearbox, "gearbox", GEARBOX_OPTS);
        v.drivetrain = normalizeChoice(v.drivetrain, "drivetrain", DRIVE_OPTS);
        v.sellerType = normalizeChoice(v.sellerType, "sellerType", SELLER_OPTS);
        v.condition = normalizeChoice(v.condition, "condition", CONDITION_OPTS);
        v.color = normalizeChoice(v.color, "color", COLOR_OPTS);
        v.month = normalizeMonth(v.month);
        v.photoDamage = normalizeChoice(v.photoDamage, "photoDamage", PHOTO_DAMAGE_OPTS);
        v.listingPrep = normalizeChoice(v.listingPrep, "listingPrep", LISTING_PREP_OPTS);
        v.listingStatus = normalizeChoice(v.listingStatus, "listingStatus", STATUS_OPTS) || "Aktiv";
        v.listedSince = v.listedSince || v.priceHistory?.[0]?.date || "";
      });
      return vehicles;
    }
  } catch (_) {}
  return {};
}
async function saveGarage(vehicles) {
  try { await window.storage.set(STORE_KEY, JSON.stringify({ vehicles })); return true; }
  catch (e) { console.error("Speichern fehlgeschlagen", e); return false; }
}

/* ----------------------------- App ------------------------------- */

export default function App() {
  const [vehicles, setVehicles] = useState({});
  const [loaded, setLoaded] = useState(false);
  const [raw, setRaw] = useState("");
  const [preview, setPreview] = useState(null);
  const [notice, setNotice] = useState(null);

  const [addFor, setAddFor] = useState(null);
  const [addDate, setAddDate] = useState(todayISO());
  const [addPrice, setAddPrice] = useState("");

  // Deine Antworten zu den Fotos, je Fahrzeug aus der Vorschau
  const [answers, setAnswers] = useState({});
  // Inserat abschließen
  const [closeFor, setCloseFor] = useState(null);
  const [closeStatus, setCloseStatus] = useState("Verkauft");
  const [closeDate, setCloseDate] = useState(todayISO());
  // Preisverlauf nach Datum oder nach Tagen seit Inserat
  const [chartMode, setChartMode] = useState("datum");
  // Reiter und aufgeklappte Zeilen im Verzeichnis
  const [tab, setTab] = useState("erfassen");
  const [openRows, setOpenRows] = useState({});
  const fileRef = useRef(null);
  const toggleRow = useCallback((id) => setOpenRows((p) => ({ ...p, [id]: !p[id] })), []);

  // Analyse & Suche
  const [q, setQ] = useState("");
  const [filters, setFilters] = useState({});
  const [priceMax, setPriceMax] = useState("");
  const [kmMax, setKmMax] = useState("");
  const [moreFilters, setMoreFilters] = useState(false);
  const [groupBy, setGroupBy] = useState("repairScope");

  useEffect(() => { loadGarage().then((v) => { setVehicles(v); setLoaded(true); }); }, []);

  const persist = useCallback((next) => { setVehicles(next); saveGarage(next); }, []);
  const updateVehicle = useCallback((id, updater) => {
    setVehicles((prev) => { const v = prev[id]; if (!v) return prev; const next = { ...prev, [id]: updater({ ...v }) }; saveGarage(next); return next; });
  }, []);

  const list = useMemo(() => Object.values(vehicles).sort((a, b) => (b.updatedAt || "").localeCompare(a.updatedAt || "")), [vehicles]);

  /* ---- Import ---- */
  // Nimmt wahlweise übergebenen Text (aus einer Datei) oder den Feldinhalt.
  function handlePreview(text) {
    const quelle = typeof text === "string" ? text : raw;
    const res = parseImport(quelle);
    if (res.error) { setNotice({ type: "err", msg: res.error }); setPreview(null); return; }
    // Bei bekannten Fahrzeugen die früheren Antworten vorbelegen.
    const vorbelegt = {};
    res.vehicles.forEach((v) => {
      const alt = vehicles[v.id];
      // Aus einer Sicherung mitgelieferte Antworten zählen zuerst,
      // danach die des bereits erfassten Fahrzeugs.
      vorbelegt[v.id] = {
        photoDamage: v.photoDamage || alt?.photoDamage || "",
        listingPrep: v.listingPrep || alt?.listingPrep || "",
        url: v.url || alt?.url || "",
      };
    });
    setAnswers(vorbelegt);
    setPreview(res.vehicles); setNotice(null);
  }
  async function handleFile(e) {
    const datei = e.target.files?.[0];
    e.target.value = "";           // damit dieselbe Datei erneut wählbar bleibt
    if (!datei) return;
    try {
      const text = await datei.text();
      if (!text.trim()) { setNotice({ type: "err", msg: `„${datei.name}" ist leer.` }); return; }
      setRaw(text);
      handlePreview(text);
    } catch (_) {
      setNotice({ type: "err", msg: `„${datei.name}" konnte nicht gelesen werden.` });
    }
  }

  const setAnswer = (id, feld, wert) =>
    setAnswers((prev) => ({ ...prev, [id]: { ...prev[id], [feld]: wert } }));
  const alleBeantwortet = !preview || preview.every((v) => {
    const a = answers[v.id] || {};
    return a.photoDamage && a.listingPrep && istLink(a.url);
  });

  function confirmImport() {
    const next = { ...vehicles }; let added = 0, updated = 0;
    preview.forEach((raw_) => {
      const antw = answers[raw_.id] || {};
      const incoming = { ...raw_, ...antw, url: normalizeUrl(antw.url || raw_.url) };
      const existing = next[incoming.id];
      if (existing) {
        const merged = { ...existing };
        TEXT_FIELDS.forEach((k) => { if (incoming[k]) merged[k] = incoming[k]; });
        if (incoming.mileage != null) merged.mileage = incoming.mileage;
        if (incoming.repairCount != null) merged.repairCount = incoming.repairCount;
        const byDate = {};
        existing.priceHistory.forEach((p) => { byDate[p.date] = p.price; });
        incoming.priceHistory.forEach((p) => { byDate[p.date] = p.price; });
        merged.priceHistory = Object.entries(byDate).map(([date, price]) => ({ date, price })).sort((a, b) => a.date.localeCompare(b.date));
        // Der früheste bekannte Tag bleibt der Beginn des Inserats.
        merged.listedSince = [existing.listedSince, incoming.listedSince, merged.priceHistory[0]?.date]
          .filter(Boolean).sort()[0] || "";
        // Ein Preis-Update der KI enthält keinen Abschluss und lässt ihn unangetastet;
        // eine Sicherung bringt ihn mit und stellt ihn wieder her.
        merged.listingStatus = incoming.listingStatus || existing.listingStatus || "Aktiv";
        merged.closedDate = incoming.closedDate || existing.closedDate || "";
        merged.updatedAt = new Date().toISOString();
        next[incoming.id] = merged; updated++;
      } else {
        next[incoming.id] = { ...incoming, listingStatus: incoming.listingStatus || "Aktiv",
          createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() }; added++;
      }
    });
    persist(next); setPreview(null); setRaw("");
    setNotice({ type: "ok", msg: `${added} neu · ${updated} aktualisiert.` });
  }

  /* ---- Preis-Updates ---- */
  function openAdd(v) { setAddFor(v.id); const last = v.priceHistory[v.priceHistory.length - 1]; setAddPrice(last ? String(last.price) : ""); setAddDate(todayISO()); }
  function addPoint(v) {
    const price = coerceNum(addPrice);
    if (price == null || !addDate) { setNotice({ type: "err", msg: "Datum und Preis angeben." }); return; }
    updateVehicle(v.id, (veh) => { const hist = veh.priceHistory.filter((p) => p.date !== addDate); hist.push({ date: addDate, price }); hist.sort((a, b) => a.date.localeCompare(b.date)); return { ...veh, priceHistory: hist, updatedAt: new Date().toISOString() }; });
    setAddFor(null); setAddPrice("");
  }
  function deletePoint(v, date) { updateVehicle(v.id, (veh) => ({ ...veh, priceHistory: veh.priceHistory.filter((p) => p.date !== date), updatedAt: new Date().toISOString() })); }
  function removeVehicle(id) { const next = { ...vehicles }; delete next[id]; persist(next); }

  /* ---- Inserat abschließen / wieder öffnen ---- */
  function openClose(v) {
    setCloseFor(v.id);
    setCloseStatus(v.listingStatus && v.listingStatus !== "Aktiv" ? v.listingStatus : "Verkauft");
    setCloseDate(v.closedDate || todayISO());
  }
  function confirmClose(v) {
    if (!closeDate) { setNotice({ type: "err", msg: "Bitte ein Datum angeben." }); return; }
    updateVehicle(v.id, (veh) => ({ ...veh, listingStatus: closeStatus, closedDate: closeDate, updatedAt: new Date().toISOString() }));
    setCloseFor(null);
  }
  function reopen(v) {
    updateVehicle(v.id, (veh) => ({ ...veh, listingStatus: "Aktiv", closedDate: "", updatedAt: new Date().toISOString() }));
  }

  /* ---- Export (Backup als JSON-Datei) ---- */
  async function exportGarage() {
    const data = JSON.stringify(Object.values(vehicles), null, 2);
    const filename = `preiswache-export-${todayISO()}.json`;
    try {
      if (window.claude?.downloads?.save) {
        await window.claude.downloads.save({ filename, data });
      } else {
        const url = URL.createObjectURL(new Blob([data], { type: "application/json" }));
        const a = document.createElement("a");
        a.href = url; a.download = filename;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      setNotice({ type: "ok", msg: `Export gespeichert: ${filename}. Zum Wiederherstellen den Dateiinhalt oben ins Import-Feld einfügen.` });
    } catch (_) {
      setNotice({ type: "err", msg: "Export abgebrochen." });
    }
  }

  /* ---- Chart Preisverlauf ---- */
  const chart = useMemo(() => {
    const withHistory = list.filter((v) => v.priceHistory?.length);
    if (chartMode === "tage") {
      // Alle Inserate beginnen bei Tag 0 und liegen dadurch übereinander.
      const proAuto = withHistory.map((v) => {
        const start = inseriertSeit(v);
        return { v, punkte: v.priceHistory.map((p) => ({ tag: tageZwischen(start, p.date) ?? 0, price: p.price })) };
      });
      const tage = [...new Set(proAuto.flatMap((a) => a.punkte.map((p) => p.tag)))].sort((a, b) => a - b);
      const rows = tage.map((tag) => {
        const row = { tag };
        proAuto.forEach(({ v, punkte }) => { const pt = punkte.find((p) => p.tag === tag); row[v.id] = pt ? pt.price : null; });
        return row;
      });
      return { rows, series: withHistory, xKey: "tag" };
    }
    const dates = [...new Set(withHistory.flatMap((v) => v.priceHistory.map((p) => p.date)))].sort();
    const rows = dates.map((date) => { const row = { date }; withHistory.forEach((v) => { const pt = v.priceHistory.find((p) => p.date === date); row[v.id] = pt ? pt.price : null; }); return row; });
    return { rows, series: withHistory, xKey: "date" };
  }, [list, chartMode]);
  const totalDrop = useMemo(() => list.reduce((s, v) => { const h = v.priceHistory; if (!h || h.length < 2) return s; const d = h[0].price - h[h.length - 1].price; return s + (d > 0 ? d : 0); }, 0), [list]);
  const colorFor = (id) => { const i = chart.series.findIndex((s) => s.id === id); return COLORS[(i < 0 ? Object.keys(vehicles).indexOf(id) : i) % COLORS.length]; };

  /* ---- Analyse: Filter + Vergleich ---- */
  const searchable = (v) => [v.title, v.subtitle, v.make, v.model, v.series, v.trimline, v.category, v.fuel, v.gearbox, v.drivetrain, v.condition, v.color, v.location, v.sellerType, v.dealerName, v.note, v.damageCurrent, v.damagePrevious, v.damageRepaired].join(" ").toLowerCase();

  const filtered = useMemo(() => list.filter((v) => {
    if (q.trim() && !searchable(v).includes(q.trim().toLowerCase())) return false;
    for (const [f, val] of Object.entries(filters)) { if (val && (v[f] || "") !== val) return false; }
    const pmax = coerceNum(priceMax); if (pmax != null) { const lp = lastPrice(v); if (lp == null || lp > pmax) return false; }
    const kmax = coerceNum(kmMax); if (kmax != null) { if (v.mileage == null || v.mileage > kmax) return false; }
    return true;
  }), [list, q, filters, priceMax, kmMax]);

  const distinct = (field) => [...new Set(list.map((v) => v[field]).filter(Boolean))].sort();

  const groups = useMemo(() => {
    const m = {};
    filtered.forEach((v) => { const key = v[groupBy] || "—"; (m[key] = m[key] || []).push(v); });
    return Object.entries(m).map(([group, vs]) => {
      const prices = vs.map(lastPrice).filter((x) => x != null);
      const kms = vs.map((v) => v.mileage).filter((x) => x != null);
      const avg = prices.length ? Math.round(prices.reduce((a, b) => a + b, 0) / prices.length) : null;
      const avgKm = kms.length ? Math.round(kms.reduce((a, b) => a + b, 0) / kms.length) : null;
      return { group, count: vs.length, avg, avgKm };
    }).sort((a, b) => (b.avg || 0) - (a.avg || 0));
  }, [filtered, groupBy]);

  /* ---- Laufzeiten ---- */
  const laufzeiten = useMemo(() => list.map((v) => {
    const { anzahl, summe } = senkungen(v);
    return { id: v.id, title: v.title || v.id, seit: inseriertSeit(v), tage: laufzeitTage(v),
      anzahl, summe, status: v.listingStatus || "Aktiv", closedDate: v.closedDate || "" };
  }).sort((a, b) => (b.tage ?? -1) - (a.tage ?? -1)), [list]);

  const laufSchnitt = useMemo(() => {
    const fertig = laufzeiten.filter((r) => r.status !== "Aktiv" && r.tage != null);
    return { abgeschlossen: fertig.length,
      schnitt: fertig.length ? Math.round(fertig.reduce((s, r) => s + r.tage, 0) / fertig.length) : null };
  }, [laufzeiten]);

  const alleOffen = list.length > 0 && list.every((v) => openRows[v.id]);

  const activeFilterCount = Object.values(filters).filter(Boolean).length + (priceMax ? 1 : 0) + (kmMax ? 1 : 0) + (q.trim() ? 1 : 0);
  const resetFilters = () => { setQ(""); setFilters({}); setPriceMax(""); setKmMax(""); };
  const setFilter = (f, val) => setFilters((prev) => ({ ...prev, [f]: val }));

  const S = styles;

  return (
    <div style={S.page}>
      <style>{globalCss}</style>

      <header style={S.header} className="pw-header">
        <div style={S.brandRow}>
          <div style={S.logo}><Gauge size={22} color={T.bg} strokeWidth={2.5} /></div>
          <div><div style={S.brandName}>PREISWACHE</div><div style={S.brandSub}>Tracken · Analysieren · Vergleichen</div></div>
        </div>
        <div style={S.stats}>
          <Stat label="Fahrzeuge" value={fmtNum(list.length)} />
          <Stat label="Beob. Rückgänge" value={fmtEUR(totalDrop)} accent={T.good} />
        </div>
      </header>

      <nav style={S.tabs}>
        <button style={tab === "erfassen" ? S.tabOn : S.tabOff} onClick={() => setTab("erfassen")}>
          <Upload size={14} /> Erfassen &amp; Analysieren
        </button>
        <button style={tab === "verzeichnis" ? S.tabOn : S.tabOff} onClick={() => setTab("verzeichnis")}>
          <Car size={14} /> Verzeichnis
          {list.length > 0 && <span style={tab === "verzeichnis" ? S.tabCountOn : S.tabCount}>{list.length}</span>}
        </button>
      </nav>

      {tab === "erfassen" && (<>

      {/* Import */}
      <section style={S.panel}>
        <div style={S.panelTitle}><Upload size={15} /> Fahrzeug importieren</div>
        <p style={S.hint}>
          Schick einer KI das Inserat als PDF → du bekommst einen <b style={{ color: T.text }}>JSON-Block</b> mit allen Daten
          und den definierten Analyse-Begriffen. Antwort einfach komplett hier einfügen — Codeblock-Zeichen und Text
          drumherum werden ignoriert. Gleiche <code style={S.code}>id</code> = Preis-Punkte werden ergänzt.
          Über <b style={{ color: T.text }}>Datei laden</b> spielst du eine zuvor exportierte Sicherung zurück.
        </p>
        <textarea value={raw} onChange={(e) => setRaw(e.target.value)}
          placeholder='Antwort der KI hier einfügen…' style={S.textarea} spellCheck={false} />
        <div style={S.row}>
          <button style={S.primaryBtn} onClick={handlePreview} disabled={!raw.trim()}><Upload size={16} /> Prüfen</button>
          <input ref={fileRef} type="file" accept=".json,.txt,application/json,text/plain"
            onChange={handleFile} style={{ display: "none" }} />
          <button style={S.ghostBtn} onClick={() => fileRef.current?.click()}
            title="Eine zuvor exportierte JSON-Datei laden">
            <FileUp size={15} /> Datei laden
          </button>
          {raw && <button style={S.ghostBtn} onClick={() => { setRaw(""); setPreview(null); setNotice(null); }}><X size={15} /> Leeren</button>}
        </div>
        {notice && (
          <div style={{ ...S.notice, borderColor: notice.type === "err" ? T.bad : T.good }}>
            {notice.type === "err" ? <AlertTriangle size={15} color={T.bad} /> : <Check size={15} color={T.good} />}<span>{notice.msg}</span>
          </div>
        )}
        {preview && (
          <div style={S.draft}>
            <div style={S.draftHead}><span>Wird importiert</span><span style={S.badge}>{preview.length} {preview.length === 1 ? "Fahrzeug" : "Fahrzeuge"}</span></div>
            {preview.map((v) => (
              <div key={v.id} style={S.previewBlock}>
                <div style={S.previewRow}>
                  <span style={S.previewTitle}>{v.title || "(ohne Titel)"}</span>
                  <span style={S.previewMeta}>
                    {[erstzulassung(v), v.mileage != null ? `${fmtNum(v.mileage)} km` : null, v.repairScope ? `Rep. ${v.repairScope}` : null,
                      v.priceHistory.length ? fmtEUR(v.priceHistory[v.priceHistory.length - 1].price) : "kein Preis"].filter(Boolean).join(" · ")}
                    {vehicles[v.id] && <span style={S.updTag}> aktualisiert</span>}
                  </span>
                </div>
                <div style={S.askBlock}>
                  <div style={S.askIntro}>Deine Einschätzung — das kann dir keine KI abnehmen:</div>
                  <ChoiceQuestion frage={PHOTO_DAMAGE_FRAGE} options={PHOTO_DAMAGE_OPTS} hilfe={PHOTO_DAMAGE_HILFE}
                    value={answers[v.id]?.photoDamage || ""} onChange={(w) => setAnswer(v.id, "photoDamage", w)} />
                  <ChoiceQuestion frage={LISTING_PREP_FRAGE} options={LISTING_PREP_OPTS} hilfe={LISTING_PREP_HILFE}
                    value={answers[v.id]?.listingPrep || ""} onChange={(w) => setAnswer(v.id, "listingPrep", w)} />
                  <div style={S.askItem}>
                    <div style={S.askFrage}>Link zum Inserat</div>
                    <input value={answers[v.id]?.url || ""} onChange={(e) => setAnswer(v.id, "url", e.target.value)}
                      placeholder="mobile.de/…" style={S.askInput} inputMode="url" spellCheck={false} />
                    <div style={S.askHilfe}>
                      {istLink(answers[v.id]?.url)
                        ? "Von hier kommst du später mit einem Klick zurück ins Inserat."
                        : "Pflichtangabe — ohne Link findest du das Inserat später nicht wieder."}
                    </div>
                  </div>
                </div>
              </div>
            ))}
            <div style={S.row}>
              <button style={S.primaryBtn} onClick={confirmImport} disabled={!alleBeantwortet}><Check size={16} /> Importieren</button>
              <button style={S.ghostBtn} onClick={() => setPreview(null)}><X size={15} /> Abbrechen</button>
              {!alleBeantwortet && <span style={S.askHint}>Beide Fragen beantworten und den Link einfügen, dann geht es weiter.</span>}
            </div>
          </div>
        )}
      </section>

      {/* Preisverlauf */}
      <section style={S.panel}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between", flexWrap: "wrap", gap: 10 }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8 }}><TrendingDown size={15} /> Preisverlauf aller Fahrzeuge</span>
          <span style={S.toggleGroup}>
            <button style={chartMode === "datum" ? S.toggleOn : S.toggleOff} onClick={() => setChartMode("datum")}>Nach Datum</button>
            <button style={chartMode === "tage" ? S.toggleOn : S.toggleOff} onClick={() => setChartMode("tage")}
              title="Alle Inserate starten bei Tag 0 — so lassen sich die Verläufe direkt übereinanderlegen">Tage seit Inserat</button>
          </span>
        </div>
        {chart.rows.length === 0 ? (
          <div style={S.empty}><Car size={30} color={T.line} /><span>Noch keine Preisdaten. Importiere ein Fahrzeug oder trage über „+ Preis-Update" einen Preis mit Datum ein.</span></div>
        ) : (
          <div style={{ width: "100%", height: 320 }}>
            <ResponsiveContainer>
              <LineChart data={chart.rows} margin={{ top: 8, right: 12, left: 4, bottom: 4 }}>
                <CartesianGrid stroke={T.line} strokeDasharray="2 4" />
                <XAxis dataKey={chart.xKey} type={chartMode === "tage" ? "number" : "category"}
                  domain={chartMode === "tage" ? [0, "dataMax"] : undefined}
                  tickFormatter={chartMode === "tage" ? (t) => `${t} T` : fmtDate}
                  stroke={T.muted} tick={{ fontSize: 11, fill: T.muted }} />
                <YAxis tickFormatter={(v) => (v >= 1000 ? `${Math.round(v / 1000)}k` : v)} stroke={T.muted} tick={{ fontSize: 11, fill: T.muted }} width={44} />
                <Tooltip contentStyle={{ background: T.surface2, border: `1px solid ${T.line}`, borderRadius: 8, fontSize: 12, color: T.text }} labelFormatter={(d) => (chartMode === "tage" ? `Tag ${d}` : fmtDate(d))} formatter={(val, key) => [fmtEUR(val), vehicles[key]?.title?.slice(0, 28) || key]} />
                <Legend wrapperStyle={{ fontSize: 11 }} formatter={(id) => (vehicles[id]?.title?.slice(0, 24) || id)} />
                {chart.series.map((v) => (<Line key={v.id} type="monotone" dataKey={v.id} name={v.id} stroke={colorFor(v.id)} strokeWidth={2} connectNulls dot={{ r: 3 }} activeDot={{ r: 5 }} />))}
              </LineChart>
            </ResponsiveContainer>
          </div>
        )}
      </section>

      {/* Analyse & Suche */}
      <section style={S.panel}>
        <div style={S.panelTitle}><Search size={15} /> Analyse &amp; Suche</div>

        <div style={S.searchWrap}>
          <Search size={15} color={T.muted} />
          <input value={q} onChange={(e) => setQ(e.target.value)} placeholder="Volltext: Marke, Modell, Notiz, Schäden …" style={S.searchInput} />
          {activeFilterCount > 0 && <button style={S.resetBtn} onClick={resetFilters}><X size={13} /> {activeFilterCount}</button>}
        </div>

        <div style={S.filterGrid}>
          <SelectFilter label="Reparatur-Umfang" value={filters.repairScope || ""} onChange={(v) => setFilter("repairScope", v)} options={SCOPE_OPTS} />
          <SelectFilter label="Aktuelle Mängel" value={filters.currentIssueStatus || ""} onChange={(v) => setFilter("currentIssueStatus", v)} options={ISSUE_OPTS} />
          <SelectFilter label="Unfallstatus" value={filters.accidentStatus || ""} onChange={(v) => setFilter("accidentStatus", v)} options={ACCIDENT_OPTS} />
          <SelectFilter label="Marke" value={filters.make || ""} onChange={(v) => setFilter("make", v)} options={distinct("make")} />
          <div style={S.rangeField}><span style={S.fieldLabel}>Preis max (€)</span><input inputMode="decimal" value={priceMax} onChange={(e) => setPriceMax(e.target.value)} style={S.input} placeholder="z. B. 15000" /></div>
          <div style={S.rangeField}><span style={S.fieldLabel}>km max</span><input inputMode="decimal" value={kmMax} onChange={(e) => setKmMax(e.target.value)} style={S.input} placeholder="z. B. 150000" /></div>
        </div>

        <button style={S.moreBtn} onClick={() => setMoreFilters((m) => !m)}>
          <Filter size={13} /> {moreFilters ? "Weniger Filter" : "Mehr Filter"}
        </button>
        {moreFilters && (
          <div style={S.filterGrid}>
            {FILTER_FIELDS.filter(([f]) => !["repairScope", "currentIssueStatus", "accidentStatus", "make"].includes(f)).map(([f, label]) => {
              const vorhanden = distinct(f);
              const opts = FIXED_OPTS[f] ? FIXED_OPTS[f].filter((o) => vorhanden.includes(o)) : vorhanden;
              if (!opts.length) return null;
              return <SelectFilter key={f} label={label} value={filters[f] || ""} onChange={(v) => setFilter(f, v)} options={opts} />;
            })}
          </div>
        )}

        {/* Vergleich */}
        <div style={S.compareHead}>
          <span style={S.compareTitle}>Vergleich — Ø Preis nach</span>
          <select value={groupBy} onChange={(e) => setGroupBy(e.target.value)} style={S.selectInline}>
            {GROUP_FIELDS.map(([f, label]) => <option key={f} value={f}>{label}</option>)}
          </select>
          <span style={S.resultCount}>{filtered.length} Treffer</span>
        </div>
        {groups.length === 0 ? (
          <div style={S.emptySmall}>Keine Treffer für die aktuelle Auswahl.</div>
        ) : (
          <>
            <div style={{ width: "100%", height: Math.max(120, groups.length * 46 + 30) }}>
              <ResponsiveContainer>
                <BarChart data={groups} layout="vertical" margin={{ top: 4, right: 16, left: 4, bottom: 4 }}>
                  <CartesianGrid stroke={T.line} strokeDasharray="2 4" horizontal={false} />
                  <XAxis type="number" tickFormatter={(v) => (v >= 1000 ? `${Math.round(v / 1000)}k` : v)} stroke={T.muted} tick={{ fontSize: 11, fill: T.muted }} />
                  <YAxis type="category" dataKey="group" width={92} stroke={T.muted} tick={{ fontSize: 11, fill: T.text }} />
                  <Tooltip contentStyle={{ background: T.surface2, border: `1px solid ${T.line}`, borderRadius: 8, fontSize: 12, color: T.text }}
                    formatter={(val, n, p) => [`${fmtEUR(val)}  ·  ${p.payload.count} Auto(s)  ·  Ø ${fmtNum(p.payload.avgKm)} km`, "Ø Preis"]} />
                  <Bar dataKey="avg" radius={[0, 4, 4, 0]}>
                    {groups.map((g, i) => <Cell key={i} fill={tagColor(groupBy, g.group) === T.muted ? COLORS[i % COLORS.length] : tagColor(groupBy, g.group)} />)}
                  </Bar>
                </BarChart>
              </ResponsiveContainer>
            </div>
            <div style={S.groupTable}>
              {groups.map((g) => (
                <div key={g.group} style={S.groupRow}>
                  <span style={{ ...S.groupTag, color: tagColor(groupBy, g.group) }}>{g.group}</span>
                  <span style={S.groupCount}>{g.count}×</span>
                  <span style={S.groupAvg}>Ø {fmtEUR(g.avg)}</span>
                  <span style={S.groupKm}>Ø {fmtNum(g.avgKm)} km</span>
                </div>
              ))}
            </div>
          </>
        )}

        {/* Trefferliste */}
        {activeFilterCount > 0 && (
          <div style={S.resultList}>
            {filtered.map((v) => (
              <div key={v.id} style={S.resultRow}>
                <span style={S.resultTitle}>{v.title}</span>
                <span style={S.resultTags}>
                  {v.repairScope && <em style={{ ...S.miniTag, color: tagColor("repairScope", v.repairScope) }}>Rep. {v.repairScope}</em>}
                  {v.currentIssueStatus && <em style={{ ...S.miniTag, color: tagColor("currentIssueStatus", v.currentIssueStatus) }}>Mängel {v.currentIssueStatus}</em>}
                  <em style={S.resultPrice}>{fmtEUR(lastPrice(v))}</em>
                </span>
              </div>
            ))}
          </div>
        )}
      </section>

      {/* Laufzeiten */}
      {list.length > 0 && (
        <section style={S.panel}>
          <div style={S.panelTitle}><CalendarClock size={15} /> Laufzeiten der Inserate</div>
          <p style={S.hint}>
            Wie lange steht ein Auto schon drin, wann wurde der Preis gesenkt, und wann war es weg.
            Schließe ein Inserat unten am Fahrzeug ab, sobald es aus den Suchergebnissen verschwunden ist.
          </p>
          <div style={S.laufTable}>
            <div style={{ ...S.laufRow, ...S.laufHead }}>
              <span style={S.laufTitle}>Fahrzeug</span>
              <span style={S.laufCell}>seit</span>
              <span style={S.laufCell}>Laufzeit</span>
              <span style={S.laufCell}>Senkungen</span>
              <span style={S.laufCell}>gesenkt um</span>
              <span style={S.laufCell}>Stand</span>
            </div>
            {laufzeiten.map((r) => (
              <div key={r.id} style={S.laufRow}>
                <span style={S.laufTitle} title={r.title}>{r.title}</span>
                <span style={S.laufCell}>{r.seit ? fmtDate(r.seit) : "—"}</span>
                <span style={S.laufCell}>{laufzeitText(r.tage)}</span>
                <span style={S.laufCell}>{r.anzahl > 0 ? `${r.anzahl}×` : "—"}</span>
                <span style={S.laufCell}>{r.summe > 0 ? fmtEUR(r.summe) : "—"}</span>
                <span style={{ ...S.laufCell, color: tagColor("listingStatus", r.status), fontWeight: 700 }}>
                  {r.status}{r.status !== "Aktiv" && r.closedDate ? ` ${fmtDate(r.closedDate)}` : ""}
                </span>
              </div>
            ))}
          </div>
          <div style={S.laufSummary}>
            {laufSchnitt.abgeschlossen > 0
              ? `${laufSchnitt.abgeschlossen} abgeschlossen · Ø Laufzeit ${laufzeitText(laufSchnitt.schnitt)}`
              : "Noch kein Inserat abgeschlossen — sobald du das erste abschließt, erscheint hier die durchschnittliche Laufzeit."}
          </div>
        </section>
      )}

      </>)}

      {tab === "verzeichnis" && (
      <section style={S.panel}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between" }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8 }}><Car size={15} /> Verzeichnis · {list.length}</span>
          {list.length > 0 && (
            <span style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
              <button style={S.exportBtn} onClick={() => setOpenRows(alleOffen ? {} : Object.fromEntries(list.map((v) => [v.id, true])))}>
                {alleOffen ? "Alle zuklappen" : "Alle aufklappen"}
              </button>
              <button style={S.exportBtn} onClick={exportGarage} title="Alle Fahrzeuge als JSON-Datei sichern — wiederherstellen über das Import-Feld">
                <Download size={13} /> Exportieren
              </button>
            </span>
          )}
        </div>
        {!loaded ? (<div style={S.empty}><span>Lade Daten…</span></div>)
          : list.length === 0 ? (<div style={S.empty}><span>Noch keine Fahrzeuge. Wechsle zu „Erfassen &amp; Analysieren" und füge dort deinen ersten JSON-Block ein.</span></div>)
            : (
              <>
                <div className="pw-dirhead" style={S.listHeadLabels}>
                  <span>Fahrzeug</span><span>Preis</span><span>Veränderung</span>
                  <span>Kilometer</span><span>Erstzul.</span><span>Reparatur</span><span />
                </div>
                <div style={S.listWrap}>
                  {list.map((v) => (
                    <VehicleCard key={v.id} v={v} accent={colorFor(v.id)}
                      open={!!openRows[v.id]} onToggle={toggleRow}
                      addFor={addFor} addDate={addDate} addPrice={addPrice} setAddDate={setAddDate} setAddPrice={setAddPrice}
                      openAdd={openAdd} cancelAdd={() => setAddFor(null)} addPoint={addPoint} deletePoint={deletePoint} removeVehicle={removeVehicle}
                      closeFor={closeFor} closeStatus={closeStatus} closeDate={closeDate} setCloseStatus={setCloseStatus} setCloseDate={setCloseDate}
                      openClose={openClose} cancelClose={() => setCloseFor(null)} confirmClose={confirmClose} reopen={reopen} />
                  ))}
                </div>
              </>
            )}
      </section>
      )}

      <footer style={S.footer}>
        Die Daten aus dem Inserat liefert die KI, die Beurteilung der Fotos machst du selbst.
        Alles bleibt lokal in diesem Browser. Mit „Exportieren" im Verzeichnis sicherst du den Bestand
        als JSON-Datei — zum Wiederherstellen den Dateiinhalt einfach ins Import-Feld einfügen.
      </footer>
    </div>
  );
}

/* --------------------------- Karte ------------------------------- */

function VehicleCard({ v, accent, open, onToggle, addFor, addDate, addPrice, setAddDate, setAddPrice, openAdd, cancelAdd, addPoint, deletePoint, removeVehicle,
  closeFor, closeStatus, closeDate, setCloseStatus, setCloseDate, openClose, cancelClose, confirmClose, reopen }) {
  const S = styles;
  const h = v.priceHistory || [];
  const last = h[h.length - 1]?.price;
  const first = h[0]?.price;
  const diff = first != null && last != null ? last - first : 0;
  const dir = diff < 0 ? "down" : diff > 0 ? "up" : "flat";
  const dirColor = dir === "down" ? T.good : dir === "up" ? T.bad : T.muted;
  const isDealer = /h(ä|ae)ndl|dealer|autohaus|gewerb/i.test(`${v.sellerType} ${v.dealerName}`);
  const geschlossen = v.listingStatus && v.listingStatus !== "Aktiv";

  const chips = [erstzulassung(v), v.mileage != null ? `${fmtNum(v.mileage)} km` : null, v.power, v.displacement, v.fuel, v.gearbox, v.drivetrain, v.category, v.condition, v.owners ? `${v.owners} Vorbesitzer` : null, v.color].filter(Boolean);
  const idChips = [v.model, v.series, v.trimline].filter(Boolean);

  return (
    <div style={{ ...S.listRow, borderLeftColor: accent, opacity: geschlossen ? 0.72 : 1 }}>
      <div className="pw-dirrow" style={S.listHead}>
        <button style={S.listToggle} onClick={() => onToggle(v.id)} aria-expanded={open}
          title={open ? "Zuklappen" : "Alle Angaben anzeigen"}>
          <span style={{ ...S.chev, transform: open ? "rotate(90deg)" : "none" }}><ChevronRight size={14} /></span>
          <span style={{ minWidth: 0 }}>
            <span style={S.listTitle} title={v.title}>{v.title}</span>
            <span style={S.listSub}>{[v.make, v.model].filter(Boolean).join(" ")}{geschlossen ? ` · ${v.listingStatus}` : ""}</span>
          </span>
        </button>
        <span className="pw-metrics">
          <Metric label="Preis" value={fmtEUR(last)} stark />
          <Metric label="Veränderung" value={diff === 0 ? "unverändert" : `${diff > 0 ? "+" : ""}${fmtEUR(diff)}`} color={dirColor} />
          <Metric label="Kilometer" value={v.mileage != null ? `${fmtNum(v.mileage)} km` : "—"} />
          <Metric label="Erstzul." value={erstzulassung(v) || "—"} />
          <Metric label="Reparatur" value={v.repairScope || "—"} color={tagColor("repairScope", v.repairScope)} />
        </span>
        <button style={S.iconBtn} title="Fahrzeug entfernen" onClick={() => removeVehicle(v.id)}><Trash2 size={14} /></button>
      </div>
      {!open ? null : (
      <div style={S.cardBody}>
        {v.subtitle && <div style={S.cardSub}>{v.subtitle}</div>}

        {(v.make || idChips.length) && (
          <div style={S.idRow}>
            {v.make && <span style={S.makeTag}>{v.make}</span>}
            {idChips.map((c, i) => <span key={i} style={S.idChip}>{c}</span>)}
          </div>
        )}

        {/* Analyse-Begriffe */}
        <div style={S.tagRow}>
          {v.photoDamage && <StatusTag field="photoDamage" value={`Fotos: ${v.photoDamage}`} raw={v.photoDamage} icon={<Camera size={11} />} />}
          {v.listingPrep && <StatusTag field="listingPrep" value={v.listingPrep} raw={v.listingPrep} />}
          {v.accidentStatus && <StatusTag field="accidentStatus" value={v.accidentStatus} icon={<ShieldCheck size={11} />} />}
          {v.currentIssueStatus && <StatusTag field="currentIssueStatus" value={`Mängel: ${v.currentIssueStatus}`} raw={v.currentIssueStatus} />}
          {v.repairScope && <StatusTag field="repairScope" value={`Rep.: ${v.repairScope}${v.repairCount != null ? ` (${v.repairCount})` : ""}`} raw={v.repairScope} icon={<Wrench size={11} />} />}
          {v.previousDamageStatus && <StatusTag field="previousDamageStatus" value={`Vorschäden: ${v.previousDamageStatus}`} raw={v.previousDamageStatus} />}
        </div>

        {chips.length > 0 && <div style={S.metaRow}>{chips.map((c, i) => <span key={i} style={S.chip}>{c}</span>)}</div>}

        {(v.location || v.hu) && (
          <div style={S.subMeta}>
            {v.location && <span><MapPin size={11} style={{ verticalAlign: -1 }} /> {v.location}</span>}
            {v.hu && <span>HU {v.hu}</span>}
          </div>
        )}

        <div style={S.seller}>
          {isDealer ? <Store size={13} color={T.muted} /> : <User size={13} color={T.muted} />}
          <span>{isDealer ? (v.dealerName || "Händler") : (v.sellerType || "Anbieter unbekannt")}
            {v.stars && <span style={S.stars}> <Star size={11} fill={T.accent} color={T.accent} style={{ verticalAlign: -1 }} /> {v.stars}</span>}</span>
          {isDealer && v.address && <span style={S.addr}>· {v.address}</span>}
        </div>

        <div style={S.damageBox}>
          <DamageLine label="Aktuell" value={v.damageCurrent} bad />
          <DamageLine label="Früher" value={v.damagePrevious} />
          <DamageLine label="Repariert" value={v.damageRepaired} good icon />
        </div>

        {v.note && <div style={S.note}>{v.note}</div>}

        <div style={S.priceRow}>
          <span style={S.price}>{fmtEUR(last)}</span>
          <span style={{ ...S.deltaPill, color: dirColor, borderColor: dirColor + "55" }}>
            {dir === "down" ? <TrendingDown size={12} /> : dir === "up" ? <TrendingUp size={12} /> : <Minus size={12} />}
            {diff === 0 ? "unverändert" : `${diff > 0 ? "+" : ""}${fmtEUR(diff)}`}
          </span>
        </div>

        <div style={S.histHead}>
          <span>Preisverlauf · {h.length}</span>
          {addFor === v.id ? (
            <div style={S.addRow}>
              <input type="date" value={addDate} onChange={(e) => setAddDate(e.target.value)} style={S.dateInput} />
              <input inputMode="decimal" placeholder="Preis €" value={addPrice} onChange={(e) => setAddPrice(e.target.value)} style={S.priceInput} />
              <button style={S.iconBtnAccent} title="Hinzufügen" onClick={() => addPoint(v)}><Check size={15} /></button>
              <button style={S.iconBtn} title="Abbrechen" onClick={cancelAdd}><X size={15} /></button>
            </div>
          ) : (<button style={S.addBtn} onClick={() => openAdd(v)}><Plus size={13} /> Preis-Update</button>)}
        </div>

        {h.length > 0 && (
          <div style={S.histList}>
            {h.slice().reverse().map((p) => (
              <div key={p.date} style={S.histItem}>
                <span style={S.histDate}>{fmtDate(p.date)}</span>
                <span style={S.histPrice}>{fmtEUR(p.price)}</span>
                <button style={S.histDel} title="Punkt löschen" onClick={() => deletePoint(v, p.date)}><X size={12} /></button>
              </div>
            ))}
          </div>
        )}

        <div style={S.lifeBox}>
          <div style={S.lifeRow}>
            <span style={S.lifeLabel}><Clock size={11} style={{ verticalAlign: -1 }} /> Laufzeit</span>
            <span style={S.lifeValue}>
              {laufzeitText(laufzeitTage(v))}
              {inseriertSeit(v) && <span style={S.lifeSince}> seit {fmtDate(inseriertSeit(v))}</span>}
            </span>
          </div>
          {geschlossen ? (
            <div style={S.lifeRow}>
              <span style={{ ...S.lifeLabel, color: tagColor("listingStatus", v.listingStatus) }}>{v.listingStatus}</span>
              <span style={S.lifeValue}>
                {v.closedDate ? fmtDate(v.closedDate) : "—"}
                <button style={S.reopenBtn} onClick={() => reopen(v)} title="Inserat wieder als aktiv führen"><RotateCcw size={11} /> öffnen</button>
              </span>
            </div>
          ) : closeFor === v.id ? (
            <div style={S.closeForm}>
              <div style={S.closeOptions}>
                {STATUS_OPTS.filter((s) => s !== "Aktiv").map((s) => (
                  <button key={s} onClick={() => setCloseStatus(s)} style={closeStatus === s ? S.askOptionOn : S.askOption}>{s}</button>
                ))}
              </div>
              <div style={S.addRow}>
                <input type="date" value={closeDate} onChange={(e) => setCloseDate(e.target.value)} style={S.dateInput} />
                <button style={S.iconBtnAccent} title="Abschließen" onClick={() => confirmClose(v)}><Check size={15} /></button>
                <button style={S.iconBtn} title="Abbrechen" onClick={cancelClose}><X size={15} /></button>
              </div>
            </div>
          ) : (
            <button style={S.closeBtn} onClick={() => openClose(v)}
              title="Festhalten, wann das Inserat verschwunden oder das Fahrzeug verkauft war">
              <Archive size={12} /> Inserat abschließen
            </button>
          )}
        </div>

        {v.url && <a href={v.url} target="_blank" rel="noreferrer" style={S.link}>Inserat öffnen ↗</a>}
      </div>
      )}
    </div>
  );
}

// Eine Kennzahl in der Verzeichnis-Zeile.
function Metric({ label, value, color, stark }) {
  return (
    <span style={styles.metric}>
      <span className="pw-mlabel" style={styles.metricLabel}>{label}</span>
      <span style={{ ...(stark ? styles.metricStark : styles.metricValue), ...(color ? { color } : null) }}>{value}</span>
    </span>
  );
}

function StatusTag({ field, value, raw, icon }) {
  const col = tagColor(field, raw || value);
  return <span style={{ ...styles.statusTag, color: col, borderColor: col + "55" }}>{icon}{value}</span>;
}
function DamageLine({ label, value, bad, good, icon }) {
  const val = value && value.trim() ? value : "—";
  const has = value && value.trim() && !/keine hinweise|keine angabe|^—$/i.test(value.trim());
  const col = has ? (bad ? T.bad : good ? T.good : T.text) : T.muted;
  return (
    <div style={styles.damageLine}>
      <span style={styles.damageLabel}>{icon && <Wrench size={10} style={{ verticalAlign: -1 }} />} {label}</span>
      <span style={{ ...styles.damageVal, color: col }}>{val}</span>
    </div>
  );
}
function ChoiceQuestion({ frage, options, hilfe, value, onChange }) {
  return (
    <div style={styles.askItem}>
      <div style={styles.askFrage}>{frage}</div>
      <div style={styles.askOptions}>
        {options.map((o) => (
          <button key={o} onClick={() => onChange(o)} title={hilfe?.[o] || ""}
            style={value === o ? styles.askOptionOn : styles.askOption}>{o}</button>
        ))}
      </div>
      {value && hilfe?.[value] && <div style={styles.askHilfe}>{hilfe[value]}</div>}
    </div>
  );
}
function SelectFilter({ label, value, onChange, options }) {
  return (
    <div style={styles.rangeField}>
      <span style={styles.fieldLabel}>{label}</span>
      <select value={value} onChange={(e) => onChange(e.target.value)} style={styles.select}>
        <option value="">Alle</option>
        {options.map((o) => <option key={o} value={o}>{o}</option>)}
      </select>
    </div>
  );
}
function Stat({ label, value, accent }) {
  return (<div style={styles.stat}><div style={{ ...styles.statValue, color: accent || styles.statValue.color }}>{value}</div><div style={styles.statLabel}>{label}</div></div>);
}

/* ------------------------------ Stil ----------------------------- */

const globalCss = `
  * { box-sizing: border-box; }
  ::selection { background: ${T.accent}; color: ${T.bg}; }
  button { cursor: pointer; font-family: inherit; transition: filter .15s, background .15s, border-color .15s; }
  button:disabled { opacity: .4; cursor: not-allowed; }
  button:hover:not(:disabled) { filter: brightness(1.12); }
  input, textarea, select { outline: none; }
  input:focus, textarea:focus, select:focus { border-color: ${T.accent} !important; }
  select { -webkit-appearance: none; appearance: none; }
  a { color: ${T.accent}; }
  @media (max-width: 620px) { .pw-header { flex-direction: column; align-items: flex-start !important; gap: 16px; } }

  /* Verzeichnis: auf breiten Schirmen eine Tabelle, auf schmalen zwei Zeilen */
  .pw-dirhead, .pw-dirrow {
    display: grid;
    grid-template-columns: minmax(150px, 2.4fr) 104px 108px 104px 76px 104px 32px;
