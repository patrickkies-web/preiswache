// Leer bleibt leer: ein erfundener Wert wäre schlimmer als eine Lücke.
function normalizeChoice(value, feld, options) {
  const raw = String(value == null ? "" : value).trim();
  if (!raw) return "";
  const key = raw.toLowerCase();
  const treffer = options.find((o) => o.toLowerCase() === key);
  if (treffer) return treffer;
  const syn = CHOICE_SYNONYME[feld] || {};
  const stichwort = Object.keys(syn).sort((a, b) => b.length - a.length).find((s) => key.includes(s));
  if (stichwort) return syn[stichwort];
  const teil = options.find((o) => key.includes(o.toLowerCase()));
  return teil || "";
}

// "3" -> "03", "März" -> "03"; alles andere fällt weg.
const MONATE = ["januar", "februar", "märz", "april", "mai", "juni",
  "juli", "august", "september", "oktober", "november", "dezember"];
function normalizeMonth(value) {
  const raw = String(value == null ? "" : value).trim();
  if (!raw) return "";
  const zahl = raw.match(/^(\d{1,2})/);
  if (zahl) { const n = parseInt(zahl[1], 10); return n >= 1 && n <= 12 ? String(n).padStart(2, "0") : ""; }
  const i = MONATE.findIndex((m) => raw.toLowerCase().startsWith(m.slice(0, 3)));
  return i >= 0 ? String(i + 1).padStart(2, "0") : "";
}

