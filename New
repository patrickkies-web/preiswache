/* Der Link zum Inserat, änderbar direkt in der Fahrzeugkarte.
   Inserate werden neu eingestellt und Adressen laufen ins Leere — bisher ließ
   sich der Link nur im Prüfbereich ändern, in den ein fertig durchgesehenes
   Fahrzeug gar nicht mehr kommt. Gespeichert wird beim Verlassen des Feldes
   oder mit der Eingabetaste, und zwar die herausgeschnittene Adresse. */
function Linkfeld({ v, setzeFeld, trenner }) {
  const S = styles;
  const [text, setText] = useState(v.url || "");
  const [offen, setOffen] = useState(false);      // ungespeicherte Eingabe
  useEffect(() => { if (!offen) setText(v.url || ""); }, [v.url, offen]);

  const sichern = () => {
    const roh = text.trim();
    if (!roh) { setOffen(false); setText(""); if (v.url) setzeFeld(v.id, "url", ""); return; }
    const neu = normalizeUrl(roh);
    // Steckt keine Adresse darin, bleibt das Getippte stehen und der Hinweis
    // darunter erklärt warum — kommentarlos zurückspringen wäre ärgerlich.
    if (!neu) return;
    setOffen(false);
    setText(neu);
    if (neu !== (v.url || "")) setzeFeld(v.id, "url", neu);
  };

  const leer = !text.trim();
  const unbrauchbar = !leer && !istLink(text);
  return (
    <div style={trenner ? { ...S.linkBox, ...S.linkTrenner } : S.linkBox}>
      <div style={S.linkZeile}>
        <Link2 size={12} color={T.muted} />
        <input value={text} placeholder="mobile.de/…" style={S.linkInput}
          inputMode="url" spellCheck={false}
          onChange={(e) => { setOffen(true); setText(e.target.value); }}
          onBlur={sichern}
          onKeyDown={(e) => { if (e.key === "Enter") e.target.blur(); }} />
        {istLink(v.url) && (
          <a href={normalizeUrl(v.url)} target="_blank" rel="noreferrer" style={S.linkOeffnen}>öffnen ↗</a>
        )}
      </div>
      {unbrauchbar
        ? <div style={S.askHilfe}>Darin steckt keine Adresse — so wird nichts gespeichert.</div>
        : leer
          ? <div style={S.askHilfe}>Ohne Link findest du das Inserat später nicht wieder.</div>
          : offen
            ? <div style={S.askHilfe}>Gespeichert wird beim Verlassen des Feldes: {normalizeUrl(text)}</div>
            : null}
    </div>
  );
}

