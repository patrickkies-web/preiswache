function offenePunkte(v) {
  const p = [];
  // Beurteilungen: einmal bestätigt, ist die Sache erledigt — auch ein
  // stehengelassenes "Unbekannt" ist dann eine Entscheidung.
  if (!v.geprueft) {
    p.push("Unfall- und Mängelstatus noch nicht bestätigt");
    if (v.previousDamageStatus === "Unbekannt") p.push("Frühere Schäden unbekannt");
    if (v.repairScope === "Unbekannt") p.push("Reparaturumfang unbekannt");
  }
  // Fehlende Angaben bleiben offen, bis sie da sind. Ein Haken hilft hier nicht.
  if (!v.photoDamage) p.push("Frage zu den Fotos offen");
  if (!v.listingPrep) p.push("Frage zur Aufbereitung offen");
  if (!istLink(v.url)) p.push("Kein Link zum Inserat");
  if (v.mileage == null) p.push("Kilometerstand fehlt — fällt aus der Preisrechnung");
  if (!v.year) p.push("Erstzulassung fehlt — fällt aus der Preisrechnung");
  return p;
}

/* --- Lebenslauf des Inserats --- */

const STATUS_OPTS = ["Aktiv", "Verkauft", "Verschwunden"];

const TAG_MS = 24 * 60 * 60 * 1000;
const parseISO = (s) => (s ? new Date(s + "T00:00:00") : null);
function tageZwischen(von, bis) {
  const a = parseISO(von), b = parseISO(bis);
  if (!a || !b) return null;
  return Math.max(0, Math.round((b - a) / TAG_MS));
}
// Erster bekannter Tag des Inserats: gesetzter Wert, sonst der erste Preis-Punkt.
const inseriertSeit = (v) => v.listedSince || v.priceHistory?.[0]?.date || "";
// Laufzeit bis zum Abschluss, bei laufenden Inseraten bis heute.
function laufzeitTage(v) {
  const start = inseriertSeit(v);
  if (!start) return null;
  const ende = v.listingStatus && v.listingStatus !== "Aktiv" && v.closedDate ? v.closedDate : todayISO();
  return tageZwischen(start, ende);
}
function laufzeitText(tage) {
  if (tage == null) return "—";
  if (tage < 14) return `${tage} ${tage === 1 ? "Tag" : "Tage"}`;
  if (tage < 70) return `${Math.round(tage / 7)} Wochen`;
  return `${Math.round((tage / 365) * 12)} Monate`;
}
const median = (zahlen) => {
  if (!zahlen.length) return null;
  const s = [...zahlen].sort((a, b) => a - b);
  const m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : Math.round((s[m - 1] + s[m]) / 2);
};
const mittel = (zahlen) => (zahlen.length ? zahlen.reduce((a, b) => a + b, 0) / zahlen.length : null);

