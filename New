      </header>

      <nav style={S.tabs}>
        <button style={tab === "erfassen" ? S.tabOn : S.tabOff} onClick={() => setTab("erfassen")}>
          <Upload size={14} /> Erfassen
        </button>
        <button style={tab === "uebersicht" ? S.tabOn : S.tabOff} onClick={() => setTab("uebersicht")}>
          <TrendingDown size={14} /> Übersicht
          {uebersicht && <span style={tab === "uebersicht" ? S.tabCountOn : S.tabCount}>{uebersicht.anzahl}</span>}
        </button>
        <button style={tab === "verzeichnis" ? S.tabOn : S.tabOff} onClick={() => setTab("verzeichnis")}>
