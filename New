                    {[erstzulassung(v), v.mileage != null ? `${fmtNum(v.mileage)} km` : null, v.repairScope ? `Rep. ${v.repairScope}` : null,
                      v.priceHistory.length ? fmtEUR(v.priceHistory[v.priceHistory.length - 1].price) : "kein Preis"].filter(Boolean).join(" · ")}
                    {vehicles[v.id] && <span style={S.updTag}> aktualisiert</span>}
                  </span>
                </div>
                {previewDubletten[v.id] && <DublettenWarnung neu={v} treffer={previewDubletten[v.id]} />}
                <div style={S.askBlock}>
                  <div style={S.askIntro}>Deine Einschätzung — das kann dir keine KI abnehmen:</div>
                  <FotoHinweis v={v} />
                  <div style={S.askItem}>
                    <button
                      onClick={() => setAnswer(v.id, "showcase",
                        answers[v.id]?.showcase === "Vorzeigefahrzeug" ? "Normal" : "Vorzeigefahrzeug")}
                      style={answers[v.id]?.showcase === "Vorzeigefahrzeug" ? S.sternAn : S.sternAus}>
                      <Star size={14} fill={answers[v.id]?.showcase === "Vorzeigefahrzeug" ? T.bg : "none"} />
                      {SHOWCASE_FRAGE}
                    </button>
                    <div style={S.askHilfe}>{SHOWCASE_HILFE}</div>
                  </div>
                  <ChoiceQuestion frage={PHOTO_DAMAGE_FRAGE} options={PHOTO_DAMAGE_OPTS} hilfe={PHOTO_DAMAGE_HILFE}
                    value={answers[v.id]?.photoDamage || ""} onChange={(w) => setAnswer(v.id, "photoDamage", w)} />
                  <ChoiceQuestion frage={LISTING_PREP_FRAGE} options={LISTING_PREP_OPTS} hilfe={LISTING_PREP_HILFE}
                    value={answers[v.id]?.listingPrep || ""} onChange={(w) => setAnswer(v.id, "listingPrep", w)} />
                  <div style={S.askItem}>
                    <div style={S.askFrage}>Link zum Inserat</div>
                    <input value={answers[v.id]?.url || ""} onChange={(e) => setAnswer(v.id, "url", e.target.value)}
                      placeholder="mobile.de/…" style={S.askInput} inputMode="url" spellCheck={false} />
                    <div style={S.askHilfe}>
                      {!istLink(answers[v.id]?.url)
                        ? "Pflichtangabe — ohne Link findest du das Inserat später nicht wieder."
                        : v.url && normalizeUrl(answers[v.id].url) === normalizeUrl(v.url)
                          ? "Aus dem JSON übernommen — prüfen und bei Bedarf überschreiben."
                          : "Von hier kommst du später mit einem Klick zurück ins Inserat."}
                    </div>
                  </div>
                </div>
              </div>
            ))}
            <div style={S.row}>
              <button style={S.primaryBtn} onClick={confirmImport} disabled={!alleBeantwortet}><Check size={16} /> Importieren</button>
              <button style={S.ghostBtn} onClick={() => setPreview(null)}><X size={15} /> Abbrechen</button>
              {!alleBeantwortet && <span style={S.askHint}>Beide Fragen beantworten und den Link einfügen, dann geht es weiter.</span>}
            </div>
          </div>
        )}
      </section>

      {/* Mögliche Doppel-Inserate im Bestand */}
      {dublettenGruppen.length > 0 && (
        <section style={{ ...S.panel, borderColor: T.accent + "55" }}>
          <div style={{ ...S.panelTitle, color: T.accent }}>
            <AlertTriangle size={15} /> Mögliche Doppel-Inserate · {dublettenGruppen.length}
          </div>
          <p style={S.hint}>
            Bei diesen Fahrzeugen stimmen Marke, Modell, Farbe, Erstzulassung und Ort überein.
            Entweder steht dasselbe Auto zweimal im Bestand — oder es wurde vom Verkäufer neu eingestellt,
            um die Standzeit zurückzusetzen.
          </p>
          {dublettenGruppen.map((gruppe, i) => (
            <div key={i} style={S.dublettePaar}>
              <div style={S.dubletteKopf}>
                {[gruppe[0].make, gruppe[0].model, gruppe[0].color, erstzulassung(gruppe[0]), gruppe[0].location].filter(Boolean).join(" · ")}
              </div>
              {gruppe.map((v, n) => (
                <div key={v.id} style={S.dubletteZeile}>
                  <span style={S.dubletteZiffer}>{n + 1}</span>
                  <span style={S.dubletteTitelKlein} title={v.title}>{v.title || v.id}</span>
                  <span style={S.dubletteAngabe}>{inseriertSeit(v) ? fmtDate(inseriertSeit(v)) : "—"}</span>
                  <span style={S.dubletteAngabe}>{v.mileage != null ? `${fmtNum(v.mileage)} km` : "—"}</span>
                  <span style={S.dubletteAngabe}>{fmtEUR(lastPrice(v))}</span>
                  <span style={{ ...S.dubletteAngabe, color: tagColor("listingStatus", v.listingStatus || "Aktiv"), fontWeight: 700 }}>
                    {v.listingStatus || "Aktiv"}
                  </span>
                </div>
              ))}
              {gruppe.length === 2 && dublettenIndizien(gruppe[1], gruppe[0]).length > 0 && (
                <ul style={S.dubletteListe}>
                  {dublettenIndizien(gruppe[1], gruppe[0]).map((x, n) => <li key={n}>{x}</li>)}
                </ul>
              )}
              {gruppe.some((v) => v.listingStatus && v.listingStatus !== "Aktiv") && gruppe.some((v) => !v.listingStatus || v.listingStatus === "Aktiv") && (
                <div style={S.dubletteSchluss}>
                  Eines ist abgeschlossen, eines läuft — das spricht für eine Neueinstellung.
                  Echte Standzeit ab {fmtDate(inseriertSeit(gruppe[0]))}: <b style={{ color: T.text }}>{laufzeitText(tageZwischen(inseriertSeit(gruppe[0]), todayISO()))}</b>.
                </div>
              )}
            </div>
          ))}
        </section>
      )}

      {/* Preisverlauf */}
      <section style={S.panel}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between", flexWrap: "wrap", gap: 10 }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8 }}><TrendingDown size={15} /> Preisverlauf aller Fahrzeuge</span>
          <span style={S.toggleGroup}>
            <button style={chartMode === "datum" ? S.toggleOn : S.toggleOff} onClick={() => setChartMode("datum")}>Nach Datum</button>
            <button style={chartMode === "tage" ? S.toggleOn : S.toggleOff} onClick={() => setChartMode("tage")}
              title="Alle Inserate starten bei Tag 0 — so lassen sich die Verläufe direkt übereinanderlegen">Tage seit Inserat</button>
          </span>
        </div>
        {chart.rows.length === 0 ? (
          <div style={S.empty}><Car size={30} color={T.line} /><span>Noch keine Preisdaten. Importiere ein Fahrzeug oder trage über „+ Preis-Update" einen Preis mit Datum ein.</span></div>
        ) : (
          <div style={{ width: "100%", height: 320 }}>
            <ResponsiveContainer>
              <LineChart data={chart.rows} margin={{ top: 8, right: 12, left: 4, bottom: 4 }}>
                <CartesianGrid stroke={T.line} strokeDasharray="2 4" />
                <XAxis dataKey={chart.xKey} type={chartMode === "tage" ? "number" : "category"}
                  domain={chartMode === "tage" ? [0, "dataMax"] : undefined}
                  tickFormatter={chartMode === "tage" ? (t) => `${t} T` : fmtDate}
                  stroke={T.muted} tick={{ fontSize: 11, fill: T.muted }} />
                <YAxis tickFormatter={(v) => (v >= 1000 ? `${Math.round(v / 1000)}k` : v)} stroke={T.muted} tick={{ fontSize: 11, fill: T.muted }} width={44} />
                <Tooltip contentStyle={{ background: T.surface2, border: `1px solid ${T.line}`, borderRadius: 8, fontSize: 12, color: T.text }} labelFormatter={(d) => (chartMode === "tage" ? `Tag ${d}` : fmtDate(d))} formatter={(val, key) => [fmtEUR(val), vehicles[key]?.title?.slice(0, 28) || key]} />
                {chart.series.map((v) => (<Line key={v.id} type="monotone" dataKey={v.id} name={v.id} stroke={colorFor(v.id)} strokeWidth={2} connectNulls dot={{ r: 3 }} activeDot={{ r: 5 }} />))}
              </LineChart>
            </ResponsiveContainer>
          </div>
        )}
      </section>

      </>)}

      {(tab === "analyseA" || tab === "analyseB") && (<>

      {/* Analyse & Suche */}
      <section style={{ ...S.panel, borderTop: `3px solid ${AUSWAHL_FARBE[aktiv]}` }}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between", flexWrap: "wrap", gap: 10 }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8, color: AUSWAHL_FARBE[aktiv] }}>
            <Search size={15} /> Filter für {AUSWAHL_NAME[aktiv]}
