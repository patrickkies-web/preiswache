/* --- Überlebensrechnung nach Kaplan-Meier ---------------------------
   Die Frage "wie viel ist nach N Tagen weg?" naiv zu beantworten — Abgänge
   durch alle — geht aus zwei Gründen schief:

   Zensierung. Ein Inserat, das seit drei Tagen läuft, ist nicht "nicht
   verkauft". Es ist "bis hierher noch da". Es in den Nenner zu werfen,
   drückt jede Quote nach unten, ohne dass der Preis daran schuld wäre.

   Verzögerter Eintritt. Ein Inserat, das du erst nach dreißig Tagen
   gefunden hast, konnte in diesen dreißig Tagen gar nicht als Abgang
   auffallen — dass es überhaupt in deiner Liste steht, heißt ja, dass es
   so lange überlebt hat. Zählt man es von Tag null an mit, sieht die frühe
   Zeit sicherer aus, als sie ist.

   Kaplan-Meier löst beides: zu jedem Zeitpunkt zählt nur, wer da gerade
   wirklich im Feld steht und beobachtet wird.

   faelle: [{ eintritt, austritt, ereignis }]
     eintritt  — ab welchem Tag der Standzeit du hinsiehst
     austritt  — Tag, an dem es verschwand, sonst der heutige Stand
     ereignis  — true, wenn es tatsächlich verschwunden ist  */
function ueberlebenskurve(faelle) {
  const zeiten = [...new Set(faelle.filter((f) => f.ereignis).map((f) => f.austritt))]
    .sort((a, b) => a - b);
  let s = 1;
  const kurve = [{ tag: 0, s: 1, risiko: faelle.filter((f) => f.eintritt <= 0).length, abgang: 0 }];
  zeiten.forEach((t) => {
    const risiko = faelle.filter((f) => f.eintritt < t && f.austritt >= t).length;
    const abgang = faelle.filter((f) => f.ereignis && f.austritt === t).length;
    if (risiko > 0) s *= 1 - abgang / risiko;
    kurve.push({ tag: t, s, risiko, abgang });
  });
  return kurve;
}
// Anteil, der bis zu diesem Tag weg ist.
function abgangBis(kurve, tag) {
  let s = 1;
  for (const k of kurve) { if (k.tag <= tag) s = k.s; else break; }
  return 1 - s;
}
// Wie viele stehen an diesem Tag überhaupt noch unter Beobachtung?
function risikoBei(faelle, tag) {
  return faelle.filter((f) => f.eintritt < tag && f.austritt >= tag).length;
}
// Halbwertszeit: der Tag, an dem die Hälfte weg ist. Wird sie nie erreicht,
// bleibt die Antwort leer — das ist ehrlicher als eine hochgerechnete Zahl.
function halbwertszeit(kurve) {
  const t = kurve.find((k) => k.s <= 0.5);
  return t ? t.tag : null;
}

/* --- Beobachtung je Fahrzeug -------------------------------------------
   Gespeichert werden nur die vier Angaben, die sich nicht ausrechnen
   lassen: firstSeen, lastSeen, disappearedAt und trackingQuality. Alles
   andere — erster Preis, aktueller Preis, jede Änderung, die Dauer jeder
   Preisstufe, Standzeit und Veränderung — wird aus dem Preisverlauf
   abgeleitet. Doppelt speichern hieße zwei Wahrheiten pflegen, und die
   laufen früher oder später auseinander.

   Der Preisverlauf selbst wird nie überschrieben: jeder Punkt bleibt mit
   seinem Datum stehen, hinzugefügt wird nur hinten.

   trackingQuality sagt, ob die Beobachtung den Anfang des Inserats
   mitbekommen hat:
     full   — erstmals gesehen, als das Inserat frisch war
     legacy — das Inserat lief schon, als es in die App kam
   Bei "legacy" fehlt der Anfang: frühe Senkungen sind unsichtbar, und die
   Standzeit ist länger als das, was hier beobachtet wurde. */
const verschwundenAm = (v) => v.disappearedAt || (v.listingStatus && v.listingStatus !== "Aktiv" ? v.closedDate : "") || "";

/* Preisstufen: aufeinanderfolgende gleiche Preise gehören zu EINER Stufe.
   Trägst du dreimal denselben Preis nach, ist das kein dreimaliger
   Preiswechsel, sondern eine Stufe, die drei Beobachtungen lang hielt. */
function preisStufen(v) {
  const h = (v.priceHistory || []).slice().sort((a, b) => a.date.localeCompare(b.date));
  if (!h.length) return [];
  const stufen = [];
  h.forEach((p) => {
    const letzte = stufen[stufen.length - 1];
    if (letzte && letzte.preis === p.price) { letzte.beobachtungen++; return; }
    stufen.push({ preis: p.price, von: p.date, beobachtungen: 1 });
  });
  const weg = verschwundenAm(v);
  stufen.forEach((s, i) => {
    const naechste = stufen[i + 1];
    s.bis = naechste ? naechste.von : (weg || todayISO());
    s.laeuft = !naechste && !weg;
    s.tage = tageZwischen(s.von, s.bis) ?? 0;
    s.vorher = i > 0 ? stufen[i - 1].preis : null;
    s.aenderung = i > 0 ? s.preis - stufen[i - 1].preis : null;
  });
  return stufen;
}

function tracking(v) {
  const stufen = preisStufen(v);
  const weg = verschwundenAm(v);
  const erste = stufen[0] || null;
  const letzte = stufen[stufen.length - 1] || null;
  const firstSeen = v.firstSeen || erste?.von || "";
  // Solange nichts anderes bekannt ist, gilt der letzte Preis-Punkt als
  // letzter Lebenszeichen-Beleg.
  const lastSeen = [v.lastSeen, letzte?.von].filter(Boolean).sort().pop() || "";
  const ende = weg || todayISO();
  const start = inseriertSeit(v);
  const abs = erste && letzte ? letzte.preis - erste.preis : null;
  return {
    stufen,
    initialTrackedPrice: erste ? erste.preis : null,
    currentPrice: letzte ? letzte.preis : null,
    // Der letzte Ask ist erst dann eine eigene Aussage, wenn das Inserat weg ist.
    lastAsk: weg && letzte ? letzte.preis : null,
    firstSeen, lastSeen, disappearedAt: weg,
    offline: !!weg,
    stand: weg ? (v.listingStatus && v.listingStatus !== "Aktiv" ? v.listingStatus : "Verschwunden") : "Aktiv",
    daysTracked: firstSeen ? tageZwischen(firstSeen, ende) : null,
    daysOnline: start ? tageZwischen(start, ende) : null,
    // Wie alt ist das letzte Lebenszeichen? Nur bei laufenden Inseraten eine Frage.
    tageSeitGesehen: !weg && lastSeen ? tageZwischen(lastSeen, todayISO()) : null,
    aenderungen: Math.max(0, stufen.length - 1),
    tageSeitAenderung: letzte ? tageZwischen(letzte.von, ende) : null,
    absolut: abs,
    prozent: abs != null && erste?.preis ? (abs / erste.preis) * 100 : null,
    /* Drei Zustände, nicht zwei: Ohne Inseratsdatum ist schlicht nicht
       bekannt, ob der Anfang dabei war — das ist etwas anderes, als zu
       wissen, dass er fehlte. */
    qualitaet: !v.listedSince ? "unbekannt" : v.trackingQuality === "full" ? "full" : "legacy",
    // Wie viele Tage lief das Inserat schon, bevor die App es gesehen hat?
    blindTage: start && firstSeen ? tageZwischen(start, firstSeen) : null,
  };
}

/* Beim Aufnehmen wird einmal festgehalten, ob der Anfang des Inserats
   dabei war. Zwei Tage Spielraum, weil du selten am selben Tag erfasst,
   an dem der Verkäufer einstellt. */
function trackingGuete(listedSince, firstSeen) {
  if (!listedSince || !firstSeen) return "legacy";
  const d = tageZwischen(listedSince, firstSeen);
  return d != null && d <= 2 ? "full" : "legacy";
}
// Laufzeit bis zum Abschluss, bei laufenden Inseraten bis heute.
function laufzeitTage(v) {
  const start = inseriertSeit(v);
  if (!start) return null;
  const ende = v.listingStatus && v.listingStatus !== "Aktiv" && v.closedDate ? v.closedDate : todayISO();
  return tageZwischen(start, ende);
}
// "nach 6 Tagen" statt "nach 6 Tage" — laufzeitText liefert den Nominativ.
const laufzeitDativ = (tage) => laufzeitText(tage)
  .replace(/(\d+) Tage$/, "$1 Tagen").replace(/(\d+) Monate$/, "$1 Monaten");
function laufzeitText(tage) {
  if (tage == null) return "—";
  if (tage < 14) return `${tage} ${tage === 1 ? "Tag" : "Tage"}`;
  if (tage < 70) return `${Math.round(tage / 7)} Wochen`;
  return `${Math.round((tage / 365) * 12)} Monate`;
}


/* --- Sortierung im Verzeichnis --- */
// "zahl" wird numerisch verglichen, "text" nach deutschem Alphabet.
// Fehlende Angaben landen unabhängig von der Richtung immer am Ende.
const SORT_FELDER = {
  title:       { label: "Fahrzeug", typ: "text", wert: (v) => (v.title || "").trim().toLowerCase() },
  preis:       { label: "Preis", typ: "zahl", wert: (v) => lastPrice(v) },
  delta:       { label: "Veränderung", typ: "zahl", wert: (v) => {
    const h = v.priceHistory || [];
    return h.length > 1 ? h[h.length - 1].price - h[0].price : null;
  } },
  mileage:     { label: "Kilometer", typ: "zahl", wert: (v) => v.mileage },
  ez:          { label: "Erstzulassung", typ: "text", wert: (v) => (v.year ? `${v.year}${v.month || "00"}` : "") },
  location:    { label: "Ort", typ: "text", wert: (v) => (v.location || "").trim().toLowerCase() },
  repairKind: { label: "Reparaturen", typ: "zahl", wert: (v) => {
    const i = REPAIR_KIND_OPTS.indexOf(v.repairKind);
    return i < 0 ? null : i;
  } },
};

const istLeer = (x) => x == null || x === "" || (typeof x === "number" && isNaN(x));

function sortiere(fahrzeuge, feld, richtung) {
  if (!feld || !SORT_FELDER[feld]) return fahrzeuge;
  const def = SORT_FELDER[feld];
  return fahrzeuge.slice().sort((a, b) => {
    const x = def.wert(a), y = def.wert(b);
    if (istLeer(x) && istLeer(y)) return 0;
    if (istLeer(x)) return 1;
    if (istLeer(y)) return -1;
    const c = def.typ === "zahl" ? x - y : String(x).localeCompare(String(y), "de");
    return richtung === "ab" ? -c : c;
  });
}

// Preissenkungen im Verlauf: Anzahl und Gesamtbetrag.
function senkungen(v) {
  const h = v.priceHistory || [];
  let anzahl = 0, summe = 0;
  for (let i = 1; i < h.length; i++) {
    const d = h[i - 1].price - h[i].price;
    if (d > 0) { anzahl++; summe += d; }
  }
  return { anzahl, summe };
}

/* --- Doppelte oder neu eingestellte Inserate erkennen ---
   Verglichen wird über Merkmale, die eine Neueinstellung überdauern:
   Marke, Modell, Farbe, Erstzulassung und Ort. Der Kilometerstand ist
   bewusst keine Bedingung — den gibt der Verkäufer beim zweiten Mal neu
   ein, meist mit anderem Wert. Der Anbietername ebenso wenig, weil bei
   Privatanzeigen überall dasselbe steht. Beide zählen nur als Indiz. */

const DUBLETTE_FELDER = ["make", "model", "color", "location"];

function fingerabdruck(v) {
  return [...DUBLETTE_FELDER.map((f) => v[f]), erstzulassung(v)]
    .map((s) => String(s == null ? "" : s).trim().toLowerCase()).join(" | ");
}
// Nur vergleichen, wenn alle Merkmale gefüllt sind — sonst passt eine
// halbleere Erfassung auf beliebig viele andere.
const fingerabdruckVollstaendig = (v) =>
  DUBLETTE_FELDER.every((f) => String(v[f] || "").trim()) && !!erstzulassung(v);

// Zusätzliche Anhaltspunkte, die den Verdacht erhärten.
function dublettenIndizien(neu, alt) {
  const indizien = [];
  const nameA = String(neu.dealerName || "").trim().toLowerCase();
  const nameB = String(alt.dealerName || "").trim().toLowerCase();
  if (nameA && nameA === nameB) indizien.push("gleicher Anbietername");
  if (neu.mileage != null && alt.mileage != null) {
    const d = Math.abs(neu.mileage - alt.mileage);
    if (d === 0) indizien.push("identischer Kilometerstand — das Auto ist seitdem nicht gefahren worden");
    else if (d <= 3000) indizien.push(`Kilometerstand nur ${fmtNum(d)} km auseinander`);
  }
  const neuPreis = lastPrice(neu), altPreis = lastPrice(alt);
  if (neuPreis != null && altPreis != null && neuPreis > altPreis) {
    indizien.push(`Preis liegt ${fmtEUR(neuPreis - altPreis)} über dem zuletzt gesehenen — typisch für eine zurückgesetzte Anzeige`);
  }
  if (neu.trimline && alt.trimline && neu.trimline.toLowerCase() === alt.trimline.toLowerCase()) {
    indizien.push("gleiche Ausstattungslinie");
  }
  return indizien;
}



const COLORS = [
  "#F5B301", "#35C46B", "#4EA8F4", "#F4544E", "#C77DFF",
  "#2DD4BF", "#FB923C", "#E879A9", "#A3E635", "#60A5FA",
];

const T = {
  bg: "#14171C", surface: "#1C2027", surface2: "#232830", line: "#2E353F",
  text: "#E6E9EE", muted: "#8A93A0", accent: "#F5B301", good: "#35C46B", bad: "#F4544E",
};

/* --- Preis gegen Standzeit ---------------------------------------------
   Was ein Auto kostet, sagt für sich genommen nichts. Interessant ist, was
   der Markt damit macht: Ein Inserat, das nach einer Woche verschwindet,
   war richtig bepreist. Eines, das seit Monaten steht, ist es nicht.

   Zwei Dinge sind daran heikel, und beide stehen auch in der App:
   - Ein laufendes Inserat hat seine Standzeit noch vor sich. Der Wert ist
     ein Mindestwert und wächst jeden Tag weiter. Solche Fahrzeuge werden
     als Ring gezeichnet, nicht als voller Punkt — sonst sähe ein gestern
     eingestelltes Auto aus wie ein Schnellverkauf.
   - Verschwunden heißt nicht verkauft. Der Verkäufer kann zurückgezogen
     oder neu eingestellt haben. */


const SYNC_INFO = {
  lokal:      { kurz: "nur lokal",   farbe: "#8A93A0", lang: "Die Daten liegen nur in diesem Browser." },
  laedt:      { kurz: "lädt…",       farbe: "#F5B301", lang: "Der Stand wird vom Server geholt." },
  speichert:  { kurz: "speichert…",  farbe: "#F5B301", lang: "Änderungen werden auf den Server geschrieben." },
  verbunden:  { kurz: "verbunden",   farbe: "#35C46B", lang: "Alles auf dem Server gesichert." },
  schluessel: { kurz: "Schlüssel?",  farbe: "#F4544E", lang: "Der Schlüssel wird abgelehnt." },
  fehler:     { kurz: "Fehler",      farbe: "#F4544E", lang: "Der Server ist gerade nicht erreichbar — lokal ist alles gespeichert." },
  konflikt:   { kurz: "Konflikt",    farbe: "#F5B301", lang: "Auf dem Server liegt ein neuerer Stand, vermutlich von einem anderen Gerät." },
};

/* ---------------------------- Helpers ---------------------------- */

const todayISO = () => new Date().toISOString().slice(0, 10);
const lastPrice = (v) => (v.priceHistory?.length ? v.priceHistory[v.priceHistory.length - 1].price : null);

function coerceNum(v) {
  if (v == null) return null;
  if (typeof v === "number") return isNaN(v) ? null : v;
  let s = String(v).replace(/[^\d.,]/g, "");
  if (!s) return null;
  if (s.includes(",")) s = s.replace(/\./g, "").replace(",", ".");
  else if (/\.\d{3}(\.|$)/.test(s)) s = s.replace(/\./g, "");
  const n = parseFloat(s);
  return isNaN(n) ? null : n;
}
const fmtEUR = (n) => (n == null || isNaN(n) ? "—" : new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(n));
const fmtNum = (n) => (n == null || isNaN(n) ? "—" : new Intl.NumberFormat("de-DE").format(n));
function fmtDate(iso) { if (!iso) return ""; const [y, m, d] = iso.split("-"); return `${d}.${m}.${y.slice(2)}`; }
function slugId(v) {
  const basis = [v.make, v.model, v.series, v.year].filter(Boolean).join("-") || v.title || "auto";
  return basis.toLowerCase().replace(/[^\w]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60) || "auto";
}

// Farbe je Begriff
function tagColor(field, value) {
  if (!value) return T.muted;
  // Die vierstufigen Skalen laufen von gut nach schlecht — die Farbe folgt
  // ihrer Position in der Liste, damit sich nichts widerspricht.
  const stufe = (opts) => {
    const i = opts.indexOf(value);
    return i <= 0 ? T.good : i === 1 ? T.text : i === 2 ? T.accent : T.bad;
  };
  if (field === "exterieur") return stufe(EXTERIEUR_OPTS);
  if (field === "interieur") return stufe(INTERIEUR_OPTS);
  if (field === "repairKind") return stufe(REPAIR_KIND_OPTS);
  if (field === "accidentRepaired") return value === "Ja" ? T.bad : T.good;
  if (field === "ausstattung") return value === "Exzellente Ausstattung" ? T.accent : value === "Besondere Ausstattung" ? T.text : T.muted;
  if (field === "trimline") return value === "Avantgarde" ? T.accent : T.text;
  if (field === "listingStatus") return value === "Aktiv" ? T.good : value === "Verkauft" ? T.muted : T.accent;
  return T.text;
}

/* -------------------- Import (nur JSON.parse) -------------------- */

function normalizeHistory(h) {
  if (!Array.isArray(h)) return [];
  const seen = {};
  h.forEach((p) => {
    if (!p) return;
    const date = p.date ? String(p.date).slice(0, 10) : null;
    const price = coerceNum(p.price);
    if (date && price != null) seen[date] = price;
  });
  return Object.entries(seen).map(([date, price]) => ({ date, price })).sort((a, b) => a.date.localeCompare(b.date));
}
function normalizeVehicle(v) {
  const out = {};
  TEXT_FIELDS.forEach((k) => { out[k] = v[k] != null ? String(v[k]).trim() : ""; });
  out.accidentRepaired = normalizeStatus(v.accidentRepaired ?? v.accidentStatus, ACCIDENT_OPTS, "Nein");
  out.trimline = normalizeChoice(v.trimline, "trimline", TRIMLINE_OPTS);
  out.repairKind = normalizeChoice(v.repairKind, "repairKind", REPAIR_KIND_OPTS);
  out.exterieur = normalizeChoice(v.exterieur, "exterieur", EXTERIEUR_OPTS);
  out.interieur = normalizeChoice(v.interieur, "interieur", INTERIEUR_OPTS);
  out.fuel = normalizeChoice(v.fuel, "fuel", FUEL_OPTS);
  out.gearbox = normalizeChoice(v.gearbox, "gearbox", GEARBOX_OPTS);
  out.sellerType = normalizeChoice(v.sellerType, "sellerType", SELLER_OPTS);
  out.color = normalizeChoice(v.color, "color", COLOR_OPTS);
  out.month = normalizeMonth(v.month);
  out.year = (String(v.year || "").match(/\d{4}/) || [""])[0];
  out.mileage = coerceNum(v.mileage);
  // Aus den vierzehn Aufwertungen wird gezählt, nicht bewertet.
  out.equipment = Array.isArray(v.equipment)
    ? [...new Set(v.equipment.map((e) => String(e).trim()).filter(Boolean))] : [];
  out.ausstattung = ausstattungsStufe(out.equipment.length);
  out.priceHistory = normalizeHistory(v.priceHistory);
  if (!out.priceHistory.length && v.price != null) {
    const p = coerceNum(v.price);
    if (p != null) out.priceHistory = [{ date: v.date ? String(v.date).slice(0, 10) : todayISO(), price: p }];
  }
  // Bleibt leer, wenn nichts mitgeliefert wurde — daran erkennt der Import,
  // ob ein Abschluss gemeint ist oder nur ein Preis-Update.
  out.listingStatus = normalizeChoice(v.listingStatus, "listingStatus", STATUS_OPTS);
  /* Bleibt leer, wenn im Inserat kein "Online seit" stand. Früher wurde
     hier der Erfassungstag eingesetzt — das sah aus wie eine Angabe, war
     aber geraten, und jede Zeitrechnung begann dadurch bei null. Was die
     App nicht weiß, trägt sie jetzt auch nicht ein; nachtragen lässt es
     sich am Fahrzeug. */
  /* Das Inseratsdatum unter allen Namen annehmen, unter denen es kommen
     kann. Es fehlte in älteren Prompt-Fassungen ganz, und wo es fehlt,
     bleibt das Feld leer statt mit dem Erfassungstag gefüllt zu werden —
     sonst sähe eine Vermutung aus wie eine Angabe. */
  out.listedSince = datumOderVorher(
    [v.listedSince, v.onlineSince, v.listedAt, v.inseriertSeit, v.onlineSeit,
      v.insertionDate, v.listingDate, v.publishedAt, v.firstListed]
      .find((x) => x != null && String(x).trim() !== ""),
    out.priceHistory[0]?.date);
  out.closedDate = nurDatum(v.closedDate);
  // Aus einer Sicherung kommen diese Werte zurück; aus einer KI-Antwort nie.
  out.firstSeen = nurDatum(v.firstSeen);
  out.lastSeen = nurDatum(v.lastSeen);
  out.disappearedAt = nurDatum(v.disappearedAt);
  out.trackingQuality = v.trackingQuality === "full" ? "full" : v.trackingQuality === "legacy" ? "legacy" : "";
  out.id = (v.id && String(v.id).trim()) || slugId(out);
  return out;
}
/* Ein Datum aus dem herausholen, was geliefert wurde. Bisher wurde nur
   JJJJ-MM-TT erkannt; alles andere fiel still durch und das Feld blieb
   leer. Eine Antwort schreibt das Datum aber gern deutsch, mit Punkten
   oder mit Uhrzeit dahinter. */
function nurDatum(s) {
  const t = String(s == null ? "" : s).trim();
  if (!t) return "";
  const iso = t.match(/(\d{4})-(\d{2})-(\d{2})/);
  if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;
  const deutsch = t.match(/(\d{1,2})\.\s*(\d{1,2})\.\s*(\d{4})/);         // 26.07.2026
  if (deutsch) return `${deutsch[3]}-${String(deutsch[2]).padStart(2, "0")}-${String(deutsch[1]).padStart(2, "0")}`;
  const schraeg = t.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);                // 26/07/2026
  if (schraeg) return `${schraeg[3]}-${String(schraeg[2]).padStart(2, "0")}-${String(schraeg[1]).padStart(2, "0")}`;
  const MONATE = { januar: 1, februar: 2, "märz": 3, maerz: 3, april: 4, mai: 5, juni: 6,
    juli: 7, august: 8, september: 9, oktober: 10, november: 11, dezember: 12 };
  const wort = t.match(/(\d{1,2})\.?\s*([A-Za-zÄÖÜäöü]+)\s*(\d{4})/);      // 26. Juli 2026
  if (wort) {
    const m = MONATE[wort[2].toLowerCase()];
    if (m) return `${wort[3]}-${String(m).padStart(2, "0")}-${String(wort[1]).padStart(2, "0")}`;
  }
  return "";
}
/* "vor 3 Wochen online" ist keine Angabe, die man abtippen kann — aber
   eine, die auf mobile.de steht. Sie wird auf den heutigen Tag bezogen. */
function datumOderVorher(s, heute) {
  const fest = nurDatum(s);
  if (fest) return fest;
  const rel = String(s == null ? "" : s).toLowerCase()
    .match(/vor\s+(?:(\d+)\s*)?(tag|tagen|woche|wochen|monat|monaten)/);
  if (!rel) return "";
  const zahl = rel[1] ? parseInt(rel[1], 10) : 1;
  const faktor = rel[2].startsWith("tag") ? 1 : rel[2].startsWith("woche") ? 7 : 30;
  const d = parseISO(heute || todayISO());
  if (!d) return "";
  d.setDate(d.getDate() - zahl * faktor);
  return d.toISOString().slice(0, 10);
}
// Schneidet den JSON-Block aus einer KI-Antwort heraus:
// Codeblock-Zeichen, Einleitungssätze und Nachtext werden verworfen.
function extractJson(text) {
  let t = (text || "").trim();
  const fence = t.match(/```(?:json)?\s*([\s\S]*?)```/i);
  if (fence) t = fence[1].trim();
  t = t.replace(/^```(?:json)?\s*/i, "").replace(/```\s*$/, "").trim();
  const start = t.search(/[[{]/);
  if (start > 0) t = t.slice(start);
  if (!/^[[{]/.test(t)) return t;

  // Bis zur passenden schließenden Klammer schneiden (Anführungszeichen beachten)
  const open = t[0];
  const close = open === "[" ? "]" : "}";
  let depth = 0, inString = false, escaped = false;
  for (let i = 0; i < t.length; i++) {
    const c = t[i];
    if (inString) {
      if (escaped) escaped = false;
      else if (c === "\\") escaped = true;
      else if (c === '"') inString = false;
    } else if (c === '"') inString = true;
    else if (c === open) depth++;
    else if (c === close && --depth === 0) return t.slice(0, i + 1);
  }
  return t;
}

// Typische Schludrigkeiten schwacher Modelle: Komma vor der schließenden
// Klammer und typografische Anführungszeichen.
function repairJson(t) {
  // Typografische Anführungszeichen geradebiegen. Heikel ist ein echtes
  // Anführungszeichen im Text — etwa das Zoll-Zeichen in »18" AMG«: Es würde
  // den Wert mittendrin beenden. Deshalb wird es innerhalb eines Wertes
  // geschützt, bevor die Klammern selbst zu geraden Zeichen werden.
  let out = "";
  let imText = false;
  for (const c of t) {
    if (c === "“" || c === "”" || c === "„" || c === "‟") {
      out += '"';
      imText = !imText;
    } else if (c === '"' && imText) {
      out += '\\"';
    } else {
      out += c;
    }
  }
  return out
    .replace(/[‘’‚]/g, "'")
    .replace(/,\s*([}\]])/g, "$1");
}

function parseImport(text) {
  if (!(text || "").trim()) return { error: "Nichts eingefügt." };
  const t = extractJson(text);
  if (!t) return { error: "Darin steckt kein JSON. Kopiere die Antwort der KI komplett — Text drumherum ist kein Problem." };
  let data;
  try { data = JSON.parse(t); }
  catch (e) {
    try { data = JSON.parse(repairJson(t)); }
    catch (e2) { return { error: "Der JSON-Block ist unvollständig oder fehlerhaft. Lass ihn dir von der KI noch einmal komplett ausgeben und füge die ganze Antwort ein." }; }
  }
  const arr = Array.isArray(data) ? data : [data];
  const vehicles = arr.filter((x) => x && typeof x === "object").map(normalizeVehicle);
  if (!vehicles.length) return { error: "Im JSON wurde kein Fahrzeug gefunden." };
  // Was außerhalb des JSON-Blocks steht, wird sonst verworfen. Steht dort ein
  // Link, ist er oft genau der, den die KI im Feld "url" vergessen hat.
  const drumherum = linksImText(String(text).split(t).join(" \n "));
  return { vehicles, drumherum };
}

/* --------------------------- Storage ----------------------------- */

const SERVER_URL = "/api/garage";
const KEY_STORE = "preiswache:key";

// Der Schlüssel liegt auf dem Gerät, nicht im ausgelieferten Programm —
// die Seite ist öffentlich, ein eingebauter Schlüssel wäre keiner.
const readKey = () => { try { return localStorage.getItem(KEY_STORE) || ""; } catch (_) { return ""; } };
const writeKey = (k) => { try { k ? localStorage.setItem(KEY_STORE, k) : localStorage.removeItem(KEY_STORE); } catch (_) {} };

function localRead() {
  try {
    const roh = localStorage.getItem(STORE_KEY);
    return roh ? JSON.parse(roh) : null;
  } catch (_) { return null; }
}
function localWrite(vehicles) {
  try { localStorage.setItem(STORE_KEY, JSON.stringify({ vehicles })); return true; }
  catch (e) { console.error("Lokal speichern fehlgeschlagen", e); return false; }
}

async function serverRead(key) {
  const r = await fetch(SERVER_URL, { headers: { authorization: `Bearer ${key}` }, cache: "no-store" });
  const daten = await r.json().catch(() => ({}));
  if (!r.ok) throw Object.assign(new Error(daten.error || `Server antwortete mit ${r.status}`), { status: r.status });
  return daten;
}
async function serverWrite(key, vehicles, base) {
  const r = await fetch(SERVER_URL, {
    method: "PUT",
    headers: { authorization: `Bearer ${key}`, "content-type": "application/json" },
    body: JSON.stringify({ vehicles, base }),
  });
  const daten = await r.json().catch(() => ({}));
  if (!r.ok) throw Object.assign(new Error(daten.error || `Server antwortete mit ${r.status}`), { status: r.status, daten });
  return daten;
}

// Gespeicherte Einträge auf das heutige Vokabular heben, egal woher sie stammen.
function migrate(vehicles) {
  // Übertragung der alten Merkmale auf die neuen. Die Zuordnung folgt der
  // Bedeutung, nicht der Reihenfolge, und ist eine Annahme — die Einträge
  // landen deshalb ungeprüft im Bereich "Offene Punkte".
  const ALT_EXTERIEUR = {
    "Keine": "Keine sichtbaren Schäden",
    "Leicht zu übersehen": "Leichte Gebrauchsspuren",
    "Bei genauem Hinsehen": "Leichte Schäden",
    "Deutlich erkennbar": "Leichte Schäden an mehreren Stellen",
  };
  const ALT_INTERIEUR = {
    "Aufbereitet": "Wie neu",
    "Normale Gebrauchsspuren": "Durchgehend leicht abgenutzt",
    "Nicht vorbereitet": "Deutliche Verbrauchsspuren",
  };
  const ALT_REPARATUR = {
    "Keine": "Keine genannt", "Unbekannt": "Keine genannt",
    "Gering": "Verschleißteile", "Mittel": "Kernfahrzeugteile", "Umfangreich": "Gesamte Prozessteile",
  };

  Object.values(vehicles || {}).forEach((v) => {
    if (!v.exterieur && v.photoDamage) v.exterieur = ALT_EXTERIEUR[v.photoDamage] || "";
    if (!v.interieur && v.listingPrep) v.interieur = ALT_INTERIEUR[v.listingPrep] || "";
    if (!v.repairKind && v.repairScope) v.repairKind = ALT_REPARATUR[v.repairScope] || "";
    if (!v.accidentRepaired) v.accidentRepaired = v.accidentStatus === "Unfallwagen" ? "Ja" : "Nein";
    if (!v.repairNote) {
      v.repairNote = [v.damageRepaired, v.damagePrevious, v.damageCurrent]
        .map((t) => String(t || "").trim()).filter(Boolean).join(" · ");
    }
    delete v.photoDamage; delete v.listingPrep; delete v.repairScope;
    delete v.accidentStatus; delete v.currentIssueStatus; delete v.previousDamageStatus;
    delete v.damageCurrent; delete v.damagePrevious; delete v.damageRepaired;
    delete v.category; delete v.condition; delete v.drivetrain;
    delete v.power; delete v.displacement; delete v.stars; delete v.address; delete v.repairCount;

    v.accidentRepaired = normalizeStatus(v.accidentRepaired, ACCIDENT_OPTS, "Nein");
    v.trimline = normalizeChoice(v.trimline, "trimline", TRIMLINE_OPTS);
    v.repairKind = normalizeChoice(v.repairKind, "repairKind", REPAIR_KIND_OPTS);
    v.exterieur = normalizeChoice(v.exterieur, "exterieur", EXTERIEUR_OPTS);
    v.interieur = normalizeChoice(v.interieur, "interieur", INTERIEUR_OPTS);
    v.fuel = normalizeChoice(v.fuel, "fuel", FUEL_OPTS);
    v.gearbox = normalizeChoice(v.gearbox, "gearbox", GEARBOX_OPTS);
    v.sellerType = normalizeChoice(v.sellerType, "sellerType", SELLER_OPTS);
    v.color = normalizeChoice(v.color, "color", COLOR_OPTS);
    v.month = normalizeMonth(v.month);
    v.equipment = Array.isArray(v.equipment) ? v.equipment : [];
    v.ausstattung = ausstattungsStufe(v.equipment.length);
    delete v.showcase;
    v.listingStatus = normalizeChoice(v.listingStatus, "listingStatus", STATUS_OPTS) || "Aktiv";
    v.listedSince = nurDatum(v.listedSince);   // nichts erfinden, siehe normalize()

    /* Aufräumen nach der alten Regel: Bis hierher hat die App ein fehlendes
       Inseratsdatum stillschweigend mit dem Tag der ersten Erfassung
       gefüllt. Das ist keine Angabe, sondern eine Vermutung — und sie hat
       jede Linie im Preisverlauf bei Tag 0 beginnen und dort auch enden
       lassen. Wo das Datum genau auf dem ersten Preis-Punkt und der ersten
       Sichtung liegt, war es dieser Automatismus; es wird geleert, damit
       die App danach fragt. Gerechnet wird ohnehin weiter mit dem ersten
       Preis-Punkt, es geht also keine Zahl verloren — nur die Behauptung. */
    if (v.listedSince && v.listedSince === v.priceHistory?.[0]?.date
        && (!v.firstSeen || v.firstSeen === v.listedSince)) {
      v.listedSince = "";
    }

    /* Beobachtungsdaten für Einträge nachziehen, die es vor dieser Zählung
       schon gab. Was fehlt, wird aus dem Vorhandenen erschlossen und ist
       damit eine Annahme — deshalb bekommen sie "legacy", solange sich
       nicht belegen lässt, dass der Anfang des Inserats dabei war. */
    const ersterPunkt = v.priceHistory?.[0]?.date || "";
    const letzterPunkt = v.priceHistory?.[v.priceHistory.length - 1]?.date || "";
    if (!v.firstSeen) {
      v.firstSeen = [nurDatum(v.createdAt), ersterPunkt].filter(Boolean).sort()[0] || "";
    }
    if (!v.lastSeen) {
      v.lastSeen = [letzterPunkt, v.geprueft, nurDatum(v.updatedAt)]
        .filter(Boolean).filter((d) => d <= todayISO()).sort().pop() || v.firstSeen;
    }
    if (!v.disappearedAt && v.listingStatus && v.listingStatus !== "Aktiv") {
      v.disappearedAt = v.closedDate || v.lastSeen || "";
    }
    // Ein wieder geöffnetes Inserat ist nicht verschwunden.
    if (v.listingStatus === "Aktiv") v.disappearedAt = "";
    if (v.trackingQuality !== "full" && v.trackingQuality !== "legacy") {
      v.trackingQuality = trackingGuete(v.listedSince, v.firstSeen);
    }
    // Schon gespeicherte Links werden mit geradegezogen: Alteinträge tragen
    // teils noch die Verpackung der KI mit sich herum und führen so ins Leere.
    v.url = normalizeUrl(v.url);
  });
  return vehicles || {};
}

