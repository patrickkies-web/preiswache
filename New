function dublettenIndizien(neu, alt) {
  const indizien = [];
  const nameA = String(neu.dealerName || "").trim().toLowerCase();
  const nameB = String(alt.dealerName || "").trim().toLowerCase();
  if (nameA && nameA === nameB) indizien.push("gleicher Anbietername");
  if (neu.mileage != null && alt.mileage != null) {
    const d = Math.abs(neu.mileage - alt.mileage);
    if (d === 0) indizien.push("identischer Kilometerstand — das Auto ist seitdem nicht gefahren worden");
    else if (d <= 3000) indizien.push(`Kilometerstand nur ${fmtNum(d)} km auseinander`);
  }
  const neuPreis = lastPrice(neu), altPreis = lastPrice(alt);
  if (neuPreis != null && altPreis != null && neuPreis > altPreis) {
    indizien.push(`Preis liegt ${fmtEUR(neuPreis - altPreis)} über dem zuletzt gesehenen — typisch für eine zurückgesetzte Anzeige`);
  }
  if (neu.trimline && alt.trimline && neu.trimline.toLowerCase() === alt.trimline.toLowerCase()) {
    indizien.push("gleiche Ausstattungslinie");
  }
  return indizien;
}

