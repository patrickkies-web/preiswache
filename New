  };
  const fileRef = useRef(null);
  // Synchronisierung
  const [sync, setSync] = useState({ state: "lokal", savedAt: null, msg: "" });
  const [showSync, setShowSync] = useState(false);
  const [keyInput, setKeyInput] = useState(readKey());
  const toggleRow = useCallback((id) => setOpenRows((p) => ({ ...p, [id]: !p[id] })), []);

  /* ---- Speichern: lokal sofort, auf dem Server sobald möglich ---- */
  const baseRef = useRef(null);        // Stand, auf dem unsere Änderungen aufsetzen
  const keyRef = useRef(readKey());

  const pushToServer = useCallback(async (next) => {
    if (!keyRef.current) return;
    setSync((s) => ({ ...s, state: "speichert" }));
    try {
      const { savedAt } = await serverWrite(keyRef.current, next, baseRef.current);
      baseRef.current = savedAt;
      setSync({ state: "verbunden", savedAt, msg: "" });
    } catch (e) {
      if (e.status === 409) {
        setSync({ state: "konflikt", savedAt: e.daten?.savedAt || null, msg: e.message, fremd: e.daten?.vehicles || {} });
      } else {
        setSync({ state: e.status === 401 ? "schluessel" : "fehler", savedAt: null, msg: e.message });
      }
    }
  }, []);

  const persist = useCallback((next) => {
    setVehicles(next); localWrite(next); pushToServer(next);
  }, [pushToServer]);

  const updateVehicle = useCallback((id, updater) => {
    setVehicles((prev) => {
      const v = prev[id]; if (!v) return prev;
      const next = { ...prev, [id]: updater({ ...v }) };
      localWrite(next); pushToServer(next);
      return next;
    });
  }, [pushToServer]);

  // Beim Start: lokale Kopie sofort zeigen, dann den Server nachziehen.
  useEffect(() => {
    const lokal = migrate(localRead()?.vehicles || {});
    setVehicles(lokal);
    localWrite(lokal);          // geradegezogene Werte gleich festhalten
    setLoaded(true);
    const key = keyRef.current;
    if (!key) { setSync({ state: "lokal", savedAt: null, msg: "" }); return; }
    (async () => {
      setSync((s) => ({ ...s, state: "laedt" }));
      try {
        const { vehicles: fern, savedAt } = await serverRead(key);
        baseRef.current = savedAt;
        if (savedAt) {
          const roh = JSON.stringify(fern);          // migrate arbeitet am Original
          const gehoben = migrate(fern);
          setVehicles(gehoben); localWrite(gehoben);
          setSync({ state: "verbunden", savedAt, msg: "" });
          // Hat das Anheben etwas geradegezogen — etwa einen kaputten Link —,
          // gehört der bereinigte Stand auch auf den Server, sonst kommt er
          // beim nächsten Gerät wieder als Altlast zurück.
          if (JSON.stringify(gehoben) !== roh) pushToServer(gehoben);
        } else if (Object.keys(lokal).length) {
          await pushToServer(lokal);            // erster Abgleich: lokal hoch
        } else {
          setSync({ state: "verbunden", savedAt: null, msg: "" });
        }
      } catch (e) {
        setSync({ state: e.status === 401 ? "schluessel" : "fehler", savedAt: null, msg: e.message });
      }
    })();
  }, [pushToServer]);

  // Konflikt auflösen
  const konfliktServerNehmen = useCallback(() => {
    setSync((s) => {
      const fern = migrate(s.fremd || {});
      setVehicles(fern); localWrite(fern);
      baseRef.current = s.savedAt;
      return { state: "verbunden", savedAt: s.savedAt, msg: "" };
    });
  }, []);
  const konfliktEigenesNehmen = useCallback(() => {
    setSync((s) => { baseRef.current = s.savedAt; return s; });
    setTimeout(() => setVehicles((v) => { pushToServer(v); return v; }), 0);
  }, [pushToServer]);

  const schluesselSpeichern = useCallback((k) => {
    const sauber = k.trim();
    keyRef.current = sauber; writeKey(sauber); baseRef.current = null;
    if (!sauber) { setSync({ state: "lokal", savedAt: null, msg: "" }); return; }
    (async () => {
      setSync({ state: "laedt", savedAt: null, msg: "" });
      try {
        const { vehicles: fern, savedAt } = await serverRead(sauber);
        baseRef.current = savedAt;
        if (savedAt) {
          const roh = JSON.stringify(fern);
          const gehoben = migrate(fern);
          setVehicles(gehoben); localWrite(gehoben);
          setSync({ state: "verbunden", savedAt, msg: "" });
          if (JSON.stringify(gehoben) !== roh) pushToServer(gehoben);
        } else {
          setVehicles((v) => { pushToServer(v); return v; });
        }
      } catch (e) {
        setSync({ state: e.status === 401 ? "schluessel" : "fehler", savedAt: null, msg: e.message });
      }
    })();
  }, [pushToServer]);

  const list = useMemo(() => Object.values(vehicles).sort((a, b) => (b.updatedAt || "").localeCompare(a.updatedAt || "")), [vehicles]);

  /* ---- Import ---- */
  // Nimmt wahlweise übergebenen Text (aus einer Datei) oder den Feldinhalt.
  function handlePreview(text) {
    const quelle = typeof text === "string" ? text : raw;
    const res = parseImport(quelle);
    if (res.error) { setNotice({ type: "err", msg: res.error }); setPreview(null); return; }
    // Bei bekannten Fahrzeugen die früheren Antworten vorbelegen.
    const vorbelegt = {};
    // Ein einzelner Link neben dem JSON gehört eindeutig zu dem einen Wagen.
    // Bei mehreren Fahrzeugen wäre die Zuordnung geraten — dann lieber nicht.
    const ausDemText = res.vehicles.length === 1 && res.drumherum?.length === 1 ? res.drumherum[0] : "";
    res.vehicles.forEach((v) => {
      const alt = vehicles[v.id];
      // Aus einer Sicherung mitgelieferte Antworten zählen zuerst,
      // danach die des bereits erfassten Fahrzeugs.
      vorbelegt[v.id] = {
        trimline: v.trimline || alt?.trimline || "",
        exterieur: v.exterieur || alt?.exterieur || "",
        interieur: v.interieur || alt?.interieur || "",
        repairKind: v.repairKind || alt?.repairKind || (v.repairNote ? "" : "Keine genannt"),
        // Gleich geradegezogen, damit im Feld steht, was später gespeichert wird.
        url: normalizeUrl(v.url) || normalizeUrl(alt?.url) || ausDemText,
      };
    });
    setAnswers(vorbelegt);
    setPreview(res.vehicles); setNotice(null);
  }
  async function handleFile(e) {
    const datei = e.target.files?.[0];
    e.target.value = "";           // damit dieselbe Datei erneut wählbar bleibt
    if (!datei) return;
    try {
      const text = await datei.text();
      if (!text.trim()) { setNotice({ type: "err", msg: `„${datei.name}" ist leer.` }); return; }
      setRaw(text);
      handlePreview(text);
    } catch (_) {
      setNotice({ type: "err", msg: `„${datei.name}" konnte nicht gelesen werden.` });
    }
  }

  const setAnswer = (id, feld, wert) =>
    setAnswers((prev) => ({ ...prev, [id]: { ...prev[id], [feld]: wert } }));
  const alleBeantwortet = !preview || preview.every((v) => {
    const a = answers[v.id] || {};
    return a.trimline && a.exterieur && a.interieur && a.repairKind && istLink(a.url);
  });

  function confirmImport() {
    const next = { ...vehicles }; let added = 0, updated = 0;
    preview.forEach((raw_) => {
      const antw = answers[raw_.id] || {};
      // Beim Import hast du jedes Fahrzeug einzeln vor dir gehabt, inklusive
      // der Hinweise auf Schäden — das zählt als Durchsicht.
      const incoming = { ...raw_, ...antw, url: normalizeUrl(antw.url || raw_.url), geprueft: todayISO() };
      const existing = next[incoming.id];
      if (existing) {
        const merged = { ...existing };
        TEXT_FIELDS.forEach((k) => { if (incoming[k]) merged[k] = incoming[k]; });
        if (incoming.mileage != null) merged.mileage = incoming.mileage;
        if (incoming.equipment?.length) { merged.equipment = incoming.equipment; merged.ausstattung = incoming.ausstattung; }
        const byDate = {};
        existing.priceHistory.forEach((p) => { byDate[p.date] = p.price; });
        incoming.priceHistory.forEach((p) => { byDate[p.date] = p.price; });
        merged.priceHistory = Object.entries(byDate).map(([date, price]) => ({ date, price })).sort((a, b) => a.date.localeCompare(b.date));
        /* Der früheste bekannte Tag bleibt der Beginn des Inserats — aber nur
           ein wirklich gemeldeter. Der erste Preis-Punkt ist der Tag deiner
           Erfassung und beweist über den Inseratsstart nichts. */
        merged.listedSince = [existing.listedSince, incoming.listedSince]
          .filter(Boolean).sort()[0] || "";
        // Ein Preis-Update der KI enthält keinen Abschluss und lässt ihn unangetastet;
        // eine Sicherung bringt ihn mit und stellt ihn wieder her.
        merged.listingStatus = incoming.listingStatus || existing.listingStatus || "Aktiv";
        merged.closedDate = incoming.closedDate || existing.closedDate || "";
        /* Beobachtung fortschreiben. Die erste Sichtung steht fest und wird
           nie später — sonst ginge die Vorgeschichte verloren. Das Fahrzeug
           wurde gerade erneut eingelesen, also war es zu sehen. */
        merged.firstSeen = [existing.firstSeen, incoming.firstSeen, merged.priceHistory[0]?.date]
          .filter(Boolean).sort()[0] || "";
        merged.lastSeen = [existing.lastSeen, incoming.lastSeen, todayISO()]
          .filter(Boolean).sort().pop() || todayISO();
        merged.disappearedAt = merged.listingStatus === "Aktiv" ? ""
          : (incoming.disappearedAt || existing.disappearedAt || merged.closedDate || "");
        // Einmal vergeben, bleibt die Güte. Sie beschreibt den Moment der
        // Aufnahme, nicht den heutigen Stand.
        merged.trackingQuality = existing.trackingQuality || incoming.trackingQuality
          || trackingGuete(merged.listedSince, merged.firstSeen);
        merged.updatedAt = new Date().toISOString();
        next[incoming.id] = merged; updated++;
      } else {
        const firstSeen = incoming.firstSeen || todayISO();
        next[incoming.id] = { ...incoming, listingStatus: incoming.listingStatus || "Aktiv",
          firstSeen,
          lastSeen: incoming.lastSeen || todayISO(),
          disappearedAt: incoming.listingStatus && incoming.listingStatus !== "Aktiv"
            ? (incoming.disappearedAt || incoming.closedDate || "") : "",
          trackingQuality: incoming.trackingQuality || trackingGuete(incoming.listedSince, firstSeen),
          createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() }; added++;
      }
    });
    persist(next); setPreview(null); setRaw("");
    setNotice({ type: "ok", msg: `${added} neu · ${updated} aktualisiert.` });
  }

  /* ---- Qualitätssicherung ---- */
  // Ändern und Abhaken sind zwei Schritte: erst alles richtigstellen, dann
  // bestätigen. Sonst verschwände der Eintrag nach der ersten Korrektur.
  const setzeFeld = useCallback((id, feld, wert) => {
    updateVehicle(id, (v) => ({ ...v, [feld]: wert, updatedAt: new Date().toISOString() }));
  }, [updateVehicle]);

  /* Der Tag, an dem der Verkäufer inseriert hat, ist die wichtigste Angabe
     für jede Zeitrechnung — und die einzige, die man am Inserat abliest
     statt sie zu beobachten. Steht sie nicht drin, beginnt jede Linie im
     Preisverlauf erst am Tag der Erfassung. Deshalb ist sie nachtragbar.
     Mit ihr ändert sich auch, ob der Anfang mitverfolgt wurde. */
  const setzeInseratsdatum = useCallback((id, datum) => {
    updateVehicle(id, (v) => {
      const listedSince = nurDatum(datum);
      const firstSeen = v.firstSeen || v.priceHistory?.[0]?.date || "";
      return { ...v, listedSince,
        trackingQuality: listedSince ? trackingGuete(listedSince, firstSeen) : "legacy",
        updatedAt: new Date().toISOString() };
