              ) : absorption.fair ? (
                <>
                  <b style={{ color: T.accent }}>Wenn du in {zielTage} Tagen raus willst:</b>{" "}
                  Du musst unter <b style={{ color: T.good }}>{fmtEUR(absorption.fair.bis)}</b> hinein.
                  Auf dieser Stufe war nach {zielTage} Tagen{" "}
                  <b style={{ color: T.text }}>{Math.round(absorption.zielZelle(absorption.fair).anteil * 100)} %</b>{" "}
                  des Feldes absorbiert; die Hälfte war nach{" "}
                  <b style={{ color: T.text }}>{absorption.fair.halbwert == null ? "— " : laufzeitDativ(absorption.fair.halbwert)}</b> weg.
                  {absorption.tot && absorption.tot.von > absorption.fair.von && (
                    <> Ab <b style={{ color: T.bad }}>{fmtEUR(absorption.tot.von)}</b> passiert dagegen fast
                      nichts mehr — dort waren nach {zielTage} Tagen erst{" "}
                      {Math.round(absorption.zielZelle(absorption.tot).anteil * 100)} % weg. Zwischen den beiden
                      Zahlen liegt der Bereich, in dem der Preis über die Wartezeit entscheidet.</>
                  )}
                  {" "}Umgekehrt heißt das für den Einkauf: Was oberhalb dieser Grenze steht und dort schon
                  länger liegt, ist ein Verkäufer, der es noch nicht gemerkt hat.
                </>
              ) : (
                <>
                  <b style={{ color: T.accent }}>Keine Stufe schafft die Hälfte in {zielTage} Tagen.</b>{" "}
                  Entweder ist die Zielzeit für diesen Markt zu kurz — stell oben auf ein längeres Fenster —
                  oder es sind schlicht noch zu wenige Abgänge beobachtet ({absorption.abgaenge} von{" "}
                  {absorption.anzahl}). Die Rechnung hält sich absichtlich zurück, statt eine Grenze zu
                  behaupten, die die Daten nicht hergeben.
                </>
              )}
            </div>

            <div style={S.kleinerHinweis}>
              <b style={{ color: T.accent }}>Wie die Zahlen entstehen.</b>{" "}
              Je Preisstufe wird eine Überlebenskurve nach Kaplan-Meier gerechnet. Ein laufendes Inserat zählt
              bis heute mit und danach nicht mehr gegen die Quote — es ist ja nicht gescheitert, es ist noch
              unterwegs. {absorption.nachgetragen > 0 && (
                <>Bei {absorption.nachgetragen} {absorption.nachgetragen === 1 ? "Inserat" : "Inseraten"} beginnt
                  die Beobachtung später als das Inserat: {absorption.nachgetragen === 1 ? "es zählt" : "sie zählen"}{" "}
                  erst ab dem Fundtag zum Feld, denn vorher {absorption.nachgetragen === 1 ? "hätte es" : "hätten sie"}{" "}
                  gar nicht auffallen können. </>
              )}
              Gestrichelte Felder heißen: dort standen zu wenige unter Beobachtung, um eine Quote zu bilden.
              Und weiterhin gilt — verschwunden heißt nicht verkauft.
            </div>
          </>
        )}
      </section>
      )}

      {tab === "verzeichnis" && (
      <section style={S.panel}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between" }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8 }}><Car size={15} /> Verzeichnis · {list.length}</span>
          {list.length > 0 && (
            <span style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
              <button style={S.exportBtn} onClick={() => setOpenRows(alleOffen ? {} : Object.fromEntries(list.map((v) => [v.id, true])))}>
                {alleOffen ? "Alle zuklappen" : "Alle aufklappen"}
              </button>
              <button style={S.exportBtn} onClick={exportGarage} title="Alle Fahrzeuge als JSON-Datei sichern — wiederherstellen über das Import-Feld">
                <Download size={13} /> Exportieren
              </button>
            </span>
          )}
        </div>
        {!loaded ? (<div style={S.empty}><span>Lade Daten…</span></div>)
          : list.length === 0 ? (<div style={S.empty}><span>Noch keine Fahrzeuge. Wechsle zu „Erfassen" und füge dort deinen ersten JSON-Block ein.</span></div>)
            : (
              <>
                <div style={S.sortZeile}>
                  <span style={S.fieldLabel}>Sortieren nach</span>
                  <select value={sortFeld} onChange={(e) => sortiereNach(e.target.value)} style={S.selectInline}>
                    <option value="">zuletzt geändert</option>
                    {Object.entries(SORT_FELDER).map(([f, d]) => <option key={f} value={f}>{d.label}</option>)}
                  </select>
                  {sortFeld && (
                    <button style={S.richtungBtn} onClick={() => setSortRichtung((r) => (r === "auf" ? "ab" : "auf"))}
                      title={sortRichtung === "auf" ? "Aufsteigend — zum Umdrehen klicken" : "Absteigend — zum Umdrehen klicken"}>
                      {sortRichtung === "auf" ? <><ArrowUp size={12} /> aufsteigend</> : <><ArrowDown size={12} /> absteigend</>}
                    </button>
                  )}
                </div>
                <div className="pw-dirhead" style={S.listHeadLabels}>
                  {[["title", "Fahrzeug"], ["preis", "Preis"], ["delta", "Veränderung"], ["mileage", "Kilometer"],
                    ["ez", "Erstzul."], ["location", "Ort"], ["repairKind", "Reparaturen"]].map(([f, label]) => (
                    <button key={f} onClick={() => sortiereNach(f)}
                      style={{ ...S.sortKopf, color: sortFeld === f ? T.accent : T.muted }}
                      title={`Nach ${SORT_FELDER[f].label} sortieren`}>
                      {label}
                      {sortFeld === f && (sortRichtung === "auf" ? <ArrowUp size={11} /> : <ArrowDown size={11} />)}
                    </button>
                  ))}
                  <span />
                  <span />
                </div>
                <div style={S.listWrap}>
                  {verzeichnis.map((v) => (
                    <VehicleCard key={v.id} v={v} accent={colorFor(v.id)}
                      open={!!openRows[v.id]} onToggle={toggleRow}
                      addFor={addFor} addDate={addDate} addPrice={addPrice} setAddDate={setAddDate} setAddPrice={setAddPrice}
                      openAdd={openAdd} cancelAdd={() => setAddFor(null)} addPoint={addPoint} deletePoint={deletePoint} removeVehicle={removeVehicle}
                      closeFor={closeFor} closeStatus={closeStatus} closeDate={closeDate} setCloseStatus={setCloseStatus} setCloseDate={setCloseDate}
                      openClose={openClose} cancelClose={() => setCloseFor(null)} confirmClose={confirmClose} reopen={reopen}
                      setzeFeld={setzeFeld} heuteGesehen={heuteGesehen} setzeInseratsdatum={setzeInseratsdatum} />
                  ))}
                </div>
              </>
            )}
      </section>
      )}

      <footer style={S.footer}>
        Die Daten aus dem Inserat liefert die KI, die Beurteilung von Exterieur, Interieur und Reparaturen machst du selbst.
        Alles bleibt lokal in diesem Browser. Mit „Exportieren" im Verzeichnis sicherst du den Bestand
        als JSON-Datei — zum Wiederherstellen den Dateiinhalt einfach ins Import-Feld einfügen.
      </footer>
    </div>
  );
}

/* --------------------------- Karte ------------------------------- */

function VehicleCard({ v, accent, open, onToggle, addFor, addDate, addPrice, setAddDate, setAddPrice, openAdd, cancelAdd, addPoint, deletePoint, removeVehicle,
  closeFor, closeStatus, closeDate, setCloseStatus, setCloseDate, openClose, cancelClose, confirmClose, reopen, setzeFeld, heuteGesehen, setzeInseratsdatum }) {
  const S = styles;
  const h = v.priceHistory || [];
  const last = h[h.length - 1]?.price;
  const first = h[0]?.price;
  const diff = first != null && last != null ? last - first : 0;
  const dir = diff < 0 ? "down" : diff > 0 ? "up" : "flat";
  const dirColor = dir === "down" ? T.good : dir === "up" ? T.bad : T.muted;
  const isDealer = /h(ä|ae)ndl|dealer|autohaus|gewerb/i.test(`${v.sellerType} ${v.dealerName}`);
  const geschlossen = v.listingStatus && v.listingStatus !== "Aktiv";

  const chips = [erstzulassung(v), v.mileage != null ? `${fmtNum(v.mileage)} km` : null,
    v.fuel, v.gearbox, v.owners ? `${v.owners} Fahrzeughalter` : null, v.color,
    inseriertSeit(v) ? `inseriert seit ${fmtDate(inseriertSeit(v))}` : null].filter(Boolean);
  const idChips = [v.model, v.series, v.trimline].filter(Boolean);

  return (
    <div style={{ ...S.listRow, borderLeftColor: accent, opacity: geschlossen ? 0.72 : 1 }}>
      <div className="pw-dirrow" style={S.listHead}>
        <button style={S.listToggle} onClick={() => onToggle(v.id)} aria-expanded={open}
          title={open ? "Zuklappen" : "Alle Angaben anzeigen"}>
          <span style={{ ...S.chev, transform: open ? "rotate(90deg)" : "none" }}><ChevronRight size={14} /></span>
          <span style={{ minWidth: 0 }}>
            <span style={S.listTitle} title={v.title}>{v.title}</span>
            <span style={S.listSub}>{[v.make, v.model].filter(Boolean).join(" ")}{geschlossen ? ` · ${v.listingStatus}` : ""}</span>
          </span>
        </button>
        <span className="pw-metrics">
          <Metric label="Preis" value={fmtEUR(last)} stark />
          <Metric label="Veränderung" value={diff === 0 ? "unverändert" : `${diff > 0 ? "+" : ""}${fmtEUR(diff)}`} color={dirColor} />
          <Metric label="Kilometer" value={v.mileage != null ? `${fmtNum(v.mileage)} km` : "—"} />
          <Metric label="Erstzul." value={erstzulassung(v) || "—"} />
          <Metric label="Ort" value={v.location || "—"} />
          <Metric label="Reparaturen" value={v.repairKind || "—"} color={tagColor("repairKind", v.repairKind)} />
        </span>
        <button style={S.iconBtn} title="Fahrzeug entfernen" onClick={() => removeVehicle(v.id)}><Trash2 size={14} /></button>
      </div>
      {!open ? null : (
      <div style={S.cardBody}>
        {v.subtitle && <div style={S.cardSub}>{v.subtitle}</div>}

        {(v.make || idChips.length) && (
          <div style={S.idRow}>
            {v.make && <span style={S.makeTag}>{v.make}</span>}
            {idChips.map((c, i) => <span key={i} style={S.idChip}>{c}</span>)}
          </div>
        )}

        {/* Analyse-Begriffe */}
        <div style={S.tagRow}>
          {v.trimline && <StatusTag field="trimline" value={v.trimline} raw={v.trimline} />}
          {v.ausstattung && <StatusTag field="ausstattung" value={v.ausstattung} raw={v.ausstattung} />}
          {v.exterieur && <StatusTag field="exterieur" value={`Außen: ${v.exterieur}`} raw={v.exterieur} icon={<Camera size={11} />} />}
          {v.interieur && <StatusTag field="interieur" value={`Innen: ${v.interieur}`} raw={v.interieur} />}
          {v.repairKind && <StatusTag field="repairKind" value={`Rep.: ${v.repairKind}`} raw={v.repairKind} icon={<Wrench size={11} />} />}
          {v.accidentRepaired === "Ja" && <StatusTag field="accidentRepaired" value="Unfallschaden repariert" raw="Ja" icon={<ShieldCheck size={11} />} />}
        </div>

        {chips.length > 0 && <div style={S.metaRow}>{chips.map((c, i) => <span key={i} style={S.chip}>{c}</span>)}</div>}

        {(v.location || v.hu) && (
          <div style={S.subMeta}>
            {v.location && <span><MapPin size={11} style={{ verticalAlign: -1 }} /> {v.location}</span>}
            {v.hu && <span>HU {v.hu}</span>}
          </div>
        )}

        <div style={S.seller}>
          {isDealer ? <Store size={13} color={T.muted} /> : <User size={13} color={T.muted} />}
          <span>{isDealer ? (v.dealerName || "Händler") : (v.sellerType || "Anbieter unbekannt")}</span>
          {isDealer && v.address && <span style={S.addr}>· {v.address}</span>}
        </div>

        <div style={S.damageBox}>
          <DamageLine label="Reparaturen laut Inserat" value={v.repairNote} good icon />
        </div>

        {v.note && <div style={S.note}>{v.note}</div>}

        <div style={S.priceRow}>
          <span style={S.price}>{fmtEUR(last)}</span>
          <span style={{ ...S.deltaPill, color: dirColor, borderColor: dirColor + "55" }}>
            {dir === "down" ? <TrendingDown size={12} /> : dir === "up" ? <TrendingUp size={12} /> : <Minus size={12} />}
            {diff === 0 ? "unverändert" : `${diff > 0 ? "+" : ""}${fmtEUR(diff)}`}
          </span>
        </div>

        <Beobachtung v={v} heuteGesehen={heuteGesehen} setzeInseratsdatum={setzeInseratsdatum} />

        <div style={S.histHead}>
          <span>Preisverlauf · {h.length}</span>
          {addFor === v.id ? (
            <div style={S.addRow}>
              <input type="date" value={addDate} onChange={(e) => setAddDate(e.target.value)} style={S.dateInput} />
              <input inputMode="decimal" placeholder="Preis €" value={addPrice} onChange={(e) => setAddPrice(e.target.value)} style={S.priceInput} />
              <button style={S.iconBtnAccent} title="Hinzufügen" onClick={() => addPoint(v)}><Check size={15} /></button>
              <button style={S.iconBtn} title="Abbrechen" onClick={cancelAdd}><X size={15} /></button>
            </div>
          ) : (<button style={S.addBtn} onClick={() => openAdd(v)}><Plus size={13} /> Preis-Update</button>)}
        </div>

        {h.length > 0 && (
          <div style={S.histList}>
            {h.slice().reverse().map((p) => (
              <div key={p.date} style={S.histItem}>
                <span style={S.histDate}>{fmtDate(p.date)}</span>
                <span style={S.histPrice}>{fmtEUR(p.price)}</span>
                <button style={S.histDel} title="Punkt löschen" onClick={() => deletePoint(v, p.date)}><X size={12} /></button>
              </div>
            ))}
          </div>
        )}

        <div style={S.lifeBox}>
          <div style={S.lifeRow}>
            <span style={S.lifeLabel}><Clock size={11} style={{ verticalAlign: -1 }} /> Laufzeit</span>
            <span style={S.lifeValue}>
              {laufzeitText(laufzeitTage(v))}
              {inseriertSeit(v) && <span style={S.lifeSince}> seit {fmtDate(inseriertSeit(v))}</span>}
            </span>
          </div>
          {geschlossen ? (
            <div style={S.lifeRow}>
              <span style={{ ...S.lifeLabel, color: tagColor("listingStatus", v.listingStatus) }}>{v.listingStatus}</span>
              <span style={S.lifeValue}>
                {v.closedDate ? fmtDate(v.closedDate) : "—"}
                <button style={S.reopenBtn} onClick={() => reopen(v)} title="Inserat wieder als aktiv führen"><RotateCcw size={11} /> öffnen</button>
              </span>
            </div>
          ) : closeFor === v.id ? (
            <div style={S.closeForm}>
              <div style={S.closeOptions}>
                {STATUS_OPTS.filter((s) => s !== "Aktiv").map((s) => (
                  <button key={s} onClick={() => setCloseStatus(s)} style={closeStatus === s ? S.askOptionOn : S.askOption}>{s}</button>
                ))}
              </div>
              <div style={S.addRow}>
                <input type="date" value={closeDate} onChange={(e) => setCloseDate(e.target.value)} style={S.dateInput} />
                <button style={S.iconBtnAccent} title="Abschließen" onClick={() => confirmClose(v)}><Check size={15} /></button>
                <button style={S.iconBtn} title="Abbrechen" onClick={cancelClose}><X size={15} /></button>
              </div>
            </div>
          ) : (
            <button style={S.closeBtn} onClick={() => openClose(v)}
              title="Festhalten, wann das Inserat verschwunden oder das Fahrzeug verkauft war">
              <Archive size={12} /> Inserat abschließen
            </button>
          )}
        </div>

        <Linkfeld v={v} setzeFeld={setzeFeld} trenner />
      </div>
      )}
    </div>
  );
}

/* Was die App über die Beobachtung dieses Inserats weiß.
   Alles außer firstSeen, lastSeen, disappearedAt und trackingQuality wird
   aus dem Preisverlauf gerechnet — siehe tracking(). */
function Beobachtung({ v, heuteGesehen, setzeInseratsdatum }) {
  const S = styles;
  const [stufenOffen, setStufenOffen] = useState(false);
  const t = tracking(v);
  if (t.initialTrackedPrice == null) return null;

  const runter = t.absolut != null && t.absolut < 0;
  const deltaFarbe = t.absolut === 0 || t.absolut == null ? T.muted : runter ? T.good : T.bad;
  const alt = t.tageSeitGesehen;

  return (
    <div style={S.beoBox}>
      <div style={S.beoKopf}>
        <span style={S.beoTitel}><Gauge size={11} style={{ verticalAlign: -1 }} /> Beobachtung</span>
        <span style={{ ...S.beoGuete,
          color: t.qualitaet === "full" ? T.good : t.qualitaet === "unbekannt" ? T.accent : T.muted,
          borderColor: (t.qualitaet === "full" ? T.good : t.qualitaet === "unbekannt" ? T.accent : T.muted) + "55" }}
          title={t.qualitaet === "full"
            ? "Von Anfang an verfolgt — das Inserat war frisch, als es aufgenommen wurde."
            : t.qualitaet === "unbekannt"
              ? "Es ist kein Datum hinterlegt, seit wann das Inserat online ist. Ob der Anfang dabei war, lässt sich nicht sagen — und jede Zeitrechnung beginnt erst an deinem Fundtag."
              : `Das Inserat lief schon${t.blindTage ? ` ${t.blindTage} Tage` : ""}, als es aufgenommen wurde. Frühe Senkungen fehlen.`}>
          {t.qualitaet === "full" ? "vollständig verfolgt"
            : t.qualitaet === "unbekannt" ? "Anfang unbekannt" : "nachträglich aufgenommen"}
        </span>
      </div>

      <div style={S.beoGitter}>
        <BeoWert label="Erster Preis" wert={fmtEUR(t.initialTrackedPrice)} />
        <BeoWert label="Aktuell" wert={fmtEUR(t.currentPrice)} stark />
        <BeoWert label="Veränderung" farbe={deltaFarbe}
          wert={t.absolut === 0 ? "keine"
            : `${t.absolut > 0 ? "+" : "−"}${fmtEUR(Math.abs(t.absolut))}`}
          zusatz={t.absolut === 0 || t.prozent == null ? null
            : `${t.prozent > 0 ? "+" : "−"}${Math.abs(t.prozent).toFixed(1).replace(".", ",")} %`} />
        <BeoWert label="Preisänderungen" wert={`${t.aenderungen}`}
          zusatz={t.tageSeitAenderung == null ? null
            : t.aenderungen === 0 ? `unverändert seit ${laufzeitDativ(t.tageSeitAenderung)}`
              : `zuletzt vor ${laufzeitDativ(t.tageSeitAenderung)}`} />
        <BeoDatum label="Inseriert seit" wert={v.listedSince}
          gesetzt={!!v.listedSince}
          zusatz={v.listedSince
            ? (t.blindTage ? `${t.blindTage} Tage vor deinem Fund` : "du warst von Anfang an dabei")
            : "fehlt — Tag 0 ist dein Fundtag"}
          aendern={(d) => setzeInseratsdatum(v.id, d)} />
        <BeoWert label="Erstmals gesehen" wert={t.firstSeen ? fmtDate(t.firstSeen) : "—"} />
        <BeoWert label="Zuletzt gesehen" wert={t.lastSeen ? fmtDate(t.lastSeen) : "—"}
          farbe={alt != null && alt > 7 ? T.accent : undefined}
          zusatz={alt == null ? null : alt === 0 ? "heute" : `vor ${laufzeitDativ(alt)}`} />
        <BeoWert label="Standzeit" wert={t.daysTracked == null ? "—" : laufzeitText(t.daysTracked)}
          zusatz={t.daysOnline != null && t.daysOnline !== t.daysTracked
            ? `online ${laufzeitText(t.daysOnline)}` : "seit der ersten Erfassung"} />
        <BeoWert label="Status" wert={t.stand} farbe={t.offline ? T.muted : T.good}
          zusatz={t.offline && t.disappearedAt ? `seit ${fmtDate(t.disappearedAt)}` : "noch online"} />
        {t.lastAsk != null && (
          <BeoWert label="Letzter Ask" wert={fmtEUR(t.lastAsk)} zusatz="vor dem Verschwinden" />
        )}
      </div>

      {!t.offline && (
        <div style={S.beoZeile}>
          <button style={S.beoBtn} onClick={() => heuteGesehen(v.id)}
            title="Festhalten, dass das Inserat heute noch online war — auch ohne Preisänderung">
            <Check size={12} /> heute noch online
          </button>
          {alt != null && alt > 7 && (
            <span style={S.beoWarnung}>
              Seit {laufzeitDativ(alt)} nicht bestätigt — die Standzeit stützt sich so lange auf nichts.
            </span>
          )}
        </div>
      )}

      <button style={S.beoStufenBtn} onClick={() => setStufenOffen((o) => !o)}>
        <span style={{ ...S.chev, transform: stufenOffen ? "rotate(90deg)" : "none" }}><ChevronRight size={12} /></span>
        Preisstufen und ihre Dauer · {t.stufen.length}
      </button>
      {stufenOffen && (
        <div style={S.stufenListe}>
          {t.stufen.map((st, i) => (
            <div key={`${st.von}-${i}`} className="pw-stufe" style={S.stufenZeile}>
              <span style={S.stufenPreis}>{fmtEUR(st.preis)}</span>
              <span style={S.stufenDauer}>{laufzeitText(st.tage)}{st.laeuft ? " · läuft" : ""}</span>
              <span style={S.stufenZeitraum}>
                {fmtDate(st.von)} – {st.laeuft ? "heute" : fmtDate(st.bis)}
              </span>
              <span style={{ ...S.stufenDelta, color: st.aenderung == null ? T.muted : st.aenderung < 0 ? T.good : T.bad }}>
                {st.aenderung == null ? "Start"
                  : `${st.aenderung > 0 ? "+" : "−"}${fmtEUR(Math.abs(st.aenderung))}`}
              </span>
            </div>
          ))}
          <div style={S.askHilfe}>
            Gleiche Preise hintereinander zählen als eine Stufe. Die letzte läuft bis heute
            beziehungsweise bis zu dem Tag, an dem das Inserat verschwunden war.
          </div>
        </div>
      )}
    </div>
  );
}
function BeoWert({ label, wert, zusatz, farbe, stark }) {
  const S = styles;
  return (
    <div style={S.beoFeld}>
      <div style={S.beoLabel}>{label}</div>
      <div style={{ ...S.beoZahl, color: farbe || T.text, fontWeight: stark ? 800 : 700 }}>{wert}</div>
      {zusatz && <div style={S.beoZusatz}>{zusatz}</div>}
    </div>
  );
}

/* Alle Inserate ohne Inseratsdatum an einer Stelle, mit je einem Feld.
   Zwanzig Fahrzeuge einzeln im Verzeichnis aufzuklappen ist der falsche
   Weg für eine Angabe, die überall gleichzeitig fehlt. Die Liste steht
   dort, wo der Mangel auffällt: unter dem Bild, das ohne sie leer bleibt. */
function Nachtragliste({ liste, gesamt, offen, umschalten, setzen }) {
  const S = styles;
  return (
    <div style={S.nachtragBox}>
      <button style={S.nachtragKopf} onClick={umschalten} className="pw-nachtrag">
        <ChevronRight size={13} style={{ transform: offen ? "rotate(90deg)" : "none", transition: "transform .15s" }} />
        Inseratsdaten nachtragen · {liste.length} von {gesamt}
        <span style={S.nachtragKopfHilfe}>{offen ? "" : "aufklappen"}</span>
      </button>
      {offen && (
        <div style={S.nachtragListe}>
          {liste.map((x) => (
            <div key={x.id} style={S.nachtragZeile}>
              <span style={S.nachtragTitel} title={x.titel}>{x.titel}</span>
              <input type="date" className="pw-nachtrag-datum" max={todayISO()}
