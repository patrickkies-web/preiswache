    const i = SCOPE_OPTS.indexOf(v.repairScope);
    return i < 0 ? null : i;
  } },
};

const istLeer = (x) => x == null || x === "" || (typeof x === "number" && isNaN(x));

function sortiere(fahrzeuge, feld, richtung) {
  if (!feld || !SORT_FELDER[feld]) return fahrzeuge;
  const def = SORT_FELDER[feld];
  return fahrzeuge.slice().sort((a, b) => {
    const x = def.wert(a), y = def.wert(b);
    if (istLeer(x) && istLeer(y)) return 0;
    if (istLeer(x)) return 1;
    if (istLeer(y)) return -1;
    const c = def.typ === "zahl" ? x - y : String(x).localeCompare(String(y), "de");
    return richtung === "ab" ? -c : c;
  });
}

// Preissenkungen im Verlauf: Anzahl und Gesamtbetrag.
function senkungen(v) {
  const h = v.priceHistory || [];
  let anzahl = 0, summe = 0;
  for (let i = 1; i < h.length; i++) {
    const d = h[i - 1].price - h[i].price;
    if (d > 0) { anzahl++; summe += d; }
  }
  return { anzahl, summe };
}

/* --- Doppelte oder neu eingestellte Inserate erkennen ---
   Verglichen wird über Merkmale, die eine Neueinstellung überdauern:
