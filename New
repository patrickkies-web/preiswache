          Jedes Fahrzeug ein Punkt, der Reihe nach nebeneinander — so siehst du jeden Einzelpreis
          und erkennst Ausreißer sofort. Zeig auf einen Punkt, dann erscheint die Karteikarte;
          ein Klick öffnet das Inserat. Die Farbe zeigt den Reparatur-Umfang.
        </p>
        {!preisReihe ? (
          <div style={S.emptySmall}>Für die aktuelle Auswahl gibt es keine Preise.</div>
        ) : (
          <>
            <div style={{ width: "100%", height: 320 }}>
              <ResponsiveContainer>
                <ComposedChart data={preisReihe.rows} margin={{ top: 8, right: 14, left: 4, bottom: 4 }}>
                  <CartesianGrid stroke={T.line} strokeDasharray="2 4" />
                  <XAxis dataKey="nr" type="number" domain={[0, preisReihe.rows.length + 1]} allowDecimals={false}
                    stroke={T.muted} tick={{ fontSize: 10.5, fill: T.muted }} />
                  <YAxis dataKey="preis" domain={["dataMin - 500", "dataMax + 500"]}
                    tickFormatter={(w) => fmtNum(Math.round(w))}
                    stroke={T.muted} tick={{ fontSize: 10.5, fill: T.muted }} width={58} />
                  <Tooltip cursor={{ stroke: T.line }} content={({ active, payload }) => {
                    const p = active && payload?.find((x) => x.dataKey === "preis")?.payload;
                    return p ? <Karteikarte p={p} /> : null;
                  }} />
                  {preisReihe.mittelwert != null && (
                    <ReferenceLine y={preisReihe.mittelwert} stroke={T.muted} strokeDasharray="4 4"
                      label={{ value: `Median ${fmtEUR(preisReihe.mittelwert)}`, position: "insideTopLeft", fill: T.muted, fontSize: 10 }} />
                  )}
                  <Scatter dataKey="preis" isAnimationActive={false} cursor="pointer"
                    onClick={oeffneInserat}>
                    {preisReihe.rows.map((r) => <Cell key={r.id} fill={repFarbe(r.rep)} />)}
                  </Scatter>
                </ComposedChart>
              </ResponsiveContainer>
            </div>
            <div style={S.repLegende}>
              {SCOPE_OPTS.map((s) => (
                <span key={s} style={S.repLegendeEintrag}>
                  <span style={{ ...S.repPunkt, background: repFarbe(s) }} />{s}
                </span>
              ))}
            </div>
          </>
        )}
      </section>

      {/* Inserate über Zeit */}
      <section style={S.panel}>
        <div style={S.panelTitle}><CalendarClock size={15} /> Inserate über Zeit</div>
        <p style={S.hint}>
          Ein Punkt je Inserat: waagerecht das Datum, an dem du es erfasst hast, senkrecht der Preis,
          zu dem es damals stand. So siehst du über die Monate, ob die Angebote für deine Auswahl
          teurer oder günstiger werden.
        </p>
        {!inserateUeberZeit ? (
          <div style={S.emptySmall}>Für die aktuelle Auswahl gibt es keine Inserate mit Datum und Preis.</div>
        ) : (
          <>
            <div style={{ width: "100%", height: 300 }}>
              <ResponsiveContainer>
                <ComposedChart data={inserateUeberZeit.rows} margin={{ top: 8, right: 14, left: 4, bottom: 4 }}>
                  <CartesianGrid stroke={T.line} strokeDasharray="2 4" />
                  <XAxis dataKey="t" type="number" domain={["dataMin", "dataMax"]} scale="time"
                    tickFormatter={(t) => { const d = new Date(t); return `${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getFullYear()).slice(2)}`; }}
                    minTickGap={44} tickCount={6}
                    stroke={T.muted} tick={{ fontSize: 10.5, fill: T.muted }} />
                  <YAxis dataKey="preis" domain={["dataMin - 500", "dataMax + 500"]}
                    tickFormatter={(w) => fmtNum(Math.round(w))}
                    stroke={T.muted} tick={{ fontSize: 10.5, fill: T.muted }} width={58} />
                  {/* Eigener Tooltip: die Standardausgabe zeigte den Zeitstempel
                      der X-Achse als Geldbetrag mit an. */}
                  <Tooltip cursor={{ stroke: T.line }} content={({ active, payload }) => {
                    if (!active || !payload?.length) return null;
                    const punkt = payload.find((x) => x.dataKey === "preis")?.payload;
                    if (!punkt) return null;
                    const trend = payload.find((x) => x.dataKey === "trend")?.value;
                    return (
                      <div style={S.zeitTooltip}>
                        <div style={S.zeitTooltipDatum}>{fmtDate(punkt.datum)}</div>
                        <div style={S.zeitTooltipTitel}>{punkt.title}</div>
                        <div style={S.zeitTooltipPreis}>{fmtEUR(punkt.preis)}</div>
                        {trend != null && <div style={S.zeitTooltipTrend}>Trend an diesem Tag: {fmtEUR(trend)}</div>}
                      </div>
                    );
                  }} />
                  <Scatter dataKey="preis" fill={AUSWAHL_FARBE[aktiv]} isAnimationActive={false} />
                  {inserateUeberZeit.proMonat != null && (
                    <Line type="linear" dataKey="trend" stroke={T.text} strokeWidth={2} strokeDasharray="6 4"
                      dot={false} isAnimationActive={false} />
                  )}
                </ComposedChart>
              </ResponsiveContainer>
            </div>
            <div style={S.legendHint}>
              {inserateUeberZeit.anzahl} Inserate von {fmtDate(inserateUeberZeit.von)} bis {fmtDate(inserateUeberZeit.bis)}
              {inserateUeberZeit.proMonat != null && <> · gestrichelt die Trendgerade</>}
            </div>
            <div style={S.kennzahlen}>
              <Kennzahl label="Inserate" wert={`${inserateUeberZeit.anzahl}`} zusatz={`über ${laufzeitText(inserateUeberZeit.spanne)}`} />
              <Kennzahl label="Ø Angebotspreis" wert={fmtEUR(inserateUeberZeit.schnitt)} />
              <Kennzahl label="Trend je Monat"
                wert={inserateUeberZeit.proMonat == null ? "—" : `${inserateUeberZeit.proMonat > 0 ? "+" : ""}${fmtEUR(inserateUeberZeit.proMonat)}`}
                zusatz={inserateUeberZeit.proMonat == null ? "zu kurzer Zeitraum" : inserateUeberZeit.proMonat > 0 ? "Angebote werden teurer" : inserateUeberZeit.proMonat < 0 ? "Angebote werden günstiger" : "unverändert"}
                accent />
            </div>
            {inserateUeberZeit.proMonat != null && (
              <div style={S.schluss}>
                <b style={{ color: T.accent }}>Was das für dich heißt:</b>{" "}
                {inserateUeberZeit.proMonat < 0
                  ? <>Neue Angebote in dieser Auswahl kommen im Schnitt <b style={{ color: T.text }}>{fmtEUR(Math.abs(inserateUeberZeit.proMonat))} je Monat günstiger</b> auf den Markt. Warten kostet dich also nichts — im Gegenteil.</>
                  : inserateUeberZeit.proMonat > 0
                    ? <>Neue Angebote werden im Schnitt <b style={{ color: T.text }}>{fmtEUR(inserateUeberZeit.proMonat)} je Monat teurer</b>. Wer wartet, zahlt tendenziell mehr — ein Grund, bei einem guten Fund zügig zu handeln.</>
                    : <>Das Preisniveau der neuen Angebote bleibt über den beobachteten Zeitraum stabil.</>}
              </div>
            )}
            <div style={S.hinweisKlein}>
              Gezeigt wird der Preis beim ersten Erfassen, nicht der heutige. Der Trend beschreibt also,
              wie sich das <b style={{ color: T.text }}>Niveau neuer Angebote</b> entwickelt — nicht, wie
              einzelne Verkäufer ihre Preise senken. Dafür ist der Abschnitt darüber zuständig.
            </div>
          </>
        )}
      </section>

      </>)}

      {tab === "erfassen" && (<>

      {/* Laufzeiten */}
      {list.length > 0 && (
        <section style={S.panel}>
          <div style={S.panelTitle}><CalendarClock size={15} /> Laufzeiten der Inserate</div>
          <p style={S.hint}>
            Wie lange steht ein Auto schon drin, wann wurde der Preis gesenkt, und wann war es weg.
            Schließe ein Inserat unten am Fahrzeug ab, sobald es aus den Suchergebnissen verschwunden ist.
          </p>
          <div style={S.laufTable}>
            <div style={{ ...S.laufRow, ...S.laufHead }}>
              <span style={S.laufTitle}>Fahrzeug</span>
              <span style={S.laufCell}>seit</span>
              <span style={S.laufCell}>Laufzeit</span>
              <span style={S.laufCell}>Senkungen</span>
              <span style={S.laufCell}>gesenkt um</span>
              <span style={S.laufCell}>Stand</span>
            </div>
            {laufzeiten.map((r) => (
              <div key={r.id} style={S.laufRow}>
                <span style={S.laufTitle} title={r.title}>{r.title}</span>
                <span style={S.laufCell}>{r.seit ? fmtDate(r.seit) : "—"}</span>
                <span style={S.laufCell}>{laufzeitText(r.tage)}</span>
                <span style={S.laufCell}>{r.anzahl > 0 ? `${r.anzahl}×` : "—"}</span>
                <span style={S.laufCell}>{r.summe > 0 ? fmtEUR(r.summe) : "—"}</span>
                <span style={{ ...S.laufCell, color: tagColor("listingStatus", r.status), fontWeight: 700 }}>
                  {r.status}{r.status !== "Aktiv" && r.closedDate ? ` ${fmtDate(r.closedDate)}` : ""}
                </span>
              </div>
            ))}
          </div>
          <div style={S.laufSummary}>
            {laufSchnitt.abgeschlossen > 0
              ? `${laufSchnitt.abgeschlossen} abgeschlossen · Ø Laufzeit ${laufzeitText(laufSchnitt.schnitt)}`
              : "Noch kein Inserat abgeschlossen — sobald du das erste abschließt, erscheint hier die durchschnittliche Laufzeit."}
          </div>
        </section>
      )}

      </>)}

      {tab === "pruefen" && (
      <section style={S.panel}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between", flexWrap: "wrap", gap: 10 }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <ShieldCheck size={15} /> Offene Punkte · {zuPruefen.length}
          </span>
          {zuPruefen.length > 0 && (
            <button style={S.exportBtn} onClick={alleBestaetigen}
              title="Setzt bei allen unbestätigten Fahrzeugen den Haken — ohne die Werte zu ändern">
              <Check size={13} /> Alle bestätigen
            </button>
          )}
        </div>
        <p style={S.hint}>
          Beim Unfallstatus und bei den aktuellen Mängeln gibt es kein „Unbekannt" mehr:
          Steht im Inserat nichts dazu, gilt das Fahrzeug als unfallfrei und ohne Mängel.
          Bei Fahrzeugen, die du <b style={{ color: T.text }}>vor dieser Änderung</b> erfasst hast,
          wurde das automatisch umgestellt — <b style={{ color: T.text }}>angenommen, nicht geprüft</b>.
          Hier siehst du diese Fahrzeuge und alles andere, wo noch eine Entscheidung offen ist.
          Du kannst die Werte direkt ändern und den Eintrag danach abhaken.
        </p>

        {!loaded ? (<div style={S.empty}><span>Lade Daten…</span></div>)
          : zuPruefen.length === 0 ? (
            <div style={S.empty}>
              <Check size={16} color={T.good} />
              <span>{list.length === 0 ? "Noch keine Fahrzeuge erfasst." : "Alles durchgesehen — hier ist gerade nichts offen."}</span>
            </div>
          ) : (
            <div style={S.pruefListe}>
              {zuPruefen.map(({ v, punkte }) => (
                <div key={v.id} data-fahrzeug={v.id} style={S.pruefBlock}>
                  <div style={S.pruefKopf}>
                    <span style={S.pruefTitel}>{v.title || v.id}</span>
                    <span style={S.pruefMeta}>
                      {[erstzulassung(v), v.mileage != null ? `${fmtNum(v.mileage)} km` : null,
                        v.location, lastPrice(v) != null ? fmtEUR(lastPrice(v)) : null]
                        .filter(Boolean).join(" · ")}
                    </span>
                  </div>
                  <div style={S.pruefPunkte}>
                    {punkte.map((t) => <span key={t} style={S.pruefPunkt}>{t}</span>)}
                  </div>

                  {PRUEF_FELDER.map(({ feld, label, opts }) => (
                    <div key={feld} style={S.askItem}>
                      <div style={S.askFrage}>{label}</div>
                      <div style={S.askOptions}>
                        {opts.map((o) => (
                          <button key={o} onClick={() => setzeFeld(v.id, feld, o)}
                            style={v[feld] === o ? S.askOptionOn : S.askOption}>{o}</button>
                        ))}
                      </div>
                    </div>
                  ))}

                  <div style={S.askItem}>
                    <div style={S.askFrage}>Link zum Inserat</div>
                    <input defaultValue={v.url || ""} placeholder="mobile.de/…" style={S.askInput}
                      inputMode="url" spellCheck={false}
                      onBlur={(e) => { const t = e.target.value.trim(); if (t !== (v.url || "")) setzeFeld(v.id, "url", normalizeUrl(t)); }} />
                    {!istLink(v.url) && <div style={S.askHilfe}>Ohne Link findest du das Inserat später nicht wieder.</div>}
                  </div>

                  <div style={S.row}>
                    <button style={S.primaryBtn} onClick={() => setzeFeld(v.id, "geprueft", todayISO())}>
                      <Check size={15} /> {v.geprueft ? "Erneut bestätigen" : "Geprüft"}
                    </button>
                    {v.url && (
                      <a href={normalizeUrl(v.url)} target="_blank" rel="noreferrer" style={S.ghostLink}>
                        Inserat öffnen ↗
                      </a>
                    )}
                    {v.geprueft && <span style={S.askHilfe}>bestätigt am {fmtDate(v.geprueft)}</span>}
                  </div>
                </div>
              ))}
            </div>
          )}
      </section>
      )}

      {tab === "verzeichnis" && (
      <section style={S.panel}>
        <div style={{ ...S.panelTitle, justifyContent: "space-between" }}>
          <span style={{ display: "flex", alignItems: "center", gap: 8 }}><Car size={15} /> Verzeichnis · {list.length}</span>
          {list.length > 0 && (
            <span style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
              <button style={S.exportBtn} onClick={() => setOpenRows(alleOffen ? {} : Object.fromEntries(list.map((v) => [v.id, true])))}>
                {alleOffen ? "Alle zuklappen" : "Alle aufklappen"}
              </button>
              <button style={S.exportBtn} onClick={exportGarage} title="Alle Fahrzeuge als JSON-Datei sichern — wiederherstellen über das Import-Feld">
                <Download size={13} /> Exportieren
              </button>
            </span>
          )}
        </div>
        {!loaded ? (<div style={S.empty}><span>Lade Daten…</span></div>)
          : list.length === 0 ? (<div style={S.empty}><span>Noch keine Fahrzeuge. Wechsle zu „Erfassen &amp; Analysieren" und füge dort deinen ersten JSON-Block ein.</span></div>)
            : (
              <>
                <div style={S.sortZeile}>
                  <span style={S.fieldLabel}>Sortieren nach</span>
                  <select value={sortFeld} onChange={(e) => sortiereNach(e.target.value)} style={S.selectInline}>
                    <option value="">zuletzt geändert</option>
                    {Object.entries(SORT_FELDER).map(([f, d]) => <option key={f} value={f}>{d.label}</option>)}
                  </select>
                  {sortFeld && (
                    <button style={S.richtungBtn} onClick={() => setSortRichtung((r) => (r === "auf" ? "ab" : "auf"))}
                      title={sortRichtung === "auf" ? "Aufsteigend — zum Umdrehen klicken" : "Absteigend — zum Umdrehen klicken"}>
                      {sortRichtung === "auf" ? <><ArrowUp size={12} /> aufsteigend</> : <><ArrowDown size={12} /> absteigend</>}
                    </button>
                  )}
                </div>
                <div className="pw-dirhead" style={S.listHeadLabels}>
                  {[["title", "Fahrzeug"], ["preis", "Preis"], ["delta", "Veränderung"], ["mileage", "Kilometer"],
                    ["ez", "Erstzul."], ["location", "Ort"], ["repairScope", "Reparatur"]].map(([f, label]) => (
                    <button key={f} onClick={() => sortiereNach(f)}
                      style={{ ...S.sortKopf, color: sortFeld === f ? T.accent : T.muted }}
                      title={`Nach ${SORT_FELDER[f].label} sortieren`}>
                      {label}
                      {sortFeld === f && (sortRichtung === "auf" ? <ArrowUp size={11} /> : <ArrowDown size={11} />)}
                    </button>
                  ))}
                  <span />
                  <span />
                </div>
                <div style={S.listWrap}>
                  {verzeichnis.map((v) => (
                    <VehicleCard key={v.id} v={v} accent={colorFor(v.id)}
                      open={!!openRows[v.id]} onToggle={toggleRow}
                      addFor={addFor} addDate={addDate} addPrice={addPrice} setAddDate={setAddDate} setAddPrice={setAddPrice}
                      openAdd={openAdd} cancelAdd={() => setAddFor(null)} addPoint={addPoint} deletePoint={deletePoint} removeVehicle={removeVehicle}
                      closeFor={closeFor} closeStatus={closeStatus} closeDate={closeDate} setCloseStatus={setCloseStatus} setCloseDate={setCloseDate}
                      openClose={openClose} cancelClose={() => setCloseFor(null)} confirmClose={confirmClose} reopen={reopen}
                      toggleStern={toggleStern} />
                  ))}
                </div>
              </>
            )}
      </section>
      )}

      <footer style={S.footer}>
        Die Daten aus dem Inserat liefert die KI, die Beurteilung der Fotos machst du selbst.
        Alles bleibt lokal in diesem Browser. Mit „Exportieren" im Verzeichnis sicherst du den Bestand
        als JSON-Datei — zum Wiederherstellen den Dateiinhalt einfach ins Import-Feld einfügen.
      </footer>
    </div>
  );
}

/* --------------------------- Karte ------------------------------- */

function VehicleCard({ v, accent, open, onToggle, addFor, addDate, addPrice, setAddDate, setAddPrice, openAdd, cancelAdd, addPoint, deletePoint, removeVehicle,
  closeFor, closeStatus, closeDate, setCloseStatus, setCloseDate, openClose, cancelClose, confirmClose, reopen, toggleStern }) {
  const S = styles;
  const h = v.priceHistory || [];
  const last = h[h.length - 1]?.price;
  const first = h[0]?.price;
  const diff = first != null && last != null ? last - first : 0;
  const dir = diff < 0 ? "down" : diff > 0 ? "up" : "flat";
  const dirColor = dir === "down" ? T.good : dir === "up" ? T.bad : T.muted;
  const isDealer = /h(ä|ae)ndl|dealer|autohaus|gewerb/i.test(`${v.sellerType} ${v.dealerName}`);
  const geschlossen = v.listingStatus && v.listingStatus !== "Aktiv";

  const chips = [erstzulassung(v), v.mileage != null ? `${fmtNum(v.mileage)} km` : null, v.power, v.displacement, v.fuel, v.gearbox, v.drivetrain, v.category, v.condition, v.owners ? `${v.owners} Vorbesitzer` : null, v.color].filter(Boolean);
  const idChips = [v.model, v.series, v.trimline].filter(Boolean);

  return (
    <div style={{ ...S.listRow, borderLeftColor: accent, opacity: geschlossen ? 0.72 : 1 }}>
      <div className="pw-dirrow" style={S.listHead}>
        <button style={S.listToggle} onClick={() => onToggle(v.id)} aria-expanded={open}
          title={open ? "Zuklappen" : "Alle Angaben anzeigen"}>
          <span style={{ ...S.chev, transform: open ? "rotate(90deg)" : "none" }}><ChevronRight size={14} /></span>
          <span style={{ minWidth: 0 }}>
            <span style={S.listTitle} title={v.title}>{v.title}</span>
            <span style={S.listSub}>{[v.make, v.model].filter(Boolean).join(" ")}{geschlossen ? ` · ${v.listingStatus}` : ""}</span>
          </span>
        </button>
        <span className="pw-metrics">
          <Metric label="Preis" value={fmtEUR(last)} stark />
          <Metric label="Veränderung" value={diff === 0 ? "unverändert" : `${diff > 0 ? "+" : ""}${fmtEUR(diff)}`} color={dirColor} />
          <Metric label="Kilometer" value={v.mileage != null ? `${fmtNum(v.mileage)} km` : "—"} />
          <Metric label="Erstzul." value={erstzulassung(v) || "—"} />
          <Metric label="Ort" value={v.location || "—"} />
          <Metric label="Reparatur" value={v.repairScope || "—"} color={tagColor("repairScope", v.repairScope)} />
        </span>
        <button style={v.showcase === "Vorzeigefahrzeug" ? S.sternIconAn : S.iconBtn}
          title={v.showcase === "Vorzeigefahrzeug" ? "Vorzeigefahrzeug — zum Aufheben klicken" : "Als Vorzeigefahrzeug markieren"}
          onClick={() => toggleStern(v.id)}>
          <Star size={14} fill={v.showcase === "Vorzeigefahrzeug" ? T.accent : "none"} />
        </button>
        <button style={S.iconBtn} title="Fahrzeug entfernen" onClick={() => removeVehicle(v.id)}><Trash2 size={14} /></button>
      </div>
      {!open ? null : (
      <div style={S.cardBody}>
        {v.subtitle && <div style={S.cardSub}>{v.subtitle}</div>}

        {(v.make || idChips.length) && (
          <div style={S.idRow}>
            {v.make && <span style={S.makeTag}>{v.make}</span>}
            {idChips.map((c, i) => <span key={i} style={S.idChip}>{c}</span>)}
          </div>
        )}

        {/* Analyse-Begriffe */}
        <div style={S.tagRow}>
          {v.showcase === "Vorzeigefahrzeug" && <StatusTag field="showcase" value="Vorzeigefahrzeug" icon={<Star size={11} />} />}
          {v.photoDamage && <StatusTag field="photoDamage" value={`Fotos: ${v.photoDamage}`} raw={v.photoDamage} icon={<Camera size={11} />} />}
          {v.listingPrep && <StatusTag field="listingPrep" value={v.listingPrep} raw={v.listingPrep} />}
          {v.accidentStatus && <StatusTag field="accidentStatus" value={v.accidentStatus} icon={<ShieldCheck size={11} />} />}
          {v.currentIssueStatus && <StatusTag field="currentIssueStatus" value={`Mängel: ${v.currentIssueStatus}`} raw={v.currentIssueStatus} />}
          {v.repairScope && <StatusTag field="repairScope" value={`Rep.: ${v.repairScope}${v.repairCount != null ? ` (${v.repairCount})` : ""}`} raw={v.repairScope} icon={<Wrench size={11} />} />}
          {v.previousDamageStatus && <StatusTag field="previousDamageStatus" value={`Vorschäden: ${v.previousDamageStatus}`} raw={v.previousDamageStatus} />}
        </div>

        {chips.length > 0 && <div style={S.metaRow}>{chips.map((c, i) => <span key={i} style={S.chip}>{c}</span>)}</div>}

        {(v.location || v.hu) && (
          <div style={S.subMeta}>
            {v.location && <span><MapPin size={11} style={{ verticalAlign: -1 }} /> {v.location}</span>}
            {v.hu && <span>HU {v.hu}</span>}
          </div>
        )}

        <div style={S.seller}>
          {isDealer ? <Store size={13} color={T.muted} /> : <User size={13} color={T.muted} />}
          <span>{isDealer ? (v.dealerName || "Händler") : (v.sellerType || "Anbieter unbekannt")}
            {v.stars && <span style={S.stars}> <Star size={11} fill={T.accent} color={T.accent} style={{ verticalAlign: -1 }} /> {v.stars}</span>}</span>
          {isDealer && v.address && <span style={S.addr}>· {v.address}</span>}
        </div>

        <div style={S.damageBox}>
          <DamageLine label="Aktuell" value={v.damageCurrent} bad />
          <DamageLine label="Früher" value={v.damagePrevious} />
          <DamageLine label="Repariert" value={v.damageRepaired} good icon />
        </div>

        {v.note && <div style={S.note}>{v.note}</div>}

        <div style={S.priceRow}>
          <span style={S.price}>{fmtEUR(last)}</span>
          <span style={{ ...S.deltaPill, color: dirColor, borderColor: dirColor + "55" }}>
            {dir === "down" ? <TrendingDown size={12} /> : dir === "up" ? <TrendingUp size={12} /> : <Minus size={12} />}
            {diff === 0 ? "unverändert" : `${diff > 0 ? "+" : ""}${fmtEUR(diff)}`}
          </span>
        </div>

        <div style={S.histHead}>
          <span>Preisverlauf · {h.length}</span>
          {addFor === v.id ? (
            <div style={S.addRow}>
              <input type="date" value={addDate} onChange={(e) => setAddDate(e.target.value)} style={S.dateInput} />
              <input inputMode="decimal" placeholder="Preis €" value={addPrice} onChange={(e) => setAddPrice(e.target.value)} style={S.priceInput} />
              <button style={S.iconBtnAccent} title="Hinzufügen" onClick={() => addPoint(v)}><Check size={15} /></button>
              <button style={S.iconBtn} title="Abbrechen" onClick={cancelAdd}><X size={15} /></button>
            </div>
          ) : (<button style={S.addBtn} onClick={() => openAdd(v)}><Plus size={13} /> Preis-Update</button>)}
        </div>

        {h.length > 0 && (
          <div style={S.histList}>
            {h.slice().reverse().map((p) => (
              <div key={p.date} style={S.histItem}>
                <span style={S.histDate}>{fmtDate(p.date)}</span>
                <span style={S.histPrice}>{fmtEUR(p.price)}</span>
                <button style={S.histDel} title="Punkt löschen" onClick={() => deletePoint(v, p.date)}><X size={12} /></button>
              </div>
            ))}
          </div>
        )}

        <div style={S.lifeBox}>
          <div style={S.lifeRow}>
            <span style={S.lifeLabel}><Clock size={11} style={{ verticalAlign: -1 }} /> Laufzeit</span>
            <span style={S.lifeValue}>
              {laufzeitText(laufzeitTage(v))}
              {inseriertSeit(v) && <span style={S.lifeSince}> seit {fmtDate(inseriertSeit(v))}</span>}
            </span>
          </div>
          {geschlossen ? (
            <div style={S.lifeRow}>
              <span style={{ ...S.lifeLabel, color: tagColor("listingStatus", v.listingStatus) }}>{v.listingStatus}</span>
              <span style={S.lifeValue}>
                {v.closedDate ? fmtDate(v.closedDate) : "—"}
                <button style={S.reopenBtn} onClick={() => reopen(v)} title="Inserat wieder als aktiv führen"><RotateCcw size={11} /> öffnen</button>
              </span>
            </div>
          ) : closeFor === v.id ? (
            <div style={S.closeForm}>
              <div style={S.closeOptions}>
                {STATUS_OPTS.filter((s) => s !== "Aktiv").map((s) => (
                  <button key={s} onClick={() => setCloseStatus(s)} style={closeStatus === s ? S.askOptionOn : S.askOption}>{s}</button>
                ))}
              </div>
              <div style={S.addRow}>
                <input type="date" value={closeDate} onChange={(e) => setCloseDate(e.target.value)} style={S.dateInput} />
                <button style={S.iconBtnAccent} title="Abschließen" onClick={() => confirmClose(v)}><Check size={15} /></button>
                <button style={S.iconBtn} title="Abbrechen" onClick={cancelClose}><X size={15} /></button>
              </div>
            </div>
          ) : (
            <button style={S.closeBtn} onClick={() => openClose(v)}
              title="Festhalten, wann das Inserat verschwunden oder das Fahrzeug verkauft war">
              <Archive size={12} /> Inserat abschließen
            </button>
          )}
        </div>

        {v.url && <a href={v.url} target="_blank" rel="noreferrer" style={S.link}>Inserat öffnen ↗</a>}
      </div>
      )}
    </div>
  );
}

// Eine Kennzahl in der Verzeichnis-Zeile.
function Metric({ label, value, color, stark }) {
  return (
    <span style={styles.metric}>
      <span className="pw-mlabel" style={styles.metricLabel}>{label}</span>
      <span style={{ ...(stark ? styles.metricStark : styles.metricValue), ...(color ? { color } : null) }}>{value}</span>
    </span>
  );
}

function StatusTag({ field, value, raw, icon }) {
  const col = tagColor(field, raw || value);
  return <span style={{ ...styles.statusTag, color: col, borderColor: col + "55" }}>{icon}{value}</span>;
}
function DamageLine({ label, value, bad, good, icon }) {
  const val = value && value.trim() ? value : "—";
  const has = value && value.trim() && !/keine hinweise|keine angabe|^—$/i.test(value.trim());
  const col = has ? (bad ? T.bad : good ? T.good : T.text) : T.muted;
  return (
    <div style={styles.damageLine}>
      <span style={styles.damageLabel}>{icon && <Wrench size={10} style={{ verticalAlign: -1 }} />} {label}</span>
      <span style={{ ...styles.damageVal, color: col }}>{val}</span>
    </div>
  );
}
function DublettenWarnung({ neu, treffer }) {
  const S = styles;
  const geschlossen = treffer.filter((t) => t.listingStatus && t.listingStatus !== "Aktiv");
  const aktiv = treffer.filter((t) => !t.listingStatus || t.listingStatus === "Aktiv");
  const wiedereinstellung = geschlossen.length > 0;
  return (
    <div style={{ ...S.dubletteBox, borderLeftColor: wiedereinstellung ? T.accent : T.bad }}>
      <div style={{ ...S.dubletteTitel, color: wiedereinstellung ? T.accent : T.bad }}>
        <AlertTriangle size={13} />
        {wiedereinstellung ? "Vermutlich dasselbe Auto, neu eingestellt" : "Das hast du vermutlich schon erfasst"}
      </div>
      <div style={S.dubletteText}>
        Marke, Modell, Farbe, Erstzulassung und Ort stimmen mit {treffer.length === 1 ? "einem bereits erfassten Inserat" : `${treffer.length} bereits erfassten Inseraten`} überein.
      </div>
      {treffer.map((t) => {
        const indizien = dublettenIndizien(neu, t);
        const seit = inseriertSeit(t);
        const zu = t.listingStatus && t.listingStatus !== "Aktiv";
        return (
          <div key={t.id} style={S.dubletteTreffer}>
            <div style={S.dubletteName}>{t.title || t.id}</div>
            <div style={S.dubletteMeta}>
              {seit && <>erfasst seit {fmtDate(seit)} · Laufzeit {laufzeitText(laufzeitTage(t))}</>}
              {zu && <> · <span style={{ color: tagColor("listingStatus", t.listingStatus) }}>{t.listingStatus}{t.closedDate ? ` am ${fmtDate(t.closedDate)}` : ""}</span></>}
              {lastPrice(t) != null && <> · zuletzt {fmtEUR(lastPrice(t))}</>}
            </div>
            {indizien.length > 0 && (
              <ul style={S.dubletteListe}>
                {indizien.map((i, n) => <li key={n}>{i}</li>)}
              </ul>
            )}
          </div>
        );
      })}
      <div style={S.dubletteText}>
        {wiedereinstellung
          ? "Wenn das zutrifft, läuft dieses Auto in Wahrheit schon deutlich länger als die neue Anzeige vermuten lässt — ein starkes Argument beim Verhandeln. Importiere es trotzdem, dann hast du beide Anzeigen dokumentiert."
          : aktiv.length > 0
            ? "Prüfe, ob es wirklich zwei verschiedene Autos sind. Falls nicht, brich ab und trage stattdessen beim vorhandenen Eintrag ein Preis-Update nach."
            : ""}
      </div>
    </div>
  );
}

// Steht im Inserat etwas über Schäden, wird es hier vor der Fotofrage
// wiederholt — damit man weiß, wonach man auf den Bildern suchen soll.
function FotoHinweis({ v }) {
  const S = styles;
  const { texte, flaggen, hat } = fotoHinweise(v);
  if (!hat) return null;
  return (
    <div style={S.fotoBox}>
      <div style={S.fotoTitel}><Camera size={13} /> Das Inserat spricht von Schäden — gezielt hinschauen</div>
      {flaggen.length > 0 && <div style={S.fotoFlaggen}>{flaggen.join(" · ")}</div>}
      {texte.map(([label, wert]) => (
        <div key={label} style={S.fotoZeile}>
          <span style={S.fotoLabel}>{label}</span>
          <span style={S.fotoText}>{wert}</span>
        </div>
      ))}
    </div>
  );
}

function ChoiceQuestion({ frage, options, hilfe, value, onChange }) {
  return (
    <div style={styles.askItem}>
      <div style={styles.askFrage}>{frage}</div>
      <div style={styles.askOptions}>
        {options.map((o) => (
          <button key={o} onClick={() => onChange(o)} title={hilfe?.[o] || ""}
            style={value === o ? styles.askOptionOn : styles.askOption}>{o}</button>
        ))}
      </div>
      {value && hilfe?.[value] && <div style={styles.askHilfe}>{hilfe[value]}</div>}
    </div>
  );
}
// Filter mit Mehrfachauswahl: nichts angeklickt heißt "alle", mehrere
// angeklickte Werte gelten nebeneinander. Die Zahl hinter jedem Wort sagt,
// wie viele Fahrzeuge damit übrig blieben.
function MehrfachFilter({ label, options, werte, zahlen, farbe, onToggle, onClear }) {
  const S = styles;
  return (
    <div style={S.mfFeld}>
      <div style={S.mfKopf}>
        <span style={S.fieldLabel}>{label}</span>
        {werte.length > 0
          ? <button style={S.mfClear} onClick={onClear} title="Auswahl aufheben"><X size={10} /> {werte.length} gewählt</button>
          : <span style={S.mfAlle}>alle</span>}
      </div>
      <div style={S.mfChips}>
        {options.map((o) => {
          const an = werte.includes(o);
          const n = zahlen?.[o] || 0;
          return (
            <button key={o} onClick={() => onToggle(o)}
              style={an ? { ...S.mfChipOn, background: farbe, borderColor: farbe }
                : n === 0 ? S.mfChipLeer : S.mfChip}>
              {o}<span style={an ? S.mfZahlOn : S.mfZahl}>{n}</span>
            </button>
          );
        })}
      </div>
    </div>
  );
}

// Farbe der Punkte nach Reparatur-Umfang — bewusst deutlicher als die
// zurückhaltenden Kennzeichnungen auf der Fahrzeugkarte.
function repFarbe(rep) {
  if (rep === "Keine") return T.good;
  if (rep === "Gering") return "#A3E635";
  if (rep === "Mittel") return T.accent;
  if (rep === "Umfangreich") return T.bad;
  return T.muted;
}

// Klick auf einen Punkt oder Balken öffnet das Inserat. Recharts reicht dem
// Klick nicht den Datensatz selbst, sondern die gezeichnete Form — der
// Datensatz hängt darin unter "payload".
function oeffneInserat(d) {
  const daten = d && (d.payload || d);
  if (daten && daten.url) window.open(daten.url, "_blank", "noreferrer");
}

// Die Karteikarte, die beim Zeigen auf einen Punkt erscheint.
function Karteikarte({ p }) {
  const S = styles;
  const zeilen = [
    ["Erstzulassung", p.ez],
    ["Kilometer", p.km != null ? `${fmtNum(p.km)} km` : ""],
    ["Ort", p.ort],
    ["Anbieter", p.anbieter],
    ["Fotos", p.fotos],
  ].filter(([, w]) => w);
  return (
    <div style={S.karte}>
      <div style={S.karteKopf}>
        <span style={S.karteNr}>#{p.nr}</span>
        {p.stern && <Star size={11} fill={T.accent} color={T.accent} />}
        <span style={{ ...S.karteRep, color: repFarbe(p.rep) }}>{p.rep || "Reparatur unbekannt"}</span>
      </div>
      <div style={S.karteTitel}>{p.title}</div>
      {p.marke && <div style={S.karteMarke}>{p.marke}</div>}
      <div style={S.kartePreis}>{fmtEUR(p.preis)}</div>
      <div style={S.karteListe}>
        {zeilen.map(([label, wert]) => (
          <div key={label} style={S.karteZeile}>
            <span style={S.karteLabel}>{label}</span>
            <span style={S.karteWert}>{wert}</span>
          </div>
        ))}
      </div>
      {p.stand && p.stand !== "Aktiv" && (
        <div style={{ ...S.karteHinweis, color: tagColor("listingStatus", p.stand) }}>{p.stand}</div>
      )}
      {p.url && <div style={S.karteHinweis}>Klicken öffnet das Inserat ↗</div>}
    </div>
  );
}

// Karte für die beiden Charts zum erwarteten Preis: was das Auto kostet,
// was es nach Kilometern und Alter kosten müsste — und der Abstand dazwischen.
function Erwartungskarte({ p }) {
  const S = styles;
  const guenstiger = p.abweichung < 0;
  const farbe = p.abweichung === 0 ? T.muted : guenstiger ? T.good : T.bad;
  const abstand = p.abweichung === 0
    ? "genau wie erwartet"
    : `${fmtEUR(Math.abs(p.abweichung))} ${guenstiger ? "darunter" : "darüber"}`;
  return (
    <div style={S.karte}>
      <div style={S.karteKopf}>
        <span style={S.karteNr}>#{p.nr}</span>
        <span style={{ ...S.karteRep, color: repFarbe(p.rep) }}>{p.rep || "Reparatur unbekannt"}</span>
      </div>
      <div style={S.karteTitel}>{p.title}</div>
      <div style={S.kartePreis}>{fmtEUR(p.preis)}</div>
      <div style={S.karteListe}>
        <div style={S.karteZeile}>
          <span style={S.karteLabel}>erwartet</span>
          <span style={S.karteWert}>{fmtEUR(p.erwartet)}</span>
        </div>
        <div style={S.karteZeile}>
          <span style={S.karteLabel}>Abstand</span>
          <span style={{ ...S.karteWert, color: farbe }}>{abstand}</span>
        </div>
        <div style={S.karteZeile}>
          <span style={S.karteLabel}>Kilometer</span>
          <span style={S.karteWert}>{p.km != null ? `${fmtNum(p.km)} km` : ""}</span>
        </div>
        <div style={S.karteZeile}>
          <span style={S.karteLabel}>Alter</span>
          <span style={S.karteWert}>{p.alter != null ? `${p.alter.toFixed(1).replace(".", ",")} Jahre` : ""}</span>
        </div>
      </div>
      <div style={{ ...S.karteHinweis, color: farbe }}>
        günstiger als {p.guenstigerAls} % der Fahrzeuge in dieser Auswahl
      </div>
      {p.url && <div style={S.karteHinweis}>Klicken öffnet das Inserat ↗</div>}
    </div>
  );
}

function Kennzahl({ label, wert, zusatz, accent }) {
  return (
