      return { state: "verbunden", savedAt: s.savedAt, msg: "" };
    });
  }, []);
  const konfliktEigenesNehmen = useCallback(() => {
    setSync((s) => { baseRef.current = s.savedAt; return s; });
    setTimeout(() => setVehicles((v) => { pushToServer(v); return v; }), 0);
  }, [pushToServer]);

  const schluesselSpeichern = useCallback((k) => {
    const sauber = k.trim();
    keyRef.current = sauber; writeKey(sauber); baseRef.current = null;
    if (!sauber) { setSync({ state: "lokal", savedAt: null, msg: "" }); return; }
    (async () => {
      setSync({ state: "laedt", savedAt: null, msg: "" });
      try {
        const { vehicles: fern, savedAt } = await serverRead(sauber);
        baseRef.current = savedAt;
        if (savedAt) {
          const gehoben = migrate(fern);
          setVehicles(gehoben); localWrite(gehoben);
          setSync({ state: "verbunden", savedAt, msg: "" });
        } else {
          setVehicles((v) => { pushToServer(v); return v; });
        }
      } catch (e) {
        setSync({ state: e.status === 401 ? "schluessel" : "fehler", savedAt: null, msg: e.message });
      }
    })();
  }, [pushToServer]);

  const list = useMemo(() => Object.values(vehicles).sort((a, b) => (b.updatedAt || "").localeCompare(a.updatedAt || "")), [vehicles]);

  /* ---- Import ---- */
  // Nimmt wahlweise übergebenen Text (aus einer Datei) oder den Feldinhalt.
  function handlePreview(text) {
    const quelle = typeof text === "string" ? text : raw;
    const res = parseImport(quelle);
    if (res.error) { setNotice({ type: "err", msg: res.error }); setPreview(null); return; }
    // Bei bekannten Fahrzeugen die früheren Antworten vorbelegen.
    const vorbelegt = {};
    res.vehicles.forEach((v) => {
      const alt = vehicles[v.id];
      // Aus einer Sicherung mitgelieferte Antworten zählen zuerst,
      // danach die des bereits erfassten Fahrzeugs.
      vorbelegt[v.id] = {
        photoDamage: v.photoDamage || alt?.photoDamage || "",
        listingPrep: v.listingPrep || alt?.listingPrep || "",
        showcase: v.showcase === "Vorzeigefahrzeug" || alt?.showcase === "Vorzeigefahrzeug"
          ? "Vorzeigefahrzeug" : "Normal",
        url: v.url || alt?.url || "",
      };
    });
    setAnswers(vorbelegt);
    setPreview(res.vehicles); setNotice(null);
  }
  async function handleFile(e) {
    const datei = e.target.files?.[0];
    e.target.value = "";           // damit dieselbe Datei erneut wählbar bleibt
    if (!datei) return;
    try {
      const text = await datei.text();
      if (!text.trim()) { setNotice({ type: "err", msg: `„${datei.name}" ist leer.` }); return; }
      setRaw(text);
      handlePreview(text);
    } catch (_) {
      setNotice({ type: "err", msg: `„${datei.name}" konnte nicht gelesen werden.` });
    }
  }

  const setAnswer = (id, feld, wert) =>
    setAnswers((prev) => ({ ...prev, [id]: { ...prev[id], [feld]: wert } }));
  const alleBeantwortet = !preview || preview.every((v) => {
    const a = answers[v.id] || {};
    return a.photoDamage && a.listingPrep && istLink(a.url);
  });

  function confirmImport() {
    const next = { ...vehicles }; let added = 0, updated = 0;
    preview.forEach((raw_) => {
      const antw = answers[raw_.id] || {};
      // Beim Import hast du jedes Fahrzeug einzeln vor dir gehabt, inklusive
      // der Hinweise auf Schäden — das zählt als Durchsicht.
      const incoming = { ...raw_, ...antw, url: normalizeUrl(antw.url || raw_.url), geprueft: todayISO() };
      const existing = next[incoming.id];
      if (existing) {
        const merged = { ...existing };
        TEXT_FIELDS.forEach((k) => { if (incoming[k]) merged[k] = incoming[k]; });
        if (incoming.mileage != null) merged.mileage = incoming.mileage;
        if (incoming.repairCount != null) merged.repairCount = incoming.repairCount;
        const byDate = {};
        existing.priceHistory.forEach((p) => { byDate[p.date] = p.price; });
        incoming.priceHistory.forEach((p) => { byDate[p.date] = p.price; });
        merged.priceHistory = Object.entries(byDate).map(([date, price]) => ({ date, price })).sort((a, b) => a.date.localeCompare(b.date));
        // Der früheste bekannte Tag bleibt der Beginn des Inserats.
        merged.listedSince = [existing.listedSince, incoming.listedSince, merged.priceHistory[0]?.date]
          .filter(Boolean).sort()[0] || "";
        // Ein Preis-Update der KI enthält keinen Abschluss und lässt ihn unangetastet;
        // eine Sicherung bringt ihn mit und stellt ihn wieder her.
        merged.listingStatus = incoming.listingStatus || existing.listingStatus || "Aktiv";
        merged.closedDate = incoming.closedDate || existing.closedDate || "";
        merged.updatedAt = new Date().toISOString();
        next[incoming.id] = merged; updated++;
      } else {
        next[incoming.id] = { ...incoming, listingStatus: incoming.listingStatus || "Aktiv",
          createdAt: new Date().toISOString(), updatedAt: new Date().toISOString() }; added++;
      }
    });
    persist(next); setPreview(null); setRaw("");
    setNotice({ type: "ok", msg: `${added} neu · ${updated} aktualisiert.` });
  }

  /* ---- Qualitätssicherung ---- */
  // Ändern und Abhaken sind zwei Schritte: erst alles richtigstellen, dann
  // bestätigen. Sonst verschwände der Eintrag nach der ersten Korrektur.
  const setzeFeld = useCallback((id, feld, wert) => {
    updateVehicle(id, (v) => ({ ...v, [feld]: wert, updatedAt: new Date().toISOString() }));
  }, [updateVehicle]);

  // Vorzeigefahrzeug direkt im Verzeichnis an- und abschalten.
  const toggleStern = useCallback((id) => {
    updateVehicle(id, (v) => ({
      ...v,
      showcase: v.showcase === "Vorzeigefahrzeug" ? "Normal" : "Vorzeigefahrzeug",
      updatedAt: new Date().toISOString(),
    }));
  }, [updateVehicle]);

  function alleBestaetigen() {
    const heute = todayISO();
    const next = { ...vehicles };
    Object.keys(next).forEach((id) => {
      if (!next[id].geprueft) next[id] = { ...next[id], geprueft: heute, updatedAt: new Date().toISOString() };
    });
    persist(next);
  }

  /* ---- Preis-Updates ---- */
  function openAdd(v) { setAddFor(v.id); const last = v.priceHistory[v.priceHistory.length - 1]; setAddPrice(last ? String(last.price) : ""); setAddDate(todayISO()); }
  function addPoint(v) {
    const price = coerceNum(addPrice);
    if (price == null || !addDate) { setNotice({ type: "err", msg: "Datum und Preis angeben." }); return; }
    updateVehicle(v.id, (veh) => { const hist = veh.priceHistory.filter((p) => p.date !== addDate); hist.push({ date: addDate, price }); hist.sort((a, b) => a.date.localeCompare(b.date)); return { ...veh, priceHistory: hist, updatedAt: new Date().toISOString() }; });
    setAddFor(null); setAddPrice("");
  }
  function deletePoint(v, date) { updateVehicle(v.id, (veh) => ({ ...veh, priceHistory: veh.priceHistory.filter((p) => p.date !== date), updatedAt: new Date().toISOString() })); }
  function removeVehicle(id) { const next = { ...vehicles }; delete next[id]; persist(next); }

  /* ---- Inserat abschließen / wieder öffnen ---- */
  function openClose(v) {
    setCloseFor(v.id);
    setCloseStatus(v.listingStatus && v.listingStatus !== "Aktiv" ? v.listingStatus : "Verkauft");
    setCloseDate(v.closedDate || todayISO());
  }
  function confirmClose(v) {
    if (!closeDate) { setNotice({ type: "err", msg: "Bitte ein Datum angeben." }); return; }
    updateVehicle(v.id, (veh) => ({ ...veh, listingStatus: closeStatus, closedDate: closeDate, updatedAt: new Date().toISOString() }));
    setCloseFor(null);
  }
  function reopen(v) {
    updateVehicle(v.id, (veh) => ({ ...veh, listingStatus: "Aktiv", closedDate: "", updatedAt: new Date().toISOString() }));
  }

  /* ---- Export (Backup als JSON-Datei) ---- */
  async function exportGarage() {
    const data = JSON.stringify(Object.values(vehicles), null, 2);
    const filename = `preiswache-export-${todayISO()}.json`;
    try {
      if (window.claude?.downloads?.save) {
        await window.claude.downloads.save({ filename, data });
      } else {
        const url = URL.createObjectURL(new Blob([data], { type: "application/json" }));
        const a = document.createElement("a");
        a.href = url; a.download = filename;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      setNotice({ type: "ok", msg: `Export gespeichert: ${filename}. Zum Wiederherstellen den Dateiinhalt oben ins Import-Feld einfügen.` });
    } catch (_) {
      setNotice({ type: "err", msg: "Export abgebrochen." });
    }
  }

  /* ---- Chart Preisverlauf ---- */
  const chart = useMemo(() => {
    const withHistory = list.filter((v) => v.priceHistory?.length);
    if (chartMode === "tage") {
      // Alle Inserate beginnen bei Tag 0 und liegen dadurch übereinander.
      const proAuto = withHistory.map((v) => {
        const start = inseriertSeit(v);
        return { v, punkte: v.priceHistory.map((p) => ({ tag: tageZwischen(start, p.date) ?? 0, price: p.price })) };
      });
      const tage = [...new Set(proAuto.flatMap((a) => a.punkte.map((p) => p.tag)))].sort((a, b) => a - b);
      const rows = tage.map((tag) => {
        const row = { tag };
        proAuto.forEach(({ v, punkte }) => { const pt = punkte.find((p) => p.tag === tag); row[v.id] = pt ? pt.price : null; });
        return row;
      });
      return { rows, series: withHistory, xKey: "tag" };
    }
    const dates = [...new Set(withHistory.flatMap((v) => v.priceHistory.map((p) => p.date)))].sort();
    const rows = dates.map((date) => { const row = { date }; withHistory.forEach((v) => { const pt = v.priceHistory.find((p) => p.date === date); row[v.id] = pt ? pt.price : null; }); return row; });
    return { rows, series: withHistory, xKey: "date" };
  }, [list, chartMode]);
  const totalDrop = useMemo(() => list.reduce((s, v) => { const h = v.priceHistory; if (!h || h.length < 2) return s; const d = h[0].price - h[h.length - 1].price; return s + (d > 0 ? d : 0); }, 0), [list]);
  const colorFor = (id) => { const i = chart.series.findIndex((s) => s.id === id); return COLORS[(i < 0 ? Object.keys(vehicles).indexOf(id) : i) % COLORS.length]; };

  /* ---- Analyse: Filter + Vergleich ---- */
  const searchable = (v) => [v.title, v.subtitle, v.make, v.model, v.series, v.trimline, v.category, v.year, erstzulassung(v), v.fuel, v.gearbox, v.drivetrain, v.condition, v.color, v.location, v.sellerType, v.dealerName, v.note, v.damageCurrent, v.damagePrevious, v.damageRepaired].join(" ").toLowerCase();

  const filtereMit = (a) => list.filter((v) => {
    if (a.q.trim() && !searchable(v).includes(a.q.trim().toLowerCase())) return false;
    // Je Feld sind mehrere Werte erlaubt; ausgewählte Werte gelten als "oder".
    // Nichts ausgewählt heißt: dieses Feld schränkt nicht ein.
    for (const [f, val] of Object.entries(a.filters)) {
      const werte = filterWerte(val);
      if (werte.length && !werte.includes(v[f] || "")) return false;
    }
    const pmax = coerceNum(a.priceMax); if (pmax != null) { const lp = lastPrice(v); if (lp == null || lp > pmax) return false; }
    const kmax = coerceNum(a.kmMax); if (kmax != null) { if (v.mileage == null || v.mileage > kmax) return false; }
    return true;
  });
  const trefferA = useMemo(() => filtereMit(auswahlen[0]), [list, auswahlen]);
  const trefferB = useMemo(() => filtereMit(auswahlen[1]), [list, auswahlen]);
  const filtered = aktiv === 0 ? trefferA : trefferB;

  const distinct = (field) => [...new Set(list.map((v) => v[field]).filter(Boolean))].sort();

  const groups = useMemo(() => {
    const m = {};
    filtered.forEach((v) => { const key = v[groupBy] || "—"; (m[key] = m[key] || []).push(v); });
    return Object.entries(m).map(([group, vs]) => {
      const prices = vs.map(lastPrice).filter((x) => x != null);
      const kms = vs.map((v) => v.mileage).filter((x) => x != null);
      const avg = prices.length ? Math.round(prices.reduce((a, b) => a + b, 0) / prices.length) : null;
      const avgKm = kms.length ? Math.round(kms.reduce((a, b) => a + b, 0) / kms.length) : null;
      return { group, count: vs.length, avg, avgKm };
    }).sort((a, b) => (b.avg || 0) - (a.avg || 0));
  }, [filtered, groupBy]);

  /* ---- Preisentwicklung ab Inserat (folgt den Filtern oben) ---- */
  const bauVerlauf = (fahrzeuge) => {
    const reihen = [];
    fahrzeuge.forEach((v) => {
      const h = (v.priceHistory || []).slice().sort((a, b) => a.date.localeCompare(b.date));
      if (!h.length) return;
      const start = inseriertSeit(v) || h[0].date;
      const startPreis = h[0].price;
      if (!startPreis) return;
      const punkte = h.map((p) => ({ tag: Math.max(0, tageZwischen(start, p.date) ?? 0), price: p.price }));
      // Bis wann ist das Inserat beobachtet? Danach endet die Linie.
      const geschlossen = v.listingStatus && v.listingStatus !== "Aktiv" && v.closedDate;
      const ende = Math.max(tageZwischen(start, geschlossen ? v.closedDate : todayISO()) ?? 0,
        punkte[punkte.length - 1].tag);
      reihen.push({ id: v.id, title: v.title || v.id, punkte, startPreis, ende });
    });
    if (!reihen.length) return null;

    const maxTag = Math.max(...reihen.map((r) => r.ende), 1);

    // Ein Preis gilt weiter, bis der Verkäufer ihn ändert. Liefert Euro;
    // die Umrechnung auf Prozent passiert erst bei der Darstellung.
    const wertBei = (r, tag) => {
      if (tag > r.ende) return null;
      let letzter = null;
      for (const p of r.punkte) { if (p.tag <= tag) letzter = p; else break; }
      return letzter ? letzter.price : null;
    };

    // Kennzahlen
    const bisSenkung = [], gesamtSenkung = [], abstaende = [];
    let mitSenkung = 0;
    reihen.forEach((r) => {
      const erste = r.punkte.find((p) => p.price < r.startPreis);
      if (erste) { bisSenkung.push(erste.tag); mitSenkung++; }
      const letzter = r.punkte[r.punkte.length - 1];
      if (letzter.price < r.startPreis) gesamtSenkung.push((1 - letzter.price / r.startPreis) * 100);
      const stufen = r.punkte.filter((p, i) => i > 0 && p.price < r.punkte[i - 1].price);
      for (let i = 1; i < stufen.length; i++) abstaende.push(stufen[i].tag - stufen[i - 1].tag);
    });

    // Fächer müssen sich lückenlos, aber überschneidungsfrei aneinanderreihen.
    const faecher = FAECHER.map((f, i) => {
      const von = i === 0 ? 0 : FAECHER[i - 1].bis + 1;
      return { label: f.label, anzahl: bisSenkung.filter((t) => t >= von && t <= f.bis).length };
    });

    return {
      reihen, maxTag, wertBei,
      anzahl: reihen.length,
      beobachtet: reihen.filter((r) => r.punkte.length > 1).length,
      mitSenkung,
      medianTage: median(bisSenkung),
      schnittTage: mittel(bisSenkung) == null ? null : Math.round(mittel(bisSenkung)),
      schnittSenkung: mittel(gesamtSenkung) == null ? null : Math.round(mittel(gesamtSenkung) * 10) / 10,
      schnittAbstand: mittel(abstaende) == null ? null : Math.round(mittel(abstaende)),
      faecher,
    };
  };

  const verlauf0 = useMemo(() => bauVerlauf(trefferA), [trefferA]);
  const verlauf1 = useMemo(() => bauVerlauf(trefferB), [trefferB]);
  const primaer = aktiv === 1 ? verlauf1 : verlauf0;
  const sekundaer = vergleich ? (aktiv === 1 ? verlauf0 : verlauf1) : null;
  const abInserat = primaer;

  // Gemeinsame Zeitachse, Durchschnitt und Streuungsband je Auswahl.
  // "P" ist die Auswahl dieses Reiters, "S" die eingeblendete zum Vergleich.
  const verlaufRows = useMemo(() => {
    const saetze = [["P", primaer], ["S", sekundaer]].filter(([, v]) => v);
    if (!saetze.length) return [];
    const vorhanden = Math.max(...saetze.map(([, v]) => v.maxTag), 1);
    const maxTag = zeitfenster ? Math.min(vorhanden, zeitfenster) : vorhanden;
    const schritt = maxTag > 240 ? 21 : maxTag > 120 ? 14 : maxTag > 45 ? 7 : maxTag > 20 ? 2 : 1;
    const tage = new Set([0, maxTag]);
    saetze.forEach(([, v]) => v.reihen.forEach((r) => r.punkte.forEach((p) => tage.add(p.tag))));
    // Jedes Inserat endet auf der Achse, damit seine Linie dort sichtbar ausläuft.
    saetze.forEach(([, v]) => v.reihen.forEach((r) => tage.add(r.ende)));
    for (let t = 0; t <= maxTag; t += schritt) tage.add(t);
    const achse = [...tage].filter((t) => t <= maxTag).sort((a, b) => a - b);

    // Euro oder auf den eigenen Startpreis bezogene Prozent
    const zeige = (r, preis) => (preis == null ? null
      : einheit === "prozent" ? (preis / r.startPreis) * 100 : preis);

    const roh = achse.map((tag) => {
      const row = { tag };
      saetze.forEach(([name, v]) => {
        const werte = v.reihen.map((r) => zeige(r, v.wertBei(r, tag))).filter((w) => w != null);
        if (!werte.length) return;
        const m = mittel(werte);
        // Streuung über die Inserate: wie weit liegen sie an diesem Tag auseinander
        const sd = werte.length > 1 ? Math.sqrt(mittel(werte.map((w) => (w - m) ** 2))) : 0;
        row["schnitt" + name] = m;
        row["sd" + name] = sd;
        row["n" + name] = werte.length;
      });
      // Einzellinien nur, solange nichts eingeblendet ist — sonst wird es unlesbar
      if (!sekundaer) primaer.reihen.forEach((r) => { row[r.id] = zeige(r, primaer.wertBei(r, tag)); });
      return row;
    });

    // Gleitender Durchschnitt über ein Zeitfenster in Tagen
    const geglaettet = !glaettung ? roh : roh.map((r) => {
      const out = { ...r };
      ["P", "S"].forEach((n) => {
        const fenster = roh.filter((x) => Math.abs(x.tag - r.tag) <= glaettung / 2 && x["schnitt" + n] != null);
        if (fenster.length) {
          out["schnitt" + n] = mittel(fenster.map((x) => x["schnitt" + n]));
          out["sd" + n] = mittel(fenster.map((x) => x["sd" + n]));
        }
      });
      return out;
    });

    // Euro auf ganze Beträge, Prozent auf eine Nachkommastelle
    const r1 = (x) => (x == null ? null : einheit === "euro" ? Math.round(x) : Math.round(x * 10) / 10);
    return geglaettet.map((r) => {
      const out = { ...r };
      ["P", "S"].forEach((n) => {
        const m = r["schnitt" + n], sd = r["sd" + n];
        out["schnitt" + n] = r1(m);
        out["band" + n] = m == null ? null : [r1(m - sd), r1(m + sd)];
      });
      Object.keys(out).forEach((k) => { if (!/^(tag|schnitt|band|sd|n)[PS]?$/.test(k)) out[k] = r1(out[k]); });
      return out;
    });
  }, [primaer, sekundaer, glaettung, einheit, zeitfenster]);

  /* ---- Erwarteter Preis: Regression über Kilometer und Alter ---- */
  const fairValue = useMemo(() => {
    const basis = filtered
      .map((v) => ({ v, id: v.id, title: v.title || v.id, preis: lastPrice(v), km: v.mileage, alter: alterJahre(v), url: v.url, rep: v.repairScope }))
      .filter((p) => p.preis != null && p.km != null && p.alter != null);
    if (basis.length < 5) return { zuWenig: true, anzahl: basis.length };

    const m = regression(basis);
    const mitAbweichung = basis.map((p) => {
      const erwartet = m.erwartet(p.km, p.alter);
      return { ...p, erwartet: Math.round(erwartet), abweichung: Math.round(p.preis - erwartet) };
    });

    // Rangfolge: je weiter unter Erwartung, desto günstiger
    const sortiert = mitAbweichung.slice().sort((a, b) => a.abweichung - b.abweichung);
    const mitRang = sortiert.map((p, i) => ({
      ...p, nr: i + 1,
      guenstigerAls: Math.round(((sortiert.length - 1 - i) / Math.max(1, sortiert.length - 1)) * 100),
    }));
    const nachId = Object.fromEntries(mitRang.map((p) => [p.id, p]));

    // Linie fürs Streudiagramm: Modell bei durchschnittlichem Alter ausgewertet
    const kmWerte = basis.map((p) => p.km);
    const kmMin = Math.min(...kmWerte), kmMax = Math.max(...kmWerte);
    const linie = [kmMin, kmMax].map((km) => ({ km, erwartet: Math.round(m.erwartet(km, m.mx2)) }));
    const streu = basis.map((p) => ({ ...p, ...nachId[p.id] }));

    return {
      zuWenig: false, anzahl: basis.length, r2: m.r2, kopplung: m.kopplung,
      jeZehntausendKm: Math.round(m.b1 * 10000),
      jeJahr: Math.round(m.b2),
      streu, linie, balken: mitRang,
      bestes: mitRang[0], teuerstes: mitRang[mitRang.length - 1],
    };
  }, [filtered]);

  /* ---- Preisleiter: ein Punkt je Fahrzeug, nebeneinander ---- */
  const preisReihe = useMemo(() => {
    const punkte = filtered
      .map((v) => ({
        id: v.id, title: v.title || v.id, preis: lastPrice(v),
        marke: [v.make, v.model].filter(Boolean).join(" "),
        ez: erstzulassung(v), km: v.mileage, ort: v.location,
        rep: v.repairScope, fotos: v.photoDamage, anbieter: v.dealerName || v.sellerType,
        stand: v.listingStatus || "Aktiv", url: v.url, stern: v.showcase === "Vorzeigefahrzeug",
      }))
      .filter((p) => p.preis != null);
    if (!punkte.length) return null;
    const sortiert = reiheSort === "preis"
      ? punkte.slice().sort((a, b) => a.preis - b.preis)
      : punkte;
    const rows = sortiert.map((p, i) => ({ ...p, nr: i + 1 }));
    return { rows, mittelwert: median(rows.map((r) => r.preis)) };
  }, [filtered, reiheSort]);

  /* ---- Inserate über Zeit: ein Punkt je Inserat am Tag der Erfassung ---- */
  const inserateUeberZeit = useMemo(() => {
    const punkte = filtered.map((v) => {
      const datum = inseriertSeit(v);
      const preis = v.priceHistory?.[0]?.price;
      if (!datum || preis == null) return null;
      const d = parseISO(datum);
      return d ? { t: d.getTime(), datum, preis, id: v.id, title: v.title || v.id } : null;
    }).filter(Boolean).sort((a, b) => a.t - b.t);
    if (!punkte.length) return null;

    // Ausgleichsgerade nach kleinsten Quadraten über die Tage
    const tage = punkte.map((p) => p.t / TAG_MS);
    const mx = mittel(tage), my = mittel(punkte.map((p) => p.preis));
    let zaehler = 0, nenner = 0;
    tage.forEach((x, i) => { zaehler += (x - mx) * (punkte[i].preis - my); nenner += (x - mx) ** 2; });
    const steigung = nenner ? zaehler / nenner : 0;   // Euro je Tag

    const rows = punkte.map((p, i) => ({ ...p, trend: nenner ? Math.round(my + steigung * (tage[i] - mx)) : Math.round(my) }));
    const spanne = tage[tage.length - 1] - tage[0];
    return {
      rows, anzahl: punkte.length, spanne: Math.round(spanne),
      von: punkte[0].datum, bis: punkte[punkte.length - 1].datum,
      proMonat: nenner && spanne >= 7 ? Math.round(steigung * 30) : null,
      schnitt: Math.round(my),
    };
  }, [filtered]);

  /* ---- Doppelte / neu eingestellte Inserate ---- */
  // Beim Import: gegen den gesamten Bestand prüfen, ausdrücklich auch
  // gegen abgeschlossene Inserate — genau dort steckt die Neueinstellung.
  const previewDubletten = useMemo(() => {
    if (!preview) return {};
    const treffer = {};
    preview.forEach((v) => {
      if (!fingerabdruckVollstaendig(v)) return;
      const f = fingerabdruck(v);
      const gefunden = list.filter((x) => x.id !== v.id && fingerabdruckVollstaendig(x) && fingerabdruck(x) === f);
      if (gefunden.length) treffer[v.id] = gefunden;
    });
    return treffer;
  }, [preview, list]);

  // Im Bestand: bereits erfasste Fahrzeuge, die zueinander passen.
  const dublettenGruppen = useMemo(() => {
    const gruppen = {};
    list.forEach((v) => {
      if (!fingerabdruckVollstaendig(v)) return;
      const f = fingerabdruck(v);
      if (!gruppen[f]) gruppen[f] = [];
      gruppen[f].push(v);
    });
    return Object.values(gruppen).filter((g) => g.length > 1)
      .map((g) => g.slice().sort((a, b) => (inseriertSeit(a) || "").localeCompare(inseriertSeit(b) || "")));
  }, [list]);

  /* ---- Laufzeiten ---- */
  const laufzeiten = useMemo(() => list.map((v) => {
    const { anzahl, summe } = senkungen(v);
    return { id: v.id, title: v.title || v.id, seit: inseriertSeit(v), tage: laufzeitTage(v),
      anzahl, summe, status: v.listingStatus || "Aktiv", closedDate: v.closedDate || "" };
  }).sort((a, b) => (b.tage ?? -1) - (a.tage ?? -1)), [list]);

  const laufSchnitt = useMemo(() => {
    const fertig = laufzeiten.filter((r) => r.status !== "Aktiv" && r.tage != null);
    return { abgeschlossen: fertig.length,
      schnitt: fertig.length ? Math.round(fertig.reduce((s, r) => s + r.tage, 0) / fertig.length) : null };
  }, [laufzeiten]);

  const alleOffen = list.length > 0 && list.every((v) => openRows[v.id]);
  // Nur die Anzeige im Verzeichnis wird umsortiert, nicht die Daten der Auswertung.
  const verzeichnis = useMemo(() => sortiere(list, sortFeld, sortRichtung), [list, sortFeld, sortRichtung]);

  // Alles, wo noch eine Entscheidung von dir aussteht. Unbestätigte zuerst,
  // danach die mit den meisten offenen Punkten.
  const zuPruefen = useMemo(() => list
    .map((v) => ({ v, punkte: offenePunkte(v) }))
    .filter((e) => e.punkte.length > 0)
    .sort((a, b) => (!!a.v.geprueft - !!b.v.geprueft) || (b.punkte.length - a.punkte.length)), [list]);

  const activeFilterCount = Object.values(filters).filter((v) => filterWerte(v).length).length
    + (priceMax ? 1 : 0) + (kmMax ? 1 : 0) + (q.trim() ? 1 : 0);
  const resetFilters = () => setAuswahlen((prev) => prev.map((a, i) => (i === aktiv ? leereAuswahl() : a)));
  const gewaehlt = (f) => filterWerte(filters[f]);
  const toggleFilter = (f, o) => {
    const w = gewaehlt(f);
    aendere("filters", { ...filters, [f]: w.includes(o) ? w.filter((x) => x !== o) : [...w, o] });
  };
  const leereFilter = (f) => aendere("filters", { ...filters, [f]: [] });

  // Wie viele Fahrzeuge kämen je Wert dazu? Gezählt wird gegen alle anderen
  // Filter, dieses Feld selbst ausgenommen — sonst zeigt jede Zahl nur noch
  // die eigene Auswahl.
  const zaehleFuer = (feld) => {
    const menge = filtereMit({ ...A, filters: { ...filters, [feld]: [] } });
    const m = {};
    menge.forEach((v) => { const k = v[feld]; if (k) m[k] = (m[k] || 0) + 1; });
    return m;
