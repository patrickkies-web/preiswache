  }, [updateVehicle]);


  function alleBestaetigen() {
    const heute = todayISO();
    const next = { ...vehicles };
    Object.keys(next).forEach((id) => {
      if (!next[id].geprueft) next[id] = { ...next[id], geprueft: heute, updatedAt: new Date().toISOString() };
    });
    persist(next);
  }

  /* ---- Preis-Updates ---- */
  function openAdd(v) { setAddFor(v.id); const last = v.priceHistory[v.priceHistory.length - 1]; setAddPrice(last ? String(last.price) : ""); setAddDate(todayISO()); }
  function addPoint(v) {
    const price = coerceNum(addPrice);
    if (price == null || !addDate) { setNotice({ type: "err", msg: "Datum und Preis angeben." }); return; }
    updateVehicle(v.id, (veh) => {
      const hist = veh.priceHistory.filter((p) => p.date !== addDate);
      hist.push({ date: addDate, price });
      hist.sort((a, b) => a.date.localeCompare(b.date));
      // Einen Preis nachtragen heißt: an diesem Tag stand das Inserat noch.
      const gesehen = [veh.lastSeen, addDate].filter(Boolean).sort().pop();
      return { ...veh, priceHistory: hist, lastSeen: gesehen,
        firstSeen: veh.firstSeen || hist[0].date, updatedAt: new Date().toISOString() };
    });
    setAddFor(null); setAddPrice("");
  }
  /* Ein Blick ins Inserat ohne Preisänderung ist trotzdem eine Beobachtung.
     Ohne diesen Handgriff bliebe "zuletzt gesehen" auf dem letzten
     Preis-Update stehen, und die Standzeit stützte sich auf nichts. */
  const heuteGesehen = useCallback((id) => {
    updateVehicle(id, (veh) => ({ ...veh, lastSeen: todayISO(),
      firstSeen: veh.firstSeen || veh.priceHistory?.[0]?.date || todayISO(),
      updatedAt: new Date().toISOString() }));
  }, [updateVehicle]);

  function deletePoint(v, date) { updateVehicle(v.id, (veh) => ({ ...veh, priceHistory: veh.priceHistory.filter((p) => p.date !== date), updatedAt: new Date().toISOString() })); }
  function removeVehicle(id) { const next = { ...vehicles }; delete next[id]; persist(next); }

  /* ---- Inserat abschließen / wieder öffnen ---- */
  function openClose(v) {
    setCloseFor(v.id);
    setCloseStatus(v.listingStatus && v.listingStatus !== "Aktiv" ? v.listingStatus : "Verkauft");
    setCloseDate(v.closedDate || todayISO());
  }
  function confirmClose(v) {
    if (!closeDate) { setNotice({ type: "err", msg: "Bitte ein Datum angeben." }); return; }
    updateVehicle(v.id, (veh) => ({ ...veh, listingStatus: closeStatus, closedDate: closeDate,
      // Der Tag, an dem es zuerst nicht mehr online war. Ob verkauft oder
      // zurückgezogen, steht daneben im Status — hier steht nur "weg".
      disappearedAt: closeDate, updatedAt: new Date().toISOString() }));
    setCloseFor(null);
  }
  function reopen(v) {
    updateVehicle(v.id, (veh) => ({ ...veh, listingStatus: "Aktiv", closedDate: "", disappearedAt: "",
      lastSeen: todayISO(), updatedAt: new Date().toISOString() }));
  }

  /* ---- Export (Backup als JSON-Datei) ---- */
  async function exportGarage() {
    const data = JSON.stringify(Object.values(vehicles), null, 2);
    const filename = `preiswache-export-${todayISO()}.json`;
    try {
      if (window.claude?.downloads?.save) {
        await window.claude.downloads.save({ filename, data });
      } else {
        const url = URL.createObjectURL(new Blob([data], { type: "application/json" }));
        const a = document.createElement("a");
        a.href = url; a.download = filename;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      }
      setNotice({ type: "ok", msg: `Export gespeichert: ${filename}. Zum Wiederherstellen den Dateiinhalt oben ins Import-Feld einfügen.` });
    } catch (_) {
      setNotice({ type: "err", msg: "Export abgebrochen." });
    }
  }

  const totalDrop = useMemo(() => list.reduce((s, v) => { const h = v.priceHistory; if (!h || h.length < 2) return s; const d = h[0].price - h[h.length - 1].price; return s + (d > 0 ? d : 0); }, 0), [list]);
  // Farbstreifen je Fahrzeug im Verzeichnis — richtet sich nach der Stelle
  // im Bestand und bleibt damit für ein Fahrzeug gleich.
  const colorFor = (id) => COLORS[Math.max(0, Object.keys(vehicles).indexOf(id)) % COLORS.length];








  /* ---- Masterchart: Zustand gegen Preisvorteil ----
     Zwei Fragen in einem Bild. Erstens: wie gut ist das Auto gemessen an
     allem, was du erfasst hast? Zweitens: was müsste es bei diesem Zustand,
     dieser Laufleistung und diesem Alter kosten — und was kostet es? Interessant
     ist nur, wer bei der ersten Frage vorn liegt und bei der zweiten darunter. */


  /* ---- Sternniveau: die Vorzeigefahrzeuge als Messlatte ----
     Die Sterne hast du nach dem Erscheinungsbild vergeben, unabhängig vom
     Kilometerstand. Genau deshalb taugen sie als Anker: sie sagen, was ein
     Auto in Vorzeigezustand bei dieser Laufleistung kostet. Alles ohne Stern
     muss darunter liegen — sonst zahlst du Vorzeigepreis für weniger Auto. */




  /* ---- Preis gegen Standzeit ----
     Waagerecht der Preis, senkrecht wie lange das Inserat schon läuft.
     Unten links steht das, was günstig war und schnell weg; oben rechts,
     was zu teuer ist und deshalb steht. Der eigentliche Ertrag ist der
     Punkt dazwischen: ab welchem Preis die Standzeit kippt. */

  /* ---- Doppelte / neu eingestellte Inserate ---- */
  // Beim Import: gegen den gesamten Bestand prüfen, ausdrücklich auch
  // gegen abgeschlossene Inserate — genau dort steckt die Neueinstellung.
  const previewDubletten = useMemo(() => {
    if (!preview) return {};
    const treffer = {};
    preview.forEach((v) => {
      if (!fingerabdruckVollstaendig(v)) return;
      const f = fingerabdruck(v);
      const gefunden = list.filter((x) => x.id !== v.id && fingerabdruckVollstaendig(x) && fingerabdruck(x) === f);
      if (gefunden.length) treffer[v.id] = gefunden;
    });
    return treffer;
  }, [preview, list]);

  // Im Bestand: bereits erfasste Fahrzeuge, die zueinander passen.
  const dublettenGruppen = useMemo(() => {
    const gruppen = {};
    list.forEach((v) => {
      if (!fingerabdruckVollstaendig(v)) return;
      const f = fingerabdruck(v);
      if (!gruppen[f]) gruppen[f] = [];
      gruppen[f].push(v);
    });
    return Object.values(gruppen).filter((g) => g.length > 1)
      .map((g) => g.slice().sort((a, b) => (inseriertSeit(a) || "").localeCompare(inseriertSeit(b) || "")));
  }, [list]);

  /* ---- Laufzeiten ---- */
  const laufzeiten = useMemo(() => list.map((v) => {
    const { anzahl, summe } = senkungen(v);
    return { id: v.id, title: v.title || v.id, seit: inseriertSeit(v), tage: laufzeitTage(v),
      anzahl, summe, status: v.listingStatus || "Aktiv", closedDate: v.closedDate || "" };
  }).sort((a, b) => (b.tage ?? -1) - (a.tage ?? -1)), [list]);

  const laufSchnitt = useMemo(() => {
    const fertig = laufzeiten.filter((r) => r.status !== "Aktiv" && r.tage != null);
    return { abgeschlossen: fertig.length,
      schnitt: fertig.length ? Math.round(fertig.reduce((s, r) => s + r.tage, 0) / fertig.length) : null };
  }, [laufzeiten]);

  const alleOffen = list.length > 0 && list.every((v) => openRows[v.id]);
  // Nur die Anzeige im Verzeichnis wird umsortiert, nicht die Daten der Auswertung.
  const verzeichnis = useMemo(() => sortiere(list, sortFeld, sortRichtung), [list, sortFeld, sortRichtung]);

  /* ---- Übersicht: ein Punkt je Inserat, zum Einstiegspreis ----
     Gezeigt wird ausdrücklich der Preis bei der ERSTEN Erfassung — das ist
     der Preis, den man beim Fund im Netz gesehen hat. Spätere Senkungen
     stecken im Verlauf, nicht in diesem Bild. */
  const uebersicht = useMemo(() => {
    const punkte = list.map((v) => {
      const t = tracking(v);
      if (t.initialTrackedPrice == null) return null;
      const seit = t.firstSeen || v.priceHistory?.[0]?.date || "";
      return {
        id: v.id, title: v.title || v.id, preis: t.initialTrackedPrice,
        jetzt: t.currentPrice, offline: t.offline, stand: t.stand,
        firstSeen: seit, seitZeit: parseISO(seit)?.getTime() ?? null,
        tage: t.daysTracked, aenderungen: t.aenderungen, guete: t.qualitaet,
        km: v.mileage, ez: erstzulassung(v), ort: v.location,
        rep: v.repairKind, fotos: v.exterieur, linie: v.trimline,
        anbieter: v.dealerName || v.sellerType, url: v.url,
        marke: [v.make, v.model].filter(Boolean).join(" "),
      };
    }).filter(Boolean);
    if (!punkte.length) return null;

    const preise = punkte.map((p) => p.preis).slice().sort((a, b) => a - b);
    const q = (t) => preise[Math.min(preise.length - 1, Math.round(t * (preise.length - 1)))];
    const nachPreis = punkte.slice().sort((a, b) => a.preis - b.preis);
    // Ohne Erfassungsdatum lässt sich nach Zeit nicht ordnen — solche
    // Einträge hängen sich hinten an, statt zu verschwinden.
    const nachZeit = punkte.slice().sort((a, b) => (a.seitZeit ?? Infinity) - (b.seitZeit ?? Infinity));

    return {
      punkte, nachPreis, nachZeit, anzahl: punkte.length,
      min: preise[0], max: preise[preise.length - 1],
      median: q(0.5), q1: q(0.25), q3: q(0.75),
      offline: punkte.filter((p) => p.offline).length,
      ohneDatum: punkte.filter((p) => p.seitZeit == null).length,
      guenstigstes: nachPreis[0], teuerstes: nachPreis[nachPreis.length - 1],
    };
  }, [list]);

  /* ---- Preisverläufe: wann senken die Anbieter? ----
     Je Inserat eine Treppe. Waagerecht die Tage seit dem Start, senkrecht
     der geforderte Preis. Ein Preis gilt, bis der Verkäufer ihn ändert —
     deshalb Treppe und nicht Gerade.

     Die Linien sind verschieden lang, und genau das ist die Aussage: eine
     kurze Linie heißt, das Inserat war schnell wieder weg; eine lange
     heißt, es steht immer noch. */
  const preisverlaeufe = useMemo(() => {
    const mitte = (zahlen) => {
      if (!zahlen.length) return null;
      const s2 = [...zahlen].sort((a, b) => a - b);
      const m = Math.floor(s2.length / 2);
      return s2.length % 2 ? s2[m] : (s2[m - 1] + s2[m]) / 2;
    };
    const farben = ["#F5B301", "#4EA8F4", "#35C46B", "#C77DFF", "#F4544E",
      "#2DD4BF", "#FB923C", "#E879A9", "#A3E635", "#22D3EE"];

    const reihen = list.map((v, nr) => {
      const t = tracking(v);
      const stufen = t.stufen;
      if (!stufen.length || !stufen[0].preis) return null;
      const start = (verlaufNull === "inserat" ? inseriertSeit(v) : t.firstSeen) || t.firstSeen || stufen[0].von;
      if (!start) return null;
      const startPreis = stufen[0].preis;
      const ende = Math.max(1, tageZwischen(start, verschwundenAm(v) || todayISO()) ?? 1);

      /* Treppe: je Stufe ein waagerechtes Stück. Der erste Punkt sitzt
         immer auf Tag 0 — lief das Inserat schon, bevor du es gefunden
         hast, wird der erste bekannte Preis rückwärts fortgeschrieben.
         Dieses Stück wird gestrichelt gezeichnet, es ist eine Annahme. */
      const blindBis = Math.max(0, Math.min(ende, tageZwischen(start, stufen[0].von) ?? 0));
      const punkte = [];
      const knicke = [];
      stufen.forEach((st, i) => {
        const von = i === 0 ? 0 : Math.max(0, Math.min(ende, tageZwischen(start, st.von) ?? 0));
        const bis = i + 1 < stufen.length
          ? Math.max(von, Math.min(ende, tageZwischen(start, stufen[i + 1].von) ?? ende))
          : ende;
        punkte.push({ x: von, preis: st.preis });
        punkte.push({ x: bis, preis: st.preis });
        if (i > 0) knicke.push({ x: von, preis: st.preis });
      });

      // Nur echte Senkungen zählen; eine Erhöhung ist etwas anderes.
      const schritte = stufen.slice(1).map((st, i) => ({
        tag: Math.max(0, Math.min(ende, tageZwischen(start, st.von) ?? 0)),
        von: stufen[i].preis, nach: st.preis, delta: st.preis - stufen[i].preis,
      }));
      const senkungen = schritte.filter((x) => x.delta < 0);
      const letzterPreis = stufen[stufen.length - 1].preis;

      return {
        id: v.id, title: v.title || v.id, url: v.url,
        marke: [v.make, v.model].filter(Boolean).join(" "),
        km: v.mileage, ez: erstzulassung(v), guete: t.qualitaet,
        farbe: farben[nr % farben.length],
        startPreis, letzterPreis, ende, blindBis, punkte, knicke, schritte, senkungen,
        offline: t.offline, stand: t.stand,
        hatStart: !!v.listedSince, fund: t.firstSeen,
        ersteSenkung: senkungen.length ? senkungen[0].tag : null,
        ersteSenkungPct: senkungen.length ? (senkungen[0].delta / senkungen[0].von) * 100 : null,
        gesamtPct: ((letzterPreis - startPreis) / startPreis) * 100,
        blindTage: t.blindTage,
      };
    }).filter(Boolean);
    if (!reihen.length) return null;

    const mitSenkung = reihen.filter((r) => r.senkungen.length);
    const tageBis = mitSenkung.map((r) => r.ersteSenkung);

    /* Die Zone, in der die Spuren abreißen: die mittlere Hälfte der Preise,
       auf denen verschwundene Inserate zuletzt standen. Kein Rechenwerk,
       sondern ein Streifen im Bild — man soll sehen, auf welche Höhe die
       Linien zulaufen, bevor sie enden. Unter drei Abgängen wäre der
       Streifen die Meinung eines einzelnen Verkäufers, deshalb erst ab drei. */
    const ausstieg = reihen.filter((r) => r.offline).map((r) => r.letzterPreis).sort((a, b) => a - b);
    const perzentil = (p) => {
      if (!ausstieg.length) return null;
      const i = (ausstieg.length - 1) * p;
      const u = Math.floor(i), o = Math.ceil(i);
      return u === o ? ausstieg[u] : ausstieg[u] + (ausstieg[o] - ausstieg[u]) * (i - u);
    };
    const zone = ausstieg.length >= 3
      ? { von: perzentil(0.25), bis: perzentil(0.75), mitte: perzentil(0.5), n: ausstieg.length }
      : null;

    const abstaende = [];
    reihen.forEach((r) => {
      for (let i = 1; i < r.senkungen.length; i++) abstaende.push(r.senkungen[i].tag - r.senkungen[i - 1].tag);
    });

    return {
      reihen, anzahl: reihen.length,
      mitSenkung: mitSenkung.length,
      mehrfach: reihen.filter((r) => r.senkungen.length > 1).length,
      medianTage: mitte(tageBis),
      medianErste: mitte(mitSenkung.map((r) => Math.abs(r.ersteSenkungPct))),
      medianGesamt: mitte(mitSenkung.map((r) => Math.abs(r.gesamtPct))),
      medianAbstand: mitte(abstaende),
      geraten: reihen.filter((r) => r.blindBis > 0).length,
      laengste: Math.max(...reihen.map((r) => r.ende)),
      zone, abgaenge: ausstieg.length,
      /* Ohne Inseratsdatum nimmt die App den Erfassungstag als Tag 0. Wer
         alles heute erfasst hat, bekommt lauter Linien der Länge 1 — das
         ist keine Kaputtheit des Bildes, sondern eine fehlende Angabe, und
         der Abschnitt sagt das unten selbst. */
      ohneStart: reihen.filter((r) => !r.hatStart).length,
      ohneStartListe: reihen.filter((r) => !r.hatStart)
        .map((r) => ({ id: r.id, titel: r.title, fund: r.fund }))
        .sort((a, b) => a.titel.localeCompare(b.titel, "de")),
      kurz: reihen.filter((r) => r.ende <= 1).length,
    };
  }, [list, verlaufNull]);

  /* ---- Was der Kilometer kostet: vier Quartile, eine Formel ----
     Die Fahrzeuge werden nach Laufleistung sortiert und in vier gleich
     große Gruppen geteilt. Jede Gruppe gibt einen einzigen Punkt her:
     ihren mittleren Kilometerstand und ihren mittleren Preis. Durch diese
     vier Punkte wird eine Linie gelegt — einmal als Gerade (gleich viel
     Euro je 1.000 km), einmal als Kurve (gleich viel Prozent je 10.000 km).
     Bewusst nur vier Stützpunkte: so wiegt jedes Viertel des Feldes gleich
     schwer und ein einzelner Ausreißer kann die Formel nicht kippen. */
  const kmFormel = useMemo(() => {
    const mittel = (z) => z.reduce((a, b) => a + b, 0) / z.length;
    const perzentil = (sortiert, p) => {
      if (!sortiert.length) return null;
      const i = (sortiert.length - 1) * p, u = Math.floor(i), o = Math.ceil(i);
      return u === o ? sortiert[u] : sortiert[u] + (sortiert[o] - sortiert[u]) * (i - u);
    };

    const autos = list.map((v) => {
      const t = tracking(v);
      const km = Number(v.mileage) || 0;
      const preis = t.currentPrice || 0;
      if (km <= 0 || preis <= 0) return null;
      return {
        id: v.id, titel: v.title || v.id, url: v.url, ez: erstzulassung(v),
        marke: [v.make, v.model].filter(Boolean).join(" "),
        km, preis, offline: t.offline, stand: t.stand,
      };
    }).filter(Boolean).sort((a, b) => a.km - b.km);

    /* Unter acht Fahrzeugen hätte ein Viertel weniger als zwei — dann ist
       ein „Durchschnitt" nur ein einzelnes Auto mit anderem Namen. */
    if (autos.length < 8) return { zuWenig: true, anzahl: autos.length };

    const grenze = (i) => Math.floor((i * autos.length) / 4);
    const quartile = [0, 1, 2, 3].map((i) => {
      const teil = autos.slice(grenze(i), grenze(i + 1));
      return {
        nr: i + 1, n: teil.length, autos: teil,
        kmVon: teil[0].km, kmBis: teil[teil.length - 1].km,
        km: mittel(teil.map((a) => a.km)), preis: mittel(teil.map((a) => a.preis)),
      };
    });

    // Kleinste Quadrate durch die vier Stützpunkte.
    const xs = quartile.map((q) => q.km);
    const ys = quartile.map((q) => q.preis);
    const kq = (werte) => {
      const mx = mittel(xs), my = mittel(werte);
      let oben = 0, unten = 0;
      xs.forEach((x, i) => { oben += (x - mx) * (werte[i] - my); unten += (x - mx) ** 2; });
      const b = unten === 0 ? 0 : oben / unten;
      return { a: my - b * mx, b };
    };
    /* Bestimmtheitsmaß immer in Euro gerechnet, auch für die Kurve — sonst
       vergliche man Äpfel mit Logarithmen und die Kurve gewänne immer. */
    const guete = (f) => {
      const my = mittel(ys);
      let rest = 0, ganz = 0;
      ys.forEach((y, i) => { rest += (y - f(xs[i])) ** 2; ganz += (y - my) ** 2; });
      return ganz === 0 ? 1 : 1 - rest / ganz;
    };

    const g = kq(ys);
    const k = kq(ys.map((y) => Math.log(y)));
    const medianKm = perzentil(autos.map((a) => a.km), 0.5);

    const bauen = (art, a, b, f) => {
      /* Der Gürtel: die mittlere Hälfte der Abweichungen aller Fahrzeuge
         von der Linie. Nicht die Formel wird damit breiter, sondern das,
         was das Feld um sie herum tatsächlich tut. */
      const abweichung = autos.map((x) => x.preis - f(x.km)).sort((p, q) => p - q);
      const unten = perzentil(abweichung, 0.25), oben = perzentil(abweichung, 0.75);
      return {
        art, a, b, f, r2: guete(f), unten, oben, halbeBreite: (oben - unten) / 2,
        je10: f(medianKm) - f(medianKm + 10000),   // positiv = der Preis fällt
        faktor: art === "kurve" ? Math.exp(b * 10000) : null,
        innen: autos.filter((x) => {
          const d = x.preis - f(x.km);
          return d >= unten && d <= oben;
        }).length,
      };
    };

    const gerade = bauen("gerade", g.a, g.b, (x) => g.a + g.b * x);
    const kurve = bauen("kurve", Math.exp(k.a), k.b, (x) => Math.exp(k.a + k.b * x));

    return {
      autos, quartile, gerade, kurve, medianKm,
      besser: kurve.r2 > gerade.r2 ? "kurve" : "gerade",
      anzahl: autos.length, offline: autos.filter((a) => a.offline).length,
      kmMin: autos[0].km, kmMax: autos[autos.length - 1].km,
      ohneKm: list.length - autos.length,
    };
  }, [list]);

  /* ---- Orderbuch: Angebot und Abgang je Preisstufe ----

     Ein Inserat ist eine Order: "Ich will X € für dieses Auto." Was an der
     Börse als Brief-Seite im Buch liegt, sind hier die laufenden Inserate.
     Die Geld-Seite fehlt — Käufer sind unsichtbar. Aber sie hinterlassen
     eine Spur: ein Inserat, das verschwindet, wurde ausgeführt. Der Preis,
     zu dem es zuletzt stand, ist der Kurs, bei dem es weg war.

     Daraus wird je Preisstufe:
       offen  — was dort gerade liegt und auf einen Käufer wartet
       weg    — was von dieser Stufe schon abgeräumt wurde
       Abgang — weg / (weg + offen): wie viel der Markt dort schluckt
       Geduld — wie lange das Liegengebliebene dort schon liegt

     Zwei Dinge muss man dazu wissen, und beide stehen auch in der App:
     Verschwunden heißt nicht verkauft, und ein Inserat, das erst seit drei
     Tagen liegt, hatte noch keine Gelegenheit wegzugehen. */
  const orderbuch = useMemo(() => {
    const mitte = (zahlen) => {
      if (!zahlen.length) return null;
      const s2 = [...zahlen].sort((a, b) => a - b);
      const m = Math.floor(s2.length / 2);
      return s2.length % 2 ? s2[m] : Math.round((s2[m - 1] + s2[m]) / 2);
    };
    const eintraege = list.map((v) => {
      const t = tracking(v);
      // Was gerade im Buch liegt, ist der heutige Preis. Was weg ist, liegt
      // dort, wo es zuletzt stand — das ist der Kurs, zu dem es ging.
      const preis = t.offline ? t.lastAsk : t.currentPrice;
      if (preis == null) return null;
      return {
        id: v.id, title: v.title || v.id, preis, offline: t.offline, stand: t.stand,
        tage: t.daysTracked ?? 0, km: v.mileage, ez: erstzulassung(v), url: v.url,
        marke: [v.make, v.model].filter(Boolean).join(" "),
        einstieg: t.initialTrackedPrice, gesenkt: t.aenderungen > 0,
      };
    }).filter(Boolean);
    if (eintraege.length < 3) return { zuWenig: true, anzahl: eintraege.length };

    const preise = eintraege.map((e) => e.preis);
    const min = Math.min(...preise), max = Math.max(...preise);
    // Runde Stufenbreite, so dass ungefähr acht bis zwölf Stufen entstehen.
    const roh = Math.max(1, (max - min) / 9);
    const groesse = Math.pow(10, Math.floor(Math.log10(roh)));
    const breite = ([1, 2, 2.5, 5, 10].map((f) => f * groesse).find((x) => x >= roh) || groesse * 10);
    const unten = Math.floor(min / breite) * breite;
    const oben = Math.floor(max / breite) * breite;

    const stufen = [];
    for (let p = oben; p >= unten - 0.5; p -= breite) {
      const drin = eintraege.filter((e) => e.preis >= p && e.preis < p + breite);
      const offen = drin.filter((e) => !e.offline);
      const weg = drin.filter((e) => e.offline);
      stufen.push({
        von: Math.round(p), bis: Math.round(p + breite),
        alle: drin, offen, weg,
        anzahl: drin.length,
        abgang: drin.length ? weg.length / drin.length : null,
        geduld: mitte(offen.map((e) => e.tage)),
        tempo: mitte(weg.map((e) => e.tage)),
      });
    }

    const belegt = stufen.filter((s2) => s2.anzahl > 0);
    const offenGesamt = eintraege.filter((e) => !e.offline).length;
    const wegGesamt = eintraege.length - offenGesamt;

    /* Wo macht der Markt zu? Die höchste Stufe, auf der noch mindestens die
       Hälfte abgeräumt wurde. Unter zwei Beobachtungen ist das Zufall,
       deshalb zählen nur Stufen mit mindestens zwei Fahrzeugen. */
    const belastbar = belegt.filter((s2) => s2.anzahl >= 2);
    const klar = belastbar.filter((s2) => s2.abgang >= 0.5);
    const zaeh = belastbar.filter((s2) => s2.abgang <= 0.2);
    const clearing = klar.length ? klar[0] : null;                   // oberste, die noch geht
    const stau = zaeh.length ? zaeh[zaeh.length - 1] : null;         // unterste, die liegen bleibt

    // Tiefe: was liegt unter einem Preis noch alles offen herum?
    const tiefeBis = (preis) => {
      const drunter = eintraege.filter((e) => !e.offline && e.preis <= preis);
      return { anzahl: drunter.length, geduld: mitte(drunter.map((e) => e.tage)) };
    };
    const dickste = belegt.slice().sort((a, b) => b.anzahl - a.anzahl)[0];

    return {
      /* Auch leere Stufen bleiben stehen: eine Lücke im Buch ist eine
         Aussage — dort bietet gerade niemand etwas an. */
      zuWenig: false, stufen, breite, eintraege,
      anzahl: eintraege.length, offenGesamt, wegGesamt,
      maxAnzahl: Math.max(...belegt.map((s2) => s2.anzahl)),
      clearing, stau, dickste, tiefeBis,
      abgangGesamt: eintraege.length ? wegGesamt / eintraege.length : 0,
      medianGeduld: mitte(eintraege.filter((e) => !e.offline).map((e) => e.tage)),
      medianTempo: mitte(eintraege.filter((e) => e.offline).map((e) => e.tage)),
    };
  }, [list]);

  /* ---- Absorptionskarte: Preis mal Zeit ----
     Für jede Preisstufe eine eigene Überlebensrechnung. Die Karte zeigt je
     Stufe und Zeitfenster, welcher Anteil bis dahin absorbiert war — und
     wo im Preis die Absorption abreißt. */
  const ABSORPTION_FENSTER = [
    { tage: 7, kurz: "1 Woche" }, { tage: 14, kurz: "2 Wochen" },
    { tage: 30, kurz: "1 Monat" }, { tage: 60, kurz: "2 Monate" },
    { tage: 90, kurz: "3 Monate" }, { tage: 180, kurz: "6 Monate" },
  ];
  const absorption = useMemo(() => {
    const faelle = list.map((v) => {
      const t = tracking(v);
      // Der Preis, zu dem es zuletzt am Markt stand — bei Verschwundenen der
      // Kurs, bei dem es weg war.
      const preis = t.offline ? t.lastAsk : t.currentPrice;
      const austritt = t.daysOnline != null ? t.daysOnline : t.daysTracked;
      if (preis == null || austritt == null) return null;
      // Ab wann du hinsiehst. Bei einem nachträglich gefundenen Inserat sind
      // das die Tage, die es vor deinem Fund schon lief.
      const eintritt = Math.max(0, Math.min(t.blindTage || 0, Math.max(0, austritt - 1)));
      return {
        id: v.id, title: v.title || v.id, url: v.url, preis,
        eintritt, austritt, ereignis: t.offline, stand: t.stand,
        km: v.mileage, ez: erstzulassung(v), guete: t.qualitaet,
        marke: [v.make, v.model].filter(Boolean).join(" "),
      };
    }).filter(Boolean);
    if (faelle.length < 4) return { zuWenig: true, anzahl: faelle.length };

    const abgaenge = faelle.filter((f) => f.ereignis).length;
    const laengste = Math.max(...faelle.map((f) => f.austritt));
    const fenster = ABSORPTION_FENSTER.filter((f, i) =>
      f.tage <= laengste || (i > 0 && ABSORPTION_FENSTER[i - 1].tage <= laengste));

    // Preisstufen wie im Orderbuch, damit beide Bilder dieselbe Leiter haben.
    const preise = faelle.map((f) => f.preis);
    const min = Math.min(...preise), max = Math.max(...preise);
    const roh = Math.max(1, (max - min) / 5);
    const groesse = Math.pow(10, Math.floor(Math.log10(roh)));
    const breite = [1, 2, 2.5, 5, 10].map((x) => x * groesse).find((x) => x >= roh) || groesse * 10;
    const unten = Math.floor(min / breite) * breite;
    const oben = Math.floor(max / breite) * breite;

    const stufen = [];
    for (let p = oben; p >= unten - 0.5; p -= breite) {
      const drin = faelle.filter((f) => f.preis >= p && f.preis < p + breite);
      const kurve = ueberlebenskurve(drin);
      stufen.push({
        von: Math.round(p), bis: Math.round(p + breite), faelle: drin,
        anzahl: drin.length, abgaenge: drin.filter((f) => f.ereignis).length,
        kurve, halbwert: halbwertszeit(kurve),
        zellen: fenster.map((w) => ({
          ...w,
          anteil: drin.length ? abgangBis(kurve, w.tage) : null,
          risiko: risikoBei(drin, w.tage),
          // Ohne zwei Beobachtungen im Feld ist eine Quote geraten.
          belastbar: risikoBei(drin, Math.min(w.tage, 1)) >= 2 || drin.filter((f) => f.austritt >= w.tage || f.ereignis).length >= 2,
        })),
      });
    }
    const belegt = stufen.filter((st) => st.anzahl > 0);

    // Der faire Preis zur Zielzeit: die oberste Stufe, auf der bis dahin
    // mindestens die Hälfte absorbiert war.
    const zielZelle = (st) => st.zellen.find((z) => z.tage === zielTage) || st.zellen[st.zellen.length - 1];
    const brauchbar = belegt.filter((st) => zielZelle(st) && zielZelle(st).belastbar);
    const fair = brauchbar.find((st) => zielZelle(st).anteil >= 0.5) || null;
    const tot = brauchbar.length
      ? brauchbar.filter((st) => zielZelle(st).anteil <= 0.15).slice(-1)[0] || null
      : null;

    const gesamt = ueberlebenskurve(faelle);
    return {
      zuWenig: false, faelle, stufen: belegt, fenster, breite,
      anzahl: faelle.length, abgaenge, laengste,
      gesamtKurve: gesamt, gesamtHalbwert: halbwertszeit(gesamt),
      gesamtAnteil: abgangBis(gesamt, zielTage),
      fair, tot, zielZelle,
      duenn: belegt.filter((st) => !zielZelle(st) || !zielZelle(st).belastbar).length,
      nachgetragen: faelle.filter((f) => f.eintritt > 0).length,
    };
  }, [list, zielTage]);

  // Alles, wo noch eine Entscheidung von dir aussteht. Unbestätigte zuerst,
  // danach die mit den meisten offenen Punkten.
  const zuPruefen = useMemo(() => list
    .map((v) => ({ v, punkte: offenePunkte(v) }))
    .filter((e) => e.punkte.length > 0)
    .sort((a, b) => (!!a.v.geprueft - !!b.v.geprueft) || (b.punkte.length - a.punkte.length)), [list]);


  const S = styles;

  return (
    <div style={S.page}>
      <style>{globalCss}</style>

      <header style={S.header} className="pw-header">
        <div style={S.brandRow}>
          <div style={S.logo}><Gauge size={22} color={T.bg} strokeWidth={2.5} /></div>
          <div><div style={S.brandName}>PREISWACHE</div><div style={S.brandSub}>Erfassen · Beobachten · Vergleichen</div></div>
        </div>
        <div style={S.stats}>
          <Stat label="Fahrzeuge" value={fmtNum(list.length)} />
          <Stat label="Beob. Rückgänge" value={fmtEUR(totalDrop)} accent={T.good} />
          <button style={{ ...S.syncChip, color: SYNC_INFO[sync.state].farbe, borderColor: SYNC_INFO[sync.state].farbe + "55" }}
            onClick={() => setShowSync((s) => !s)} title="Synchronisierung einrichten">
            {sync.state === "verbunden" ? <Cloud size={13} /> : sync.state === "laedt" || sync.state === "speichert" ? <RefreshCw size={13} /> : <CloudOff size={13} />}
            {SYNC_INFO[sync.state].kurz}
